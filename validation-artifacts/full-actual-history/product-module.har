          "content": {
            "mimeType": "text/html",
            "size": 167289,
            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <script>\n      // Upstream path proxies (e.g. Tailscale serve at /forecast-dashboard) strip the\n      // prefix before the request reaches this file, so this document is served at \"/\"\n      // while the browser's URL keeps the prefix. Relative asset URLs and apiUrl() in\n      // app.js (which resolves against document.baseURI) only resolve when that URL\n      // ends in \"/\". Normalize before the parser reaches any stylesheet or script tag.\n      (function () {\n        var path = location.pathname;\n        var singleSegment = path.split(\"/\").filter(Boolean).length === 1;\n        if (\n          singleSegment &&\n          path.indexOf(\".\") === -1 &&\n          path.charAt(path.length - 1) !== \"/\"\n        ) {\n          location.replace(path + \"/\" + location.search + location.hash);\n        }\n      })();\n    </script>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Forecast performance · live analysis</title>\n    <meta\n      name=\"description\"\n      content=\"Source-aware forecast performance dashboard backed by the canonical analysis dataset.\"\n    />\n    <meta name=\"theme-color\" content=\"#ffffff\" />\n    <link rel=\"icon\" href=\"favicon.ico\" sizes=\"64x64\" />\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <div class=\"app\">\n      <header class=\"topbar\">\n        <div class=\"topbar__sig\">\n          <span class=\"lamp lamp--live\" aria-hidden=\"true\"></span>\n          <h1 class=\"topbar__title\">Forecast performance</h1>\n          <span class=\"topbar__ctx\"\n            >Accuracy · bias · revisions · coverage</span\n          >\n        </div>\n        <div class=\"topbar__right\">\n          <span class=\"refresh\" data-refresh>Loading canonical data…</span>\n          <span class=\"chip chip--live\">Live data</span>\n          <button\n            class=\"btn btn--accent\"\n            data-action=\"scope\"\n            type=\"button\"\n            aria-expanded=\"false\"\n            aria-controls=\"scope-drawer\"\n          >\n            Filters · 0\n          </button>\n          <button class=\"btn\" data-action=\"reset\" type=\"button\">Reset</button>\n        </div>\n      </header>\n\n      <div class=\"body\">\n        <nav class=\"rail\" id=\"dashboard-nav\" aria-label=\"Dashboard sections\">\n          <div class=\"rail__head\">\n            <p class=\"rail__label\">Navigate</p>\n            <button\n              class=\"rail__toggle\"\n              data-action=\"rail\"\n              type=\"button\"\n              aria-label=\"Collapse navigation\"\n              aria-controls=\"dashboard-nav\"\n              aria-expanded=\"true\"\n              title=\"Collapse navigation\"\n            >\n              <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\">\n                <path d=\"M10 3 5 8l5 5\" />\n              </svg>\n            </button>\n          </div>\n          <ul class=\"rail__list\" role=\"tablist\" aria-orientation=\"vertical\">\n            <li role=\"presentation\">\n              <button\n                class=\"tab is-active\"\n                id=\"tab-overview\"\n                role=\"tab\"\n                aria-label=\"Overview\"\n                aria-selected=\"true\"\n                aria-controls=\"pane-overview\"\n                tabindex=\"0\"\n                data-target=\"overview\"\n                type=\"button\"\n              >\n                <span class=\"lamp lamp--live\" aria-hidden=\"true\"></span>\n                <span class=\"tab__icon\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 20 20\">\n                    <rect x=\"3\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\" />\n                    <rect x=\"12\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\" />\n                    <rect x=\"3\" y=\"12\" width=\"5\" height=\"5\" rx=\"1\" />\n                    <rect x=\"12\" y=\"12\" width=\"5\" height=\"5\" rx=\"1\" />\n                  </svg>\n                </span>\n                <span class=\"tab__copy\">\n                  <span class=\"tab__name\">Overview</span>\n                  <span class=\"tab__meta\">KPIs · population</span>\n                </span>\n              </button>\n            </li>\n            <li role=\"presentation\">\n              <button\n                class=\"tab\"\n                id=\"tab-trends\"\n                role=\"tab\"\n                aria-label=\"Trends\"\n                aria-selected=\"false\"\n                aria-controls=\"pane-trends\"\n                tabindex=\"-1\"\n                data-target=\"trends\"\n                type=\"button\"\n              >\n                <span class=\"lamp\" aria-hidden=\"true\"></span>\n                <span class=\"tab__icon\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 20 20\">\n                    <path d=\"M3 15.5 7.2 11l3 2.5L17 5.5\" />\n                    <path d=\"M13.5 5.5H17V9\" />\n                  </svg>\n                </span>\n                <span class=\"tab__copy\">\n                  <span class=\"tab__name\">Trends</span>\n                  <span class=\"tab__meta\">month · horizon · brand</span>\n                </span>\n              </button>\n            </li>\n            <li role=\"presentation\">\n              <button\n                class=\"tab\"\n                id=\"tab-comparison\"\n                role=\"tab\"\n                aria-label=\"Comparison\"\n                aria-selected=\"false\"\n                aria-controls=\"pane-comparison\"\n                tabindex=\"-1\"\n                data-target=\"comparison\"\n                type=\"button\"\n              >\n                <span class=\"lamp\" aria-hidden=\"true\"></span>\n                <span class=\"tab__icon\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 20 20\">\n                    <path d=\"M3 6h12\" />\n                    <path d=\"m12 3 3 3-3 3\" />\n                    <path d=\"M17 14H5\" />\n                    <path d=\"m8 11-3 3 3 3\" />\n                  </svg>\n                </span>\n                <span class=\"tab__copy\">\n                  <span class=\"tab__name\">Comparison</span>\n                  <span class=\"tab__meta\">vintages · TM vs ML</span>\n                </span>\n              </button>\n            </li>\n            <li role=\"presentation\">\n              <button\n                class=\"tab\"\n                id=\"tab-history\"\n                role=\"tab\"\n                aria-label=\"Product history\"\n                aria-selected=\"false\"\n                aria-controls=\"pane-history\"\n                tabindex=\"-1\"\n                data-target=\"history\"\n                type=\"button\"\n              >\n                <span class=\"lamp\" aria-hidden=\"true\"></span>\n                <span class=\"tab__icon\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 20 20\">\n                    <path d=\"M5.2 5.2A7 7 0 1 1 3 10\" />\n                    <path d=\"M3 4v4h4\" />\n                    <path d=\"M10 6.5V10l2.6 1.7\" />\n                  </svg>\n                </span>\n                <span class=\"tab__copy\">\n                  <span class=\"tab__name\">Product history</span>\n                  <span class=\"tab__meta\">stability · exceptions</span>\n                </span>\n              </button>\n            </li>\n            <li role=\"presentation\">\n              <button\n                class=\"tab\"\n                id=\"tab-quality\"\n                role=\"tab\"\n                aria-label=\"Data quality\"\n                aria-selected=\"false\"\n                aria-controls=\"pane-quality\"\n                tabindex=\"-1\"\n                data-target=\"quality\"\n                type=\"button\"\n              >\n                <span class=\"lamp lamp--warn\" aria-hidden=\"true\"></span>\n                <span class=\"tab__icon tab__icon--warn\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 20 20\">\n                    <path\n                      d=\"M10 2.8 16 5v4.3c0 4-2.5 6.5-6 7.9-3.5-1.4-6-3.9-6-7.9V5l6-2.2Z\"\n                    />\n                    <path d=\"m7.2 10 1.8 1.8 3.8-4\" />\n                  </svg>\n                </span>\n                <span class=\"tab__copy\">\n                  <span class=\"tab__name\">Data quality</span>\n                  <span class=\"tab__meta\">statuses · downloads</span>\n                </span>\n                <span class=\"tab__badge\" data-quality-badge aria-hidden=\"true\"\n                  >–</span\n                >\n              </button>\n            </li>\n          </ul>\n          <div class=\"rail__foot\">\n            canonical analysis data<br />metric contract · v2\n          </div>\n        </nav>\n\n        <div class=\"workspace is-overview\">\n          <div class=\"scopebar\" aria-label=\"Active population ledger\">\n            <div class=\"scopebar__overview-title\">\n              <h2>Performance at a glance</h2>\n            </div>\n            <div class=\"scopebar__primary\" data-scope-primary></div>\n            <span class=\"scopebar__overview-stamp\" data-overview-stamp\n              >canonical data</span\n            >\n            <div class=\"scopebar__audit\" data-scope-audit></div>\n          </div>\n\n          <aside\n            class=\"scope-drawer\"\n            id=\"scope-drawer\"\n            aria-label=\"Dashboard filters\"\n            hidden\n          >\n            <header class=\"scope-drawer__head\">\n              <div>\n                <p class=\"eyebrow\">Shared population</p>\n                <h2>Filter workbench</h2>\n              </div>\n              <span\n                >Every tab, count and download recomputes from this scope</span\n              >\n            </header>\n            <div class=\"filter-groups\">\n              <fieldset class=\"filter-group\">\n                <legend>Primary scope</legend>\n                <label class=\"compact-field\"\n                  ><span>Mode</span\n                  ><select data-control=\"comparison_mode\">\n                    <option value=\"false\">Single source</option>\n                    <option value=\"true\">Compare TM vs ML</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Source</span\n                  ><select data-control=\"source\">\n                    <option value=\"tm\">TM</option>\n                    <option value=\"ml\" selected>ML</option>\n                  </select></label\n                >\n              </fieldset>\n\n              <fieldset\n                class=\"filter-group filter-group--product-period\"\n                data-product-group\n              >\n                <legend>Product &amp; period</legend>\n                <div class=\"compact-field compact-field--multiselect\">\n                  <span>Parent</span>\n                  <div\n                    data-product-filter=\"parent_codes\"\n                    data-all-label=\"All products\"\n                  ></div>\n                </div>\n                <div class=\"compact-field compact-field--multiselect\">\n                  <span>Brand</span>\n                  <div\n                    data-product-filter=\"brands\"\n                    data-all-label=\"All brands\"\n                  ></div>\n                </div>\n                <div class=\"compact-field compact-field--multiselect\">\n                  <span>SKU class</span>\n                  <div\n                    data-product-filter=\"sku_classes\"\n                    data-all-label=\"All classes\"\n                  ></div>\n                </div>\n                <label class=\"compact-field\"\n                  ><span>Horizon</span\n                  ><select data-control=\"horizon\"></select\n                ></label>\n                <label class=\"compact-field\"\n                  ><span>Minimum actual</span\n                  ><input\n                    data-control=\"minimum_actual_volume\"\n                    type=\"number\"\n                    min=\"0\"\n                    step=\"1\"\n                    value=\"0\"\n                /></label>\n                <section\n                  class=\"timeline-control\"\n                  data-timeline-control\n                  aria-label=\"Planning timeline in filter workbench\"\n                >\n                  <div class=\"timeline-control__head\">\n                    <span>Planning timeline</span>\n                    <output data-timeline-summary aria-live=\"polite\"\n                      >Loading periods…</output\n                    >\n                  </div>\n                  <div\n                    class=\"timeline-segment\"\n                    role=\"group\"\n                    aria-label=\"Group target periods by\"\n                  >\n                    <button\n                      type=\"button\"\n                      data-timeline-grain=\"month\"\n                      data-action=\"timeline-grain\"\n                      aria-pressed=\"true\"\n                    >\n                      Month\n                    </button>\n                    <button\n                      type=\"button\"\n                      data-timeline-grain=\"quarter\"\n                      data-action=\"timeline-grain\"\n                      aria-pressed=\"false\"\n                    >\n                      Quarter\n                    </button>\n                  </div>\n                  <div\n                    class=\"timeline-presets\"\n                    role=\"group\"\n                    aria-label=\"Planning horizon\"\n                  >\n                    <button\n                      type=\"button\"\n                      data-timeline-months=\"3\"\n                      data-action=\"timeline-preset\"\n                    >\n                      3M\n                    </button>\n                    <button\n                      type=\"button\"\n                      data-timeline-months=\"6\"\n                      data-action=\"timeline-preset\"\n                    >\n                      6M\n                    </button>\n                    <button\n                      type=\"button\"\n                      data-timeline-months=\"12\"\n                      data-action=\"timeline-preset\"\n                    >\n                      12M\n                    </button>\n                    <button\n                      type=\"button\"\n                      data-timeline-months=\"24\"\n                      data-action=\"timeline-preset\"\n                    >\n                      24M\n                    </button>\n                    <button\n                      type=\"button\"\n                      data-timeline-months=\"all\"\n                      data-action=\"timeline-preset\"\n                    >\n                      All\n                    </button>\n                  </div>\n                  <div\n                    class=\"timeline-slider\"\n                    data-timeline-range-control\n                    aria-label=\"Selected target month range\"\n                  >\n                    <span class=\"timeline-slider__label\">Selected range</span>\n                    <div class=\"timeline-slider__rail\" data-timeline-rail>\n                      <div\n                        class=\"timeline-slider__selection\"\n                        data-timeline-selection\n                        tabindex=\"0\"\n                        role=\"slider\"\n                        aria-label=\"Move selected timeline window\"\n                      ></div>\n                      <input\n                        data-timeline-start-slider\n                        type=\"range\"\n                        min=\"0\"\n                        max=\"0\"\n                        value=\"0\"\n                        step=\"1\"\n                        aria-label=\"Start month\"\n                      />\n                      <input\n                        data-timeline-end-slider\n                        type=\"range\"\n                        min=\"0\"\n                        max=\"0\"\n                        value=\"0\"\n                        step=\"1\"\n                        aria-label=\"End month\"\n                      />\n                    </div>\n                    <div\n                      class=\"timeline-axis\"\n                      data-timeline-axis\n                      aria-hidden=\"true\"\n                    ></div>\n                  </div>\n                  <div class=\"timeline-range\">\n                    <span data-timeline-start>—</span><i aria-hidden=\"true\"></i\n                    ><strong data-timeline-end>—</strong>\n                  </div>\n                  <div class=\"timeline-custom\">\n                    <label class=\"compact-field\"\n                      ><span>From</span\n                      ><select data-timeline-start-select></select\n                    ></label>\n                    <label class=\"compact-field\"\n                      ><span>To</span\n                      ><select data-timeline-end-select></select\n                    ></label>\n                  </div>\n                  <p class=\"timeline-hint\" data-timeline-hint>\n                    Drag either end, move the highlighted window, or use a\n                    preset.\n                  </p>\n                </section>\n              </fieldset>\n\n              <fieldset class=\"filter-group\" data-performance-group>\n                <legend>Performance</legend>\n                <label class=\"compact-field\"\n                  ><span>Revision direction</span\n                  ><select data-control=\"revision_direction\">\n                    <option value=\"\">All directions</option>\n                    <option value=\"up\">Up</option>\n                    <option value=\"down\">Down</option>\n                    <option value=\"unchanged\">Unchanged</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Revision outcome</span\n                  ><select data-control=\"revision_outcome\">\n                    <option value=\"\">All outcomes</option>\n                    <option value=\"improved\">Improved</option>\n                    <option value=\"worsened\">Worsened</option>\n                    <option value=\"neutral\">Neutral</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Tolerance KL</span\n                  ><input\n                    data-control=\"revision_tolerance_kl\"\n                    type=\"number\"\n                    min=\"0\"\n                    step=\"0.01\"\n                    value=\"0.01\"\n                /></label>\n                <label class=\"compact-field\"\n                  ><span>Direction</span\n                  ><select data-control=\"forecast_direction\">\n                    <option value=\"\">All directions</option>\n                    <option value=\"over\">Over forecast</option>\n                    <option value=\"under\">Under forecast</option>\n                    <option value=\"within_tolerance\">Within tolerance</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Accuracy band</span\n                  ><select data-control=\"accuracy_band\">\n                    <option value=\"\">All bands</option>\n                    <option value=\"below_0\">Below 0%</option>\n                    <option value=\"0_50\">0–50%</option>\n                    <option value=\"50_100\">50–100%</option>\n                    <option value=\"above_100\">Above 100%</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Bias band</span\n                  ><select data-control=\"bias_band\">\n                    <option value=\"\">All bands</option>\n                    <option value=\"below_0\">Below 0%</option>\n                    <option value=\"0_50\">0–50%</option>\n                    <option value=\"above_50\">Above 50%</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Minimum abs error</span\n                  ><input\n                    data-control=\"minimum_absolute_error_kl\"\n                    type=\"number\"\n                    min=\"0\"\n                    step=\"1\"\n                    value=\"0\"\n                /></label>\n                <label class=\"compact-field\"\n                  ><span>Top N</span\n                  ><select data-control=\"top_n\">\n                    <option value=\"\">All products</option>\n                    <option value=\"10\">Top 10</option>\n                    <option value=\"20\">Top 20</option>\n                    <option value=\"50\">Top 50</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Top N ranking</span\n                  ><select data-control=\"top_n_metric\">\n                    <option value=\"actual_volume\">Actual volume</option>\n                    <option value=\"absolute_error\">Absolute error</option>\n                    <option value=\"deterioration\">Deterioration</option>\n                  </select></label\n                >\n              </fieldset>\n\n              <fieldset class=\"filter-group\">\n                <legend>Quality</legend>\n                <label class=\"compact-field\"\n                  ><span>Hierarchy</span\n                  ><select data-control=\"hierarchy_status\">\n                    <option value=\"\">All statuses</option>\n                    <option value=\"mapped\">Mapped</option>\n                    <option value=\"unmapped\">Unmapped</option>\n                    <option value=\"conflict\">Conflict</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Actual status</span\n                  ><select data-control=\"actual_status\">\n                    <option value=\"\">All statuses</option>\n                    <option value=\"matched_positive\">Positive actual</option>\n                    <option value=\"matched_zero\">Zero actual</option>\n                    <option value=\"missing\">Missing actual</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Pair status</span\n                  ><select data-control=\"pair_status\">\n                    <option value=\"\">All statuses</option>\n                    <option value=\"complete\">Complete</option>\n                    <option value=\"missing_a\">Missing A</option>\n                    <option value=\"missing_b\">Missing B</option>\n                    <option value=\"missing_both\">Missing both</option>\n                    <option value=\"missing_actual\">Missing actual</option>\n                    <option value=\"zero_actual\">Zero actual</option>\n                  </select></label\n                >\n                <label class=\"compact-field\"\n                  ><span>Source availability</span\n                  ><select data-control=\"source_availability\">\n                    <option value=\"\">All statuses</option>\n                    <option value=\"tm_only\">TM only</option>\n                    <option value=\"ml_only\">ML only</option>\n                    <option value=\"both_sources\">Both sources</option>\n                  </select></label\n                >\n                <label class=\"check-field\"\n                  ><input type=\"checkbox\" data-control=\"zero_forecast_only\" />\n                  Zero forecasts only</label\n                >\n                <label class=\"check-field\"\n                  ><input\n                    type=\"checkbox\"\n                    data-control=\"complete_vintage_history_only\"\n                  />\n                  Complete vintage history only</label\n                >\n                <p class=\"filter-note\" data-filter-note aria-live=\"polite\">\n                  Changes apply automatically.\n                </p>\n              </fieldset>\n            </div>\n          </aside>\n\n          <div class=\"state-banner\" role=\"status\" aria-live=\"polite\" hidden>\n            <strong data-state-title></strong><span data-state-copy></span>\n          </div>\n\n          <main class=\"stage\" aria-live=\"polite\" aria-busy=\"true\">\n            <section\n              class=\"pane is-active\"\n              id=\"pane-overview\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-overview\"\n            >\n              <div\n                class=\"overview-health quick-filter-row\"\n                aria-label=\"Quick dashboard filters\"\n              >\n                <div\n                  class=\"quick-filter-field quick-filter-field--parent compact-field compact-field--multiselect\"\n                >\n                  <span>Parent</span>\n                  <div\n                    data-product-filter=\"parent_codes\"\n                    data-all-label=\"All products\"\n                  ></div>\n                </div>\n                <div\n                  class=\"quick-filter-field quick-filter-field--brand compact-field compact-field--multiselect\"\n                >\n                  <span>Brand</span>\n                  <div\n                    data-product-filter=\"brands\"\n                    data-all-label=\"All brands\"\n                  ></div>\n                </div>\n                <div class=\"quick-filter-field quick-filter-field--timeline\">\n                  <span>Time period</span>\n                  <section\n                    class=\"quick-timeline\"\n                    data-timeline-control\n                    aria-label=\"Target month range\"\n                  >\n                    <span class=\"quick-timeline__date\" data-timeline-start\n                      >—</span\n                    >\n                    <div class=\"timeline-slider__rail\" data-timeline-rail>\n                      <div\n                        class=\"timeline-slider__selection\"\n                        data-timeline-selection\n                        tabindex=\"0\"\n                        role=\"slider\"\n                        aria-label=\"Move selected timeline window\"\n                      ></div>\n                      <input\n                        data-timeline-start-slider\n                        type=\"range\"\n                        min=\"0\"\n                        max=\"0\"\n                        value=\"0\"\n                        step=\"1\"\n                        aria-label=\"Start month\"\n                      />\n                      <input\n                        data-timeline-end-slider\n                        type=\"range\"\n                        min=\"0\"\n                        max=\"0\"\n                        value=\"0\"\n                        step=\"1\"\n                        aria-label=\"End month\"\n                      />\n                    </div>\n                    <strong class=\"quick-timeline__date\" data-timeline-end\n                      >—</strong\n                    >\n                    <select data-control=\"target_start\" hidden></select>\n                    <select data-control=\"target_end\" hidden></select>\n                    <output data-timeline-summary hidden\n                      >Loading periods…</output\n                    >\n                    <div data-timeline-axis hidden></div>\n                    <p data-timeline-hint hidden></p>\n                  </section>\n                </div>\n                <div\n                  class=\"quick-filter-field quick-filter-field--sku compact-field compact-field--multiselect\"\n                >\n                  <span>SKU class</span>\n                  <div\n                    data-product-filter=\"sku_classes\"\n                    data-all-label=\"All classes\"\n                  ></div>\n                </div>\n                <button\n                  class=\"btn btn--accent quick-filter-row__action\"\n                  data-action=\"scope\"\n                  type=\"button\"\n                  aria-expanded=\"false\"\n                  aria-controls=\"scope-drawer\"\n                >\n                  Filters · 0\n                </button>\n                <button\n                  class=\"btn quick-filter-row__action\"\n                  data-action=\"reset\"\n                  type=\"button\"\n                >\n                  Reset\n                </button>\n                <details class=\"overview-details\">\n                  <summary>Data details</summary>\n                  <div\n                    class=\"overview-details__popover\"\n                    data-population-details\n                  ></div>\n                </details>\n              </div>\n              <div\n                class=\"kpis kpis--overview\"\n                data-kpis\n                aria-label=\"Primary performance indicators\"\n              ></div>\n              <div class=\"overview-charts\">\n                <section class=\"frame\" aria-labelledby=\"overview-chart-title\">\n                  <header class=\"frame__head\">\n                    <div>\n                      <div class=\"frame__title-row\">\n                        <h3 class=\"frame__title\" id=\"overview-chart-title\">\n                          Monthly vintage accuracy and bias\n                        </h3>\n                        <button\n                          class=\"chart-guide-trigger\"\n                          type=\"button\"\n                          data-action=\"overview-guide-open\"\n                          data-overview-guide=\"accuracy-chart\"\n                          aria-label=\"Explain monthly vintage accuracy and bias\"\n                          aria-haspopup=\"dialog\"\n                          aria-controls=\"overview-guide-dialog\"\n                        >\n                          ?\n                        </button>\n                      </div>\n                      <p class=\"frame__sub\" data-accuracy-chart-subtitle>\n                        Latest forecast fixed · oldest vintage selected\n                      </p>\n                    </div>\n                    <div class=\"frame__actions\">\n                      <button\n                        class=\"vintage-selector__trigger\"\n                        data-vintage-selector-trigger\n                        type=\"button\"\n                        aria-label=\"Choose forecast vintages to compare\"\n                        aria-haspopup=\"dialog\"\n                        aria-expanded=\"false\"\n                      >\n                        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                          <path d=\"M4 6h12M4 10h12M4 14h12\" />\n                        </svg>\n                        Vintages\n                        <strong data-vintage-selector-count>1</strong>\n                      </button>\n                      <button\n                        class=\"chart-expand\"\n                        data-action=\"chart-fullscreen\"\n                        data-chart-fullscreen=\"accuracy\"\n                        type=\"button\"\n                        aria-label=\"Open accuracy and bias chart full screen\"\n                        aria-haspopup=\"dialog\"\n                        aria-controls=\"overview-chart-dialog\"\n                      >\n                        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                          <path d=\"M7 3H3v4M13 3h4v4M17 13v4h-4M7 17H3v-4\" />\n                        </svg>\n                        Full screen\n                      </button>\n                    </div>\n                  </header>\n                  <div class=\"frame__body\" data-overview-chart></div>\n                </section>\n\n                <section class=\"frame\" aria-labelledby=\"volume-chart-title\">\n                  <header class=\"frame__head frame__head--volume\">\n                    <div>\n                      <div class=\"frame__title-row\">\n                        <h3 class=\"frame__title\" id=\"volume-chart-title\">\n                          Forecast versus actual volume\n                        </h3>\n                        <button\n                          class=\"chart-guide-trigger\"\n                          type=\"button\"\n                          data-action=\"overview-guide-open\"\n                          data-overview-guide=\"volume-chart\"\n                          aria-label=\"Explain forecast versus actual volume\"\n                          aria-haspopup=\"dialog\"\n                          aria-controls=\"overview-guide-dialog\"\n                        >\n                          ?\n                        </button>\n                      </div>\n                      <p class=\"frame__sub\" data-volume-chart-subtitle>\n                        Selected vintages, fixed latest and actual share one\n                        common cohort\n                      </p>\n                    </div>\n                    <div class=\"frame__actions\">\n                      <button\n                        class=\"chart-expand\"\n                        data-action=\"chart-fullscreen\"\n                        data-chart-fullscreen=\"volume\"\n                        type=\"button\"\n                        aria-label=\"Open forecast versus actual chart full screen\"\n                        aria-haspopup=\"dialog\"\n                        aria-controls=\"overview-chart-dialog\"\n                      >\n                        <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                          <path d=\"M7 3H3v4M13 3h4v4M17 13v4h-4M7 17H3v-4\" />\n                        </svg>\n                        Full screen\n                      </button>\n                    </div>\n                    <div class=\"legend\" data-volume-chart-legend></div>\n                  </header>\n                  <div class=\"frame__body\" data-overview-volume-chart></div>\n                </section>\n              </div>\n            </section>\n\n            <section\n              class=\"pane\"\n              id=\"pane-trends\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-trends\"\n            >\n              <div class=\"pane__head\">\n                <div>\n                  <p class=\"eyebrow\">Performance</p>\n                  <h2 class=\"pane__title\">How performance moves</h2>\n                </div>\n                <span class=\"stamp\">active real-data scope</span>\n              </div>\n              <div class=\"metricbar\" aria-label=\"Trend metric selectors\">\n                <label\n                  ><span>Monthly metric</span\n                  ><select data-metric-selector=\"monthly\">\n                    <option value=\"forecast_accuracy_pct\">\n                      Forecast accuracy\n                    </option>\n                    <option value=\"bias_pct\">Bias</option>\n                    <option value=\"absolute_error_kl\">Absolute error</option>\n                    <option value=\"forecast_kl\">Forecast vs actual</option>\n                  </select></label\n                >\n                <label\n                  ><span>Horizon metric</span\n                  ><select data-metric-selector=\"horizon\">\n                    <option value=\"forecast_accuracy_pct\">\n                      Forecast accuracy\n                    </option>\n                    <option value=\"bias_pct\">Bias</option>\n                    <option value=\"absolute_error_kl\">Absolute error</option>\n                  </select></label\n                >\n                <label\n                  ><span>Heatmap metric</span\n                  ><select data-metric-selector=\"heatmap\">\n                    <option value=\"forecast_accuracy_pct\">\n                      Forecast accuracy\n                    </option>\n                    <option value=\"bias_pct\">Bias</option>\n                    <option value=\"absolute_error_kl\">Absolute error</option>\n                    <option value=\"vintage_a_accuracy_pct\">\n                      Vintage A accuracy\n                    </option>\n                    <option value=\"vintage_b_accuracy_pct\">\n                      Vintage B accuracy\n                    </option>\n                    <option value=\"accuracy_delta_pp\">Accuracy delta</option>\n                    <option value=\"revision_effectiveness_pct\">\n                      Revision effectiveness\n                    </option>\n                  </select></label\n                >\n                <span class=\"metricbar__note\"\n                  >Every point is derived from the active population.</span\n                >\n              </div>\n              <section class=\"frame trend-main\">\n                <header class=\"frame__head\">\n                  <div>\n                    <h3 class=\"frame__title\" data-trend-title>\n                      Monthly performance\n                    </h3>\n                    <p class=\"frame__sub\" data-trend-subtitle></p>\n                  </div>\n                  <div class=\"legend\" data-trend-legend></div>\n                </header>\n                <div class=\"frame__body\" data-trend-chart></div>\n              </section>\n              <div class=\"grid2 trend-lower\">\n                <section class=\"frame\">\n                  <header class=\"frame__head\">\n                    <div>\n                      <h3 class=\"frame__title\">Performance by horizon</h3>\n                      <p class=\"frame__sub\">\n                        Selected source or exact aligned comparison\n                      </p>\n                    </div>\n                    <span class=\"frame__metric\" data-horizon-range></span>\n                  </header>\n                  <div class=\"frame__body\">\n                    <div class=\"dual-bars\" data-horizon-bars></div>\n                  </div>\n                </section>\n                <section class=\"frame\">\n                  <header class=\"frame__head\">\n                    <div>\n                      <h3 class=\"frame__title\">Brand × target month</h3>\n                      <p class=\"frame__sub\">\n                        Worst-first with explicit quality groups\n                      </p>\n                    </div>\n                    <span class=\"frame__metric\" data-heatmap-range></span>\n                  </header>\n                  <div class=\"frame__body\">\n                    <div class=\"heatmap\" data-heatmap></div>\n                  </div>\n                </section>\n              </div>\n            </section>\n\n            <section\n              class=\"pane\"\n              id=\"pane-comparison\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-comparison\"\n            >\n              <div class=\"pane__head pane__head--with-control\">\n                <div>\n                  <p class=\"eyebrow\">Comparable populations</p>\n                  <h2 class=\"pane__title\">TM vs ML, and how revisions land</h2>\n                </div>\n                <div class=\"pane__head-actions\">\n                  <div\n                    class=\"subtabs\"\n                    data-subtabs=\"comparison\"\n                    role=\"group\"\n                    aria-label=\"Comparison analysis mode\"\n                  >\n                    <button\n                      class=\"subtab is-active\"\n                      aria-pressed=\"true\"\n                      data-subtab-target=\"revision\"\n                      type=\"button\"\n                    >\n                      Vintage revisions</button\n                    ><button\n                      class=\"subtab\"\n                      aria-pressed=\"false\"\n                      data-subtab-target=\"sources\"\n                      type=\"button\"\n                    >\n                      TM vs ML\n                    </button>\n                  </div>\n                </div>\n              </div>\n              <div\n                class=\"subpanel is-active\"\n                data-subpanel=\"comparison:revision\"\n                data-revision-panel\n              ></div>\n              <div\n                class=\"subpanel\"\n                data-subpanel=\"comparison:sources\"\n                data-source-panel\n                hidden\n              ></div>\n            </section>\n\n            <section\n              class=\"pane\"\n              id=\"pane-history\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-history\"\n            >\n              <div class=\"pane__head pane__head--with-control\">\n                <div>\n                  <p class=\"eyebrow\">Decision evidence</p>\n                  <h2 class=\"pane__title\">SKU post-mortem</h2>\n                </div>\n                <div class=\"pane__head-actions\">\n                  <span class=\"stamp\">active-scope detail</span>\n                  <div\n                    class=\"subtabs\"\n                    data-subtabs=\"history\"\n                    role=\"group\"\n                    aria-label=\"Product investigation mode\"\n                  >\n                    <button\n                      class=\"subtab is-active\"\n                      aria-pressed=\"true\"\n                      data-subtab-target=\"product\"\n                      type=\"button\"\n                    >\n                      SKU post-mortem</button\n                    ><button\n                      class=\"subtab\"\n                      aria-pressed=\"false\"\n                      data-subtab-target=\"exceptions\"\n                      type=\"button\"\n                    >\n                      Forecast exceptions\n                    </button>\n                  </div>\n                </div>\n              </div>\n              <div class=\"subpanel is-active\" data-subpanel=\"history:product\">\n                <div class=\"history-context\">\n                  <div\n                    class=\"toolbar history-toolbar\"\n                    aria-label=\"Product drill-down filter\"\n                  >\n                    <div\n                      class=\"field field--grow product-picker-field\"\n                      role=\"group\"\n                      aria-labelledby=\"product-picker-label\"\n                    >\n                      <span class=\"field__k\" id=\"product-picker-label\"\n                        >Product</span\n                      >\n                      <div class=\"product-picker\" data-product-picker>\n                        <button\n                          class=\"product-picker__trigger\"\n                          type=\"button\"\n                          aria-haspopup=\"listbox\"\n                          aria-expanded=\"false\"\n                          data-product-picker-trigger\n                        >\n                          <span data-product-picker-summary\n                            >Select product</span\n                          ><i aria-hidden=\"true\"></i>\n                        </button>\n                        <div\n                          class=\"product-picker__popover\"\n                          data-product-picker-popover\n                          hidden\n                        >\n                          <label class=\"product-picker__search\">\n                            <span>Search products</span>\n                            <input\n                              type=\"search\"\n                              role=\"combobox\"\n                              autocomplete=\"off\"\n                              aria-autocomplete=\"list\"\n                              aria-controls=\"product-picker-options\"\n                              aria-expanded=\"true\"\n                              placeholder=\"Search code or product name…\"\n                              data-product-search\n                            />\n                          </label>\n                          <span\n                            class=\"product-picker__status\"\n                            aria-live=\"polite\"\n                            data-product-search-status\n                          ></span>\n                          <div\n                            class=\"product-picker__options\"\n                            id=\"product-picker-options\"\n                            role=\"listbox\"\n                            aria-label=\"Products\"\n                            data-product-picker-options\n                          ></div>\n                        </div>\n                      </div>\n                      <select\n                        data-product-control=\"parent\"\n                        aria-label=\"Selected product\"\n                        hidden\n                      ></select>\n                      <select\n                        data-product-control=\"month\"\n                        aria-label=\"Selected target month\"\n                        hidden\n                      ></select>\n                    </div>\n                  </div>\n                  <div class=\"product-summary\" data-product-summary></div>\n                  <div\n                    class=\"postmortem-metrics\"\n                    aria-label=\"SKU post-mortem performance ledger\"\n                    data-postmortem-metrics\n                  ></div>\n                </div>\n                <div class=\"postmortem-cockpit\">\n                  <div class=\"postmortem-primary\">\n                    <section class=\"frame postmortem-performance-frame\">\n                      <header class=\"frame__head\">\n                        <div>\n                          <h3 class=\"frame__title\">\n                            Actual demand + forward outlook\n                          </h3>\n                          <p class=\"frame__sub\" data-year-overlay-summary>\n                            Apr–Mar FY comparison · actual history · latest\n                            coherent source run\n                          </p>\n                        </div>\n                        <div class=\"frame__actions\">\n                          <div\n                            class=\"legend year-overlay-legend\"\n                            data-year-overlay-legend\n                            aria-label=\"FY chart controls\"\n                          ></div>\n                          <button\n                            class=\"chart-expand\"\n                            data-action=\"chart-fullscreen\"\n                            data-chart-fullscreen=\"postmortem-performance\"\n                            type=\"button\"\n                            aria-label=\"Open actual demand and forward outlook chart full screen\"\n                            aria-haspopup=\"dialog\"\n                            aria-controls=\"overview-chart-dialog\"\n                          >\n                            <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                              <path d=\"M7 3H3v4M13 3h4v4M17 13v4h-4M7 17H3v-4\" />\n                            </svg>\n                            Full screen\n                          </button>\n                        </div>\n                      </header>\n                      <div\n                        class=\"frame__body postmortem-chart-body\"\n                        data-postmortem-performance-chart\n                      ></div>\n                    </section>\n                  </div>\n                  <div class=\"postmortem-secondary\">\n                    <section class=\"frame\">\n                      <header class=\"frame__head\">\n                        <div>\n                          <h3 class=\"frame__title\">\n                            Revision outcome · oldest → latest\n                          </h3>\n                          <p class=\"frame__sub\">\n                            Error improvement · zero baseline · by target month\n                          </p>\n                        </div>\n                        <div class=\"frame__actions\">\n                          <span\n                            class=\"frame__metric\"\n                            data-postmortem-revision-summary\n                          ></span>\n                          <button\n                            class=\"chart-expand\"\n                            data-action=\"chart-fullscreen\"\n                            data-chart-fullscreen=\"postmortem-revision\"\n                            type=\"button\"\n                            aria-label=\"Open revision outcome chart full screen\"\n                            aria-haspopup=\"dialog\"\n                            aria-controls=\"overview-chart-dialog\"\n                          >\n                            <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                              <path d=\"M7 3H3v4M13 3h4v4M17 13v4h-4M7 17H3v-4\" />\n                            </svg>\n                            Full screen\n                          </button>\n                        </div>\n                      </header>\n                      <div\n                        class=\"frame__body postmortem-revision-body\"\n                        data-postmortem-revision-chart\n                      ></div>\n                    </section>\n                    <section class=\"frame\">\n                      <header class=\"frame__head\">\n                        <div>\n                          <h3 class=\"frame__title\">Sibling benchmark</h3>\n                          <p class=\"frame__sub\">\n                            Same brand and SKU class · matched active scope\n                          </p>\n                        </div>\n                        <span\n                          class=\"frame__metric\"\n                          data-postmortem-peer-scope\n                        ></span>\n                      </header>\n                      <div\n                        class=\"frame__body postmortem-peer-body\"\n                        data-postmortem-peers\n                      ></div>\n                    </section>\n                  </div>\n                </div>\n                <div\n                  class=\"revision-table postmortem-revision-table\"\n                  role=\"table\"\n                  aria-label=\"Consecutive source-specific revisions\"\n                  data-product-revisions\n                ></div>\n              </div>\n              <div class=\"subpanel\" data-subpanel=\"history:exceptions\" hidden>\n                <div class=\"exception-toolbar\">\n                  <label class=\"field field--grow\"\n                    ><span class=\"field__k\"\n                      >Search products, brands or statuses</span\n                    ><input\n                      class=\"field__ctl\"\n                      type=\"search\"\n                      data-exception-search /></label\n                  ><label class=\"field\"\n                    ><span class=\"field__k\">Rows</span\n                    ><select class=\"field__ctl\" data-exception-limit>\n                      <option value=\"10\">Top 10</option>\n                      <option value=\"20\">Top 20</option>\n                      <option value=\"80\">All loaded</option>\n                    </select></label\n                  ><button\n                    class=\"btn\"\n                    type=\"button\"\n                    data-export-kind=\"vintages\"\n                  >\n                    Filtered vintages · CSV\n                  </button>\n                </div>\n                <div class=\"exception-summary\" data-exception-summary></div>\n                <div\n                  class=\"audit-table\"\n                  role=\"table\"\n                  aria-label=\"Filtered forecast exceptions\"\n                  data-exception-table\n                ></div>\n              </div>\n            </section>\n\n            <section\n              class=\"pane\"\n              id=\"pane-quality\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-quality\"\n            >\n              <div class=\"pane__head\">\n                <div>\n                  <p class=\"eyebrow\">Diagnostics</p>\n                  <h2 class=\"pane__title\">What the population hides</h2>\n                </div>\n                <span class=\"stamp stamp--warn\" data-quality-stamp\n                  >Loading diagnostics</span\n                >\n              </div>\n              <div class=\"blocking\" data-blocking></div>\n              <div class=\"ql\" data-quality-cards></div>\n              <div\n                class=\"subtabs quality-tabs\"\n                data-subtabs=\"quality\"\n                role=\"group\"\n                aria-label=\"Quality diagnostic category\"\n              >\n                <button\n                  class=\"subtab is-active\"\n                  aria-pressed=\"true\"\n                  data-subtab-target=\"hierarchy\"\n                  type=\"button\"\n                >\n                  Hierarchy</button\n                ><button\n                  class=\"subtab\"\n                  aria-pressed=\"false\"\n                  data-subtab-target=\"actual\"\n                  type=\"button\"\n                >\n                  Actuals</button\n                ><button\n                  class=\"subtab\"\n                  aria-pressed=\"false\"\n                  data-subtab-target=\"pairs\"\n                  type=\"button\"\n                >\n                  Vintage pairs</button\n                ><button\n                  class=\"subtab\"\n                  aria-pressed=\"false\"\n                  data-subtab-target=\"source_availability\"\n                  type=\"button\"\n                >\n                  Source availability\n                </button>\n              </div>\n              <div\n                class=\"quality-panel subpanel is-active\"\n                data-subpanel=\"quality:hierarchy\"\n              ></div>\n              <div\n                class=\"quality-panel subpanel\"\n                data-subpanel=\"quality:actual\"\n                hidden\n              ></div>\n              <div\n                class=\"quality-panel subpanel\"\n                data-subpanel=\"quality:pairs\"\n                hidden\n              ></div>\n              <div\n                class=\"quality-panel subpanel\"\n                data-subpanel=\"quality:source_availability\"\n                hidden\n              ></div>\n              <details class=\"baseline\">\n                <summary data-baseline-summary>\n                  Baseline scope exclusions\n                </summary>\n                <div data-baseline></div>\n              </details>\n            </section>\n          </main>\n        </div>\n      </div>\n\n      <div\n        class=\"chart-dialog\"\n        id=\"overview-chart-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"overview-chart-dialog-title\"\n        hidden\n      >\n        <header class=\"chart-dialog__head\">\n          <div>\n            <p class=\"eyebrow\">Chart analysis</p>\n            <h2 id=\"overview-chart-dialog-title\">Overview chart</h2>\n          </div>\n          <div class=\"chart-dialog__actions\">\n            <button\n              class=\"vintage-selector__trigger vintage-selector__trigger--dialog\"\n              data-vintage-selector-trigger\n              type=\"button\"\n              aria-label=\"Choose forecast vintages to compare\"\n              aria-haspopup=\"dialog\"\n              aria-expanded=\"false\"\n              hidden\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"M4 6h12M4 10h12M4 14h12\" />\n              </svg>\n              Vintages\n              <strong data-vintage-selector-count>1</strong>\n            </button>\n            <button\n              class=\"btn btn--accent\"\n              data-action=\"fullscreen-filters\"\n              type=\"button\"\n              aria-expanded=\"false\"\n              aria-controls=\"scope-drawer\"\n            >\n              Filters · 0\n            </button>\n            <button\n              class=\"chart-expand\"\n              data-action=\"overview-fullscreen-close\"\n              type=\"button\"\n              aria-label=\"Close full-screen chart\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </div>\n        </header>\n        <div class=\"chart-dialog__legend legend\" data-chart-dialog-legend></div>\n        <div class=\"chart-dialog__body\" data-overview-chart-fullscreen></div>\n      </div>\n\n      <div\n        class=\"vintage-gap-dialog\"\n        id=\"vintage-gap-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"vintage-gap-title\"\n        aria-describedby=\"vintage-gap-subtitle\"\n        hidden\n      >\n        <section class=\"vintage-gap-dialog__panel\">\n          <header class=\"vintage-gap-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-vintage-gap-eyebrow>\n                Monthly WAPE reconciliation\n              </p>\n              <h2 id=\"vintage-gap-title\" data-vintage-gap-title>\n                Vintage gap drivers\n              </h2>\n              <p id=\"vintage-gap-subtitle\" data-vintage-gap-subtitle></p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"vintage-gap-close\"\n              type=\"button\"\n              aria-label=\"Close vintage gap drivers\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n          <div class=\"vintage-gap-dialog__body\" data-vintage-gap-body></div>\n        </section>\n      </div>\n\n      <div\n        class=\"revision-effectiveness-dialog\"\n        id=\"revision-effectiveness-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"revision-effectiveness-title\"\n        hidden\n      >\n        <section class=\"revision-effectiveness-dialog__panel\">\n          <header class=\"revision-effectiveness-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-effectiveness-eyebrow>\n                Selected target month · vintage\n              </p>\n              <h2 id=\"revision-effectiveness-title\" data-effectiveness-title>\n                Revision effectiveness breakdown\n              </h2>\n              <p data-effectiveness-subtitle></p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"revision-effectiveness-close\"\n              type=\"button\"\n              aria-label=\"Close revision effectiveness breakdown\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n          <div\n            class=\"revision-effectiveness-dialog__body\"\n            data-effectiveness-body\n          ></div>\n        </section>\n      </div>\n\n      <div\n        class=\"revision-effectiveness-guide-dialog\"\n        id=\"revision-effectiveness-guide-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"revision-effectiveness-guide-title\"\n        aria-describedby=\"revision-effectiveness-guide-summary\"\n        hidden\n      >\n        <section class=\"revision-effectiveness-guide-dialog__panel\">\n          <header class=\"revision-effectiveness-guide-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-effectiveness-guide-context>\n                Chart guide · five-vintage target-month journeys\n              </p>\n              <h2 id=\"revision-effectiveness-guide-title\">\n                How to read the balanced revision effectiveness score\n              </h2>\n              <p id=\"revision-effectiveness-guide-summary\">\n                This chart asks whether each new forecast version made the\n                forecast meaningfully better—not merely whether it changed.\n              </p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"revision-effectiveness-guide-close\"\n              type=\"button\"\n              aria-label=\"Close revision effectiveness chart guide\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n\n          <div class=\"revision-effectiveness-guide-dialog__body\">\n            <div class=\"revision-guide__distinction\">\n              <strong>Two related measures, two different questions</strong>\n              <span\n                ><b>Revision effectiveness %</b> counts how many material\n                revisions helped.</span\n              >\n              <span\n                ><b>This balanced score</b> measures how much error was removed,\n                how efficiently, and how consistently.</span\n              >\n            </div>\n\n            <article class=\"revision-guide__card revision-guide__card--reading\">\n              <div class=\"revision-guide__card-head\">\n                <span>01</span>\n                <div>\n                  <h3>Read one month as a journey</h3>\n                  <p>Every target month starts again at a neutral 50.</p>\n                </div>\n              </div>\n              <svg\n                class=\"revision-guide__step-visual\"\n                viewBox=\"0 0 480 190\"\n                role=\"img\"\n                aria-label=\"Two example target months. The first rises from a neutral score of 50 to an effective score of 82. The second falls from 50 to a harmful score of 28.\"\n              >\n                <g class=\"revision-guide__micro-grid\">\n                  <line x1=\"35\" x2=\"445\" y1=\"38\" y2=\"38\" />\n                  <line x1=\"35\" x2=\"445\" y1=\"85\" y2=\"85\" />\n                  <line x1=\"35\" x2=\"445\" y1=\"132\" y2=\"132\" />\n                  <text x=\"26\" y=\"42\" text-anchor=\"end\">80</text>\n                  <text x=\"26\" y=\"89\" text-anchor=\"end\">50</text>\n                  <text x=\"26\" y=\"136\" text-anchor=\"end\">20</text>\n                </g>\n                <line\n                  class=\"revision-guide__neutral-line\"\n                  x1=\"35\"\n                  x2=\"445\"\n                  y1=\"85\"\n                  y2=\"85\"\n                />\n                <path\n                  class=\"revision-guide__example-path revision-guide__example-path--good\"\n                  d=\"M 54 85 H 91 V 69 H 128 V 77 H 165 V 52 H 202 V 35\"\n                />\n                <path\n                  class=\"revision-guide__example-path revision-guide__example-path--bad\"\n                  d=\"M 278 85 H 315 V 97 H 352 V 118 H 389 V 110 H 426 V 139\"\n                />\n                <g class=\"revision-guide__micro-points\">\n                  <circle cx=\"54\" cy=\"85\" r=\"5\" />\n                  <circle cx=\"91\" cy=\"69\" r=\"5\" />\n                  <circle cx=\"128\" cy=\"77\" r=\"5\" />\n                  <circle cx=\"165\" cy=\"52\" r=\"5\" />\n                  <circle cx=\"202\" cy=\"35\" r=\"6\" />\n                  <circle cx=\"278\" cy=\"85\" r=\"5\" />\n                  <circle cx=\"315\" cy=\"97\" r=\"5\" />\n                  <circle cx=\"352\" cy=\"118\" r=\"5\" />\n                  <circle cx=\"389\" cy=\"110\" r=\"5\" />\n                  <circle cx=\"426\" cy=\"139\" r=\"6\" />\n                </g>\n                <g class=\"revision-guide__micro-labels\">\n                  <text x=\"128\" y=\"170\" text-anchor=\"middle\">\n                    Target month A · error removed\n                  </text>\n                  <text x=\"352\" y=\"170\" text-anchor=\"middle\">\n                    Target month B · error added\n                  </text>\n                  <text x=\"202\" y=\"24\" text-anchor=\"middle\">82</text>\n                  <text x=\"426\" y=\"154\" text-anchor=\"middle\">28</text>\n                </g>\n              </svg>\n              <div class=\"revision-guide__reading-key\">\n                <span\n                  ><i class=\"is-up\"></i>Step up: the new vintage helped</span\n                >\n                <span><i class=\"is-down\"></i>Step down: it added error</span>\n                <span\n                  ><i class=\"is-latest\"></i>Outlined point: latest vintage</span\n                >\n              </div>\n            </article>\n\n            <article class=\"revision-guide__card revision-guide__card--formula\">\n              <div class=\"revision-guide__card-head\">\n                <span>02</span>\n                <div>\n                  <h3>Three ingredients build the score</h3>\n                  <p>Each ingredient is centred on 50 and bounded 0–100.</p>\n                </div>\n              </div>\n              <div class=\"revision-guide__formula\">\n                <div class=\"revision-guide__ingredient\">\n                  <div><strong>50%</strong><b>Accuracy gain</b></div>\n                  <p>How much of V1’s starting absolute error was removed?</p>\n                  <div class=\"revision-guide__ingredient-visual\">\n                    <span>V1 error</span><i style=\"--score-width: 78%\"></i\n                    ><em>error removed</em>\n                  </div>\n                </div>\n                <div class=\"revision-guide__ingredient\">\n                  <div><strong>30%</strong><b>Revision efficiency</b></div>\n                  <p>How much error was removed per 1 KL of total movement?</p>\n                  <div class=\"revision-guide__ratio-visual\">\n                    <span>forecast movement</span><b>→</b\n                    ><span>error removed</span>\n                  </div>\n                </div>\n                <div class=\"revision-guide__ingredient\">\n                  <div><strong>20%</strong><b>Consistency</b></div>\n                  <p>Were movement-weighted vintage steps mostly helpful?</p>\n                  <div class=\"revision-guide__outcome-visual\">\n                    <i class=\"is-helpful\"></i><i class=\"is-helpful\"></i\n                    ><i class=\"is-harmful\"></i><i class=\"is-helpful\"></i>\n                  </div>\n                </div>\n              </div>\n              <div class=\"revision-guide__equation\">\n                <span>Overall</span><b>=</b><span>50% accuracy</span><b>+</b\n                ><span>30% efficiency</span><b>+</b><span>20% consistency</span\n                ><b>→</b><strong>0–100</strong>\n              </div>\n            </article>\n\n            <article\n              class=\"revision-guide__card revision-guide__card--interpretation\"\n            >\n              <div class=\"revision-guide__card-head\">\n                <span>03</span>\n                <div>\n                  <h3>Interpret level and shape together</h3>\n                  <p>The destination matters, but so does the path.</p>\n                </div>\n              </div>\n              <div class=\"revision-guide__bands\">\n                <div class=\"is-high\">\n                  <b>80–100</b><span>Highly effective</span\n                  ><small>Large, efficient and dependable improvement</small>\n                </div>\n                <div class=\"is-useful\">\n                  <b>60–79</b><span>Effective</span\n                  ><small>Revisions produced useful net improvement</small>\n                </div>\n                <div class=\"is-mixed\">\n                  <b>40–59</b><span>Mixed</span\n                  ><small>Inspect whipsaw, timing and weak signals</small>\n                </div>\n                <div class=\"is-harmful\">\n                  <b>0–39</b><span>Harmful</span\n                  ><small>Revisions added material forecast error</small>\n                </div>\n              </div>\n              <div class=\"revision-guide__shape-notes\">\n                <span\n                  ><b>↗ Steady rise</b> Preserve the signals and process.</span\n                >\n                <span\n                  ><b>↕ Whipsaw</b> Test cadence, assumptions and\n                  ownership.</span\n                >\n                <span\n                  ><b>↘ Decline</b> Find which vintage introduced error.</span\n                >\n              </div>\n            </article>\n\n            <section class=\"revision-guide__discussion\">\n              <div class=\"revision-guide__discussion-intro\">\n                <span>04</span>\n                <div>\n                  <h3>Turn the pattern into a better review</h3>\n                  <p>\n                    Use the chart to examine decision quality and timing—not to\n                    grade an individual planner from one score.\n                  </p>\n                </div>\n              </div>\n              <div>\n                <strong>With the forecasting team</strong>\n                <ul>\n                  <li>Which vintage created the largest rise or fall?</li>\n                  <li>What signal, override or assumption caused it?</li>\n                  <li>Could the useful information have arrived earlier?</li>\n                </ul>\n              </div>\n              <div>\n                <strong>With the business team</strong>\n                <ul>\n                  <li>What business assumption changed between vintages?</li>\n                  <li>Was the amount moved proportionate to the evidence?</li>\n                  <li>What decision or input should change next cycle?</li>\n                </ul>\n              </div>\n            </section>\n          </div>\n\n          <footer class=\"revision-effectiveness-guide-dialog__foot\">\n            <span\n              ><b>Fixed cohort:</b> products present in all five vintages</span\n            >\n            <span><b>Window:</b> latest six target months with actuals</span>\n            <span\n              ><b>Important:</b> each month is independent and resets at\n              V1</span\n            >\n            <span\n              ><b>Next:</b> click a chart point for its evidence breakdown</span\n            >\n          </footer>\n        </section>\n      </div>\n\n      <div\n        class=\"revision-effectiveness-guide-dialog\"\n        id=\"revision-scatter-guide-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"revision-scatter-guide-title\"\n        aria-describedby=\"revision-scatter-guide-summary\"\n        hidden\n      >\n        <section class=\"revision-effectiveness-guide-dialog__panel\">\n          <header class=\"revision-effectiveness-guide-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-scatter-guide-context>\n                Chart guide · parent-level revision behaviour\n              </p>\n              <h2 id=\"revision-scatter-guide-title\">\n                How to read parent vintage trend vs improvement score\n              </h2>\n              <p id=\"revision-scatter-guide-summary\">\n                Each bubble connects the direction forecasts moved with whether\n                that movement made the forecast more accurate.\n              </p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"revision-scatter-guide-close\"\n              type=\"button\"\n              aria-label=\"Close parent vintage scatter chart guide\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n\n          <div class=\"scatter-guide__body\">\n            <div class=\"scatter-guide__scope\">\n              <strong>One bubble is one parent code</strong>\n              <span>Six complete target months</span><b>×</b\n              ><span>Five vintages per month</span><b>→</b\n              ><span>Median parent behaviour</span>\n            </div>\n\n            <article class=\"revision-guide__card scatter-guide__card--read\">\n              <div class=\"revision-guide__card-head\">\n                <span>01</span>\n                <div>\n                  <h3>Start with the two axes</h3>\n                  <p>Direction is horizontal; decision quality is vertical.</p>\n                </div>\n              </div>\n              <svg\n                class=\"scatter-guide__quadrant\"\n                viewBox=\"0 0 470 270\"\n                role=\"img\"\n                aria-label=\"Four-quadrant scatter guide with a density heatmap. Bubbles above zero improved accuracy. Bubbles below zero worsened it. Left means forecasts trended down, right means forecasts trended up, and darker teal cells contain more parent bubbles.\"\n              >\n                <g class=\"scatter-guide__grid\">\n                  <line x1=\"48\" x2=\"448\" y1=\"32\" y2=\"32\" />\n                  <line x1=\"48\" x2=\"448\" y1=\"125\" y2=\"125\" />\n                  <line x1=\"48\" x2=\"448\" y1=\"218\" y2=\"218\" />\n                  <line x1=\"118\" x2=\"118\" y1=\"20\" y2=\"230\" />\n                  <line x1=\"248\" x2=\"248\" y1=\"20\" y2=\"230\" />\n                  <line x1=\"378\" x2=\"378\" y1=\"20\" y2=\"230\" />\n                </g>\n                <g class=\"scatter-guide__heat-cells\" aria-hidden=\"true\">\n                  <rect x=\"197\" y=\"87\" width=\"49\" height=\"36\" rx=\"3\" />\n                  <rect x=\"250\" y=\"87\" width=\"49\" height=\"36\" rx=\"3\" />\n                  <rect x=\"303\" y=\"87\" width=\"49\" height=\"36\" rx=\"3\" />\n                  <rect\n                    class=\"is-medium\"\n                    x=\"197\"\n                    y=\"127\"\n                    width=\"49\"\n                    height=\"36\"\n                    rx=\"3\"\n                  />\n                  <rect\n                    class=\"is-peak\"\n                    x=\"250\"\n                    y=\"127\"\n                    width=\"49\"\n                    height=\"36\"\n                    rx=\"3\"\n                  />\n                  <rect\n                    class=\"is-medium\"\n                    x=\"303\"\n                    y=\"127\"\n                    width=\"49\"\n                    height=\"36\"\n                    rx=\"3\"\n                  />\n                </g>\n                <line\n                  class=\"scatter-guide__zero\"\n                  x1=\"48\"\n                  x2=\"448\"\n                  y1=\"125\"\n                  y2=\"125\"\n                />\n                <line\n                  class=\"scatter-guide__zero\"\n                  x1=\"248\"\n                  x2=\"248\"\n                  y1=\"20\"\n                  y2=\"230\"\n                />\n                <g class=\"scatter-guide__quadrant-labels\">\n                  <text x=\"145\" y=\"49\" text-anchor=\"middle\">\n                    LOWER FORECAST\n                  </text>\n                  <text x=\"145\" y=\"62\" text-anchor=\"middle\">MORE ACCURATE</text>\n                  <text x=\"351\" y=\"49\" text-anchor=\"middle\">\n                    HIGHER FORECAST\n                  </text>\n                  <text x=\"351\" y=\"62\" text-anchor=\"middle\">MORE ACCURATE</text>\n                  <text x=\"145\" y=\"199\" text-anchor=\"middle\">\n                    LOWER FORECAST\n                  </text>\n                  <text x=\"145\" y=\"212\" text-anchor=\"middle\">\n                    LESS ACCURATE\n                  </text>\n                  <text x=\"351\" y=\"199\" text-anchor=\"middle\">\n                    HIGHER FORECAST\n                  </text>\n                  <text x=\"351\" y=\"212\" text-anchor=\"middle\">\n                    LESS ACCURATE\n                  </text>\n                </g>\n                <g class=\"scatter-guide__bubbles\">\n                  <circle class=\"is-good\" cx=\"131\" cy=\"83\" r=\"15\" />\n                  <circle class=\"is-good\" cx=\"339\" cy=\"70\" r=\"23\" />\n                  <circle class=\"is-bad\" cx=\"160\" cy=\"169\" r=\"11\" />\n                  <circle class=\"is-bad\" cx=\"366\" cy=\"181\" r=\"18\" />\n                  <circle class=\"is-neutral\" cx=\"252\" cy=\"122\" r=\"8\" />\n                </g>\n                <text\n                  class=\"scatter-guide__axis\"\n                  x=\"248\"\n                  y=\"257\"\n                  text-anchor=\"middle\"\n                >\n                  Forecast trend · down ← 0 → up\n                </text>\n                <text\n                  class=\"scatter-guide__axis\"\n                  x=\"14\"\n                  y=\"125\"\n                  text-anchor=\"middle\"\n                  transform=\"rotate(-90 14 125)\"\n                >\n                  Accuracy trend · worse ← 0 → better\n                </text>\n              </svg>\n              <div class=\"scatter-guide__reading-key\">\n                <span\n                  ><i class=\"is-good\"></i><b>Above zero</b> revisions improved\n                  accuracy</span\n                >\n                <span\n                  ><i class=\"is-bad\"></i><b>Below zero</b> revisions worsened\n                  accuracy</span\n                >\n                <span\n                  ><i class=\"is-density\"></i><b>Darker heat cell</b> more parent\n                  bubbles occupy that area</span\n                >\n              </div>\n            </article>\n\n            <article class=\"revision-guide__card scatter-guide__card--build\">\n              <div class=\"revision-guide__card-head\">\n                <span>02</span>\n                <div>\n                  <h3>How one bubble is calculated</h3>\n                  <p>\n                    The chart looks for a repeatable trend, not one isolated\n                    edit.\n                  </p>\n                </div>\n              </div>\n              <div class=\"scatter-guide__build-flow\">\n                <div>\n                  <b>1</b><span>For each target month, line up V1 → V5.</span>\n                </div>\n                <div>\n                  <b>2</b\n                  ><span\n                    >Measure the forecast-level trend as % of actual per\n                    vintage.</span\n                  >\n                </div>\n                <div>\n                  <b>3</b\n                  ><span\n                    >Measure the accuracy trend as forecast-accuracy points per\n                    vintage.</span\n                  >\n                </div>\n                <div>\n                  <b>4</b\n                  ><span\n                    >Take the median across six months to place the parent\n                    bubble.</span\n                  >\n                </div>\n              </div>\n              <div class=\"scatter-guide__axis-cards\">\n                <div>\n                  <strong>X · Forecast trend</strong>\n                  <p><b>Positive:</b> forecasts rose through the vintages.</p>\n                  <p><b>Negative:</b> forecasts fell through the vintages.</p>\n                </div>\n                <div>\n                  <strong>Y · Improvement score</strong>\n                  <p><b>Positive:</b> forecast accuracy improved.</p>\n                  <p><b>Negative:</b> forecast accuracy deteriorated.</p>\n                </div>\n              </div>\n              <p class=\"scatter-guide__caution\">\n                X is not bias and Y is not the balanced 0–100 score. Both are\n                slopes across vintages, summarized by the six-month median.\n              </p>\n            </article>\n\n            <article class=\"revision-guide__card scatter-guide__card--act\">\n              <div class=\"revision-guide__card-head\">\n                <span>03</span>\n                <div>\n                  <h3>Read bubbles and heatmap together</h3>\n                  <p>\n                    Separate individual parents from the population’s common\n                    pattern.\n                  </p>\n                </div>\n              </div>\n              <div class=\"scatter-guide__signals\">\n                <div class=\"is-good\">\n                  <b>Good pattern</b\n                  ><span\n                    >Upper half, repeated across months. Preserve the signal and\n                    timing.</span\n                  >\n                </div>\n                <div class=\"is-watch\">\n                  <b>Watch closely</b\n                  ><span\n                    >Near zero or dense clusters. The process may be stable but\n                    not learning much.</span\n                  >\n                </div>\n                <div class=\"is-bad\">\n                  <b>Bad pattern</b\n                  ><span\n                    >Lower half—especially large-error or extreme bubbles.\n                    Revisions repeatedly added error.</span\n                  >\n                </div>\n              </div>\n              <div class=\"scatter-guide__heatmap-explainer\">\n                <div class=\"scatter-guide__heatmap-scale\" aria-hidden=\"true\">\n                  <i></i><i></i><i></i><i></i><i></i>\n                </div>\n                <div>\n                  <strong>Heatmap = concentration, not performance</strong>\n                  <p>\n                    The plot is divided into <b>14 × 8 cells</b>. Every parent\n                    bubble adds one count to its cell; darker teal means more\n                    parents there relative to the busiest cell.\n                  </p>\n                </div>\n              </div>\n              <div class=\"scatter-guide__controls\">\n                <strong>Use the controls intentionally</strong>\n                <span\n                  ><b>Density</b> turns the heatmap layer on or off; it counts\n                  parents, not KL or impact.</span\n                >\n                <span\n                  ><b>Size by error</b> is the default; it shows the latest\n                  vintage’s absolute error summed across six target\n                  months.</span\n                >\n                <span\n                  ><b>Size by volume / Uniform dots</b> switches to commercial\n                  scale or removes size encoding.</span\n                >\n                <span\n                  ><b>Top volume / Outliers</b> hides bubbles while retaining\n                  the heatmap as population context.</span\n                >\n                <span\n                  ><b>SKU class</b> changes the plotted population and its\n                  heatmap.</span\n                >\n              </div>\n              <p class=\"scatter-guide__caution\">\n                A dark cell is not automatically good or bad—its vertical\n                position provides that meaning. The heatmap can also hide\n                overlapping parents, so use bubbles and selected evidence before\n                agreeing an action.\n              </p>\n            </article>\n\n            <section\n              class=\"revision-guide__discussion scatter-guide__discussion\"\n            >\n              <div class=\"revision-guide__discussion-intro\">\n                <span>04</span>\n                <div>\n                  <h3>Use the quadrant to structure the conversation</h3>\n                  <p>Start with what moved, then test why it helped or hurt.</p>\n                </div>\n              </div>\n              <div>\n                <strong>With the forecasting team</strong>\n                <ul>\n                  <li>\n                    Which parents show a repeatable helpful or harmful trend?\n                  </li>\n                  <li>Did the useful signal arrive early enough to act on?</li>\n                  <li>\n                    Do outliers reflect process, data quality or a one-off\n                    event?\n                  </li>\n                </ul>\n              </div>\n              <div>\n                <strong>With the business team</strong>\n                <ul>\n                  <li>What assumption explains the direction of movement?</li>\n                  <li>Which high-error parents deserve decision priority?</li>\n                  <li>What input or commitment should change next cycle?</li>\n                </ul>\n              </div>\n            </section>\n          </div>\n\n          <footer class=\"revision-effectiveness-guide-dialog__foot\">\n            <span\n              ><b>Cohort:</b> parents with six complete months × five\n              vintages</span\n            >\n            <span><b>Aggregation:</b> median monthly trend</span>\n            <span><b>Excluded:</b> listed super-seasonal families</span>\n            <span\n              ><b>Next:</b> select a bubble to filter KPIs and action\n              evidence</span\n            >\n          </footer>\n        </section>\n      </div>\n\n      <div\n        class=\"revision-effectiveness-guide-dialog\"\n        id=\"comparison-kpi-guide-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"comparison-kpi-guide-title\"\n        aria-describedby=\"comparison-kpi-guide-summary\"\n        hidden\n      >\n        <section class=\"revision-effectiveness-guide-dialog__panel\">\n          <header class=\"revision-effectiveness-guide-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-comparison-kpi-guide-context>\n                Metric guide · active comparison population\n              </p>\n              <h2 id=\"comparison-kpi-guide-title\">How to read this metric</h2>\n              <p id=\"comparison-kpi-guide-summary\"></p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"comparison-kpi-guide-close\"\n              type=\"button\"\n              aria-label=\"Close comparison metric guide\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n\n          <div class=\"comparison-kpi-guide__body\">\n            <section data-comparison-kpi-guide=\"accuracy-delta\">\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >Did Vintage B reduce forecast error relative to Vintage A,\n                  after scaling the result by actual demand?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read the number as error removed</h3>\n                    <p>\n                      Positive percentage points mean the later vintage was more\n                      accurate.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__error-bars\">\n                  <div>\n                    <span>Vintage A error</span><i style=\"--guide-bar: 88%\"></i\n                    ><b>starting error</b>\n                  </div>\n                  <div class=\"is-good\">\n                    <span>Vintage B error</span><i style=\"--guide-bar: 55%\"></i\n                    ><b>smaller</b>\n                  </div>\n                  <em>the gap is error removed</em>\n                </div>\n                <div class=\"comparison-kpi-guide__example\">\n                  <b>Example · +4.6 pp</b\n                  ><span\n                    >Vintage B removed absolute error equal to 4.6% of the\n                    population’s actual volume.</span\n                  >\n                </div>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>How it is calculated</h3>\n                    <p>All complete product-target-month pairs contribute.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>Σ |A − actual|</span><b>−</b><span>Σ |B − actual|</span\n                  ><b>÷</b><span>Σ actual</span><b>× 100</b>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>1.</b> Find absolute error for A and B in each\n                    pair.</span\n                  >\n                  <span\n                    ><b>2.</b> Add the errors across the active\n                    population.</span\n                  >\n                  <span\n                    ><b>3.</b> Divide net error removed by total actual\n                    volume.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  This is population-weighted: large-volume observations\n                  influence the result more. It is not an average of SKU\n                  accuracy percentages.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>\n                      Direction is clear; context explains whether the gain is\n                      repeatable.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Positive</b><span>B removed net error</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Near zero</b\n                    ><span>Little net change or gains offset losses</span>\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Negative</b><span>B added net error</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  Oldest and latest available forecasts can represent different\n                  horizons by product-month unless exact horizons are selected.\n                  A positive total can also hide pockets that worsened.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss the value of revision</h3>\n                    <p>\n                      Pair the aggregate result with the action queue before\n                      deciding what to repeat.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>\n                      Which products created most of the net gain or loss?\n                    </li>\n                    <li>Was improvement consistent across horizons?</li>\n                    <li>Which late signal could have been used earlier?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>\n                      Which changed assumption produced measurable accuracy\n                      value?\n                    </li>\n                    <li>Did better accuracy arrive in time for a decision?</li>\n                    <li>Where did offsetting losses occur?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section data-comparison-kpi-guide=\"effectiveness\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >When the forecast was meaningfully changed, how often did\n                  that change move closer to actual demand?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read it as a hit rate</h3>\n                    <p>\n                      Every materially revised pair gets one vote, regardless of\n                      volume.\n                    </p>\n                  </div>\n                </div>\n                <div\n                  class=\"comparison-kpi-guide__hit-rate\"\n                  aria-label=\"Example hit rate with seven improved revisions and five revisions that did not improve\"\n                >\n                  <i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-good\"></i><i class=\"is-bad\"></i\n                  ><i class=\"is-bad\"></i><i class=\"is-bad\"></i\n                  ><i class=\"is-bad\"></i><i class=\"is-bad\"></i>\n                </div>\n                <div class=\"comparison-kpi-guide__example\">\n                  <b>Example · 58.3%</b\n                  ><span\n                    >About 58 of every 100 meaningful revisions improved\n                    accuracy; roughly 42 did not.</span\n                  >\n                </div>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>How it is calculated</h3>\n                    <p>\n                      Unchanged or immaterial pairs stay out of the denominator.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>Revised pairs that improved</span><b>÷</b\n                  ><span>All materially revised pairs</span><b>× 100</b>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>Improved:</b> B’s absolute error is meaningfully lower\n                    than A’s.</span\n                  >\n                  <span\n                    ><b>Worsened:</b> B’s absolute error is meaningfully\n                    higher.</span\n                  >\n                  <span\n                    ><b>Neutral:</b> the forecast moved, but accuracy barely\n                    changed.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  This is count-based, not volume-weighted. A tiny product and a\n                  major product each count as one pair.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>\n                      Higher is better, but magnitude belongs in the other two\n                      KPIs.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Clearly above 50%</b\n                    ><span>Most meaningful revisions helped</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Around 50%</b\n                    ><span\n                      >Mixed process; inspect where wins and losses occur</span\n                    >\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Below 50%</b\n                    ><span>More meaningful revisions failed than helped</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  A high hit rate can still deliver little value if gains are\n                  tiny. A lower hit rate can coexist with positive net\n                  improvement if a few large gains dominate. Always triangulate\n                  all three cards.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss process reliability</h3>\n                    <p>\n                      Ask why revision decisions succeed or fail repeatedly.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>Which revision types have the strongest hit rate?</li>\n                    <li>\n                      Are failures concentrated by planner, horizon or product?\n                    </li>\n                    <li>Which checks would prevent avoidable harmful moves?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>Which inputs consistently improve the forecast?</li>\n                    <li>Where are assumption changes creating noise?</li>\n                    <li>\n                      What evidence should be required before a late override?\n                    </li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section data-comparison-kpi-guide=\"error-improvement\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >How many KL of absolute forecast error did Vintage B\n                  remove—or add—across the complete comparison population?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read it as a net error ledger</h3>\n                    <p>\n                      Helpful and harmful pairs are added together in physical\n                      volume.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__ledger\">\n                  <span class=\"is-good\" style=\"--ledger-height: 72%\"\n                    ><b>+820</b></span\n                  >\n                  <span class=\"is-good\" style=\"--ledger-height: 52%\"\n                    ><b>+590</b></span\n                  >\n                  <span class=\"is-bad\" style=\"--ledger-height: 38%\"\n                    ><b>−430</b></span\n                  >\n                  <span class=\"is-good\" style=\"--ledger-height: 64%\"\n                    ><b>+730</b></span\n                  >\n                  <span class=\"is-bad\" style=\"--ledger-height: 26%\"\n                    ><b>−290</b></span\n                  >\n                  <em>individual pair contributions → net total</em>\n                </div>\n                <div class=\"comparison-kpi-guide__example\">\n                  <b>Example · +1,943.1 KL</b\n                  ><span\n                    >After gains and losses were combined, Vintage B removed\n                    1,943.1 KL of absolute error.</span\n                  >\n                </div>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>How it is calculated</h3>\n                    <p>\n                      Each complete pair contributes a positive or negative KL\n                      amount.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>For every pair</span><b>Σ</b\n                  ><span>(|A − actual| − |B − actual|)</span>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>Positive contribution:</b> B has less absolute\n                    error.</span\n                  >\n                  <span\n                    ><b>Negative contribution:</b> B has more absolute\n                    error.</span\n                  >\n                  <span\n                    ><b>Net total:</b> all helpful and harmful contributions\n                    combined.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  The unit is KL, so the number grows with both impact and\n                  population size. Use accuracy delta when you need a normalized\n                  percentage-point comparison.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>\n                      Magnitude shows business impact, not how consistently the\n                      process worked.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Positive</b><span>Net absolute error was removed</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Near zero</b\n                    ><span>Limited impact or gains offset losses</span>\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Negative</b><span>Net absolute error was added</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  One large-volume gain can mask many smaller failures, and one\n                  major loss can overwhelm many small wins. Pair this with\n                  revision effectiveness to separate magnitude from frequency.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss commercial impact</h3>\n                    <p>\n                      Trace the net result back to the parents and decisions\n                      that created it.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>\n                      Which parents contributed most to error removed or added?\n                    </li>\n                    <li>\n                      Were the largest losses detectable before the revision?\n                    </li>\n                    <li>Which successful patterns should be repeated?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>\n                      What is the operational value of the KL error removed?\n                    </li>\n                    <li>\n                      Which high-volume assumption changes drove the result?\n                    </li>\n                    <li>Where should accountability or inputs change?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n          </div>\n\n          <footer class=\"revision-effectiveness-guide-dialog__foot\">\n            <span\n              ><b>Population:</b> complete A/B/actual pairs in active\n              filters</span\n            >\n            <span\n              ><b>Important:</b> the three KPIs answer different questions</span\n            >\n            <span\n              ><b>Best practice:</b> interpret frequency, normalized gain and KL\n              impact together</span\n            >\n          </footer>\n        </section>\n      </div>\n\n      <div\n        class=\"revision-effectiveness-guide-dialog\"\n        id=\"overview-guide-dialog\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"overview-guide-title\"\n        aria-describedby=\"overview-guide-summary\"\n        hidden\n      >\n        <section class=\"revision-effectiveness-guide-dialog__panel\">\n          <header class=\"revision-effectiveness-guide-dialog__head\">\n            <div>\n              <p class=\"eyebrow\" data-overview-guide-context>\n                Guide · accuracy chart common cohort\n              </p>\n              <h2 id=\"overview-guide-title\">How to read this metric</h2>\n              <p id=\"overview-guide-summary\"></p>\n            </div>\n            <button\n              class=\"chart-expand\"\n              data-action=\"overview-guide-close\"\n              type=\"button\"\n              aria-label=\"Close overview guide\"\n            >\n              <svg viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n                <path d=\"m5 5 10 10M15 5 5 15\" />\n              </svg>\n              Close\n            </button>\n          </header>\n\n          <div class=\"comparison-kpi-guide__body overview-guide__body\">\n            <section data-overview-guide=\"accuracy\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >Across the accuracy chart’s common cohort, how large was the\n                  KPI vintage’s absolute error relative to actual demand?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read it as 100% minus the error burden</h3>\n                    <p>\n                      Higher means the chart’s KPI vintage was closer to actual\n                      demand.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__error-bars\">\n                  <div>\n                    <span>Large parent</span><i style=\"--guide-bar: 20%\"></i\n                    ><b>err 18 / 90 KL</b>\n                  </div>\n                  <div>\n                    <span>Small parent</span><i style=\"--guide-bar: 50%\"></i\n                    ><b>err 5 / 10 KL</b>\n                  </div>\n                  <div class=\"is-good\">\n                    <span>Population</span><i style=\"--guide-bar: 23%\"></i\n                    ><b>err 23 / 100 KL</b>\n                  </div>\n                  <em>bars show each row’s error share of its actual volume</em>\n                </div>\n                <div class=\"comparison-kpi-guide__example\">\n                  <b>Example · 77%</b\n                  ><span\n                    >The population carried 23 KL of absolute error for every\n                    100 KL of actual demand. It does not mean 77% of forecasts\n                    were correct.</span\n                  >\n                </div>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>Add first, divide once</h3>\n                    <p>One population ratio, not an average of products.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>100</span><b>−</b><span>Σ |forecast − actual|</span\n                  ><b>÷</b><span>Σ actual</span><b>× 100</b>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>1.</b> Keep complete pairs with a positive actual.</span\n                  >\n                  <span><b>2.</b> Take each pair’s absolute error in KL.</span>\n                  <span\n                    ><b>3.</b> Sum errors and actuals, then form one\n                    ratio.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  This is 100% − WAPE. It is not MAPE and not an average of SKU\n                  accuracies. Missing and zero actuals do not enter the ratio.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>\n                      Judge thresholds against your own target, not a universal\n                      rule.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>100%</b><span>Perfect: no absolute error</span>\n                  </div>\n                  <div class=\"is-good\">\n                    <b>Closer to 100%</b\n                    ><span>Less error per unit of actual</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>0%</b><span>Error equals total actual volume</span>\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Below 0%</b\n                    ><span>Valid: error exceeded actual volume</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  No universal “good” cutoff exists. Check coverage before\n                  celebrating a high score, and use Bias for direction—the\n                  accuracy score cannot say over or under.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it in the planning discussion</h3>\n                    <p>\n                      Move from the aggregate score to the decisions behind it.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>\n                      Which products and months contribute most absolute error?\n                    </li>\n                    <li>\n                      Did accuracy change, or did population, mix or horizon?\n                    </li>\n                    <li>\n                      Is the miss consistently over or under (check Bias)?\n                    </li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>Are we meeting target where decisions are made?</li>\n                    <li>\n                      Which assumptions explain the largest error pockets?\n                    </li>\n                    <li>What service, inventory or waste trade-off follows?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section\n              class=\"wape-guide bias-guide\"\n              data-overview-guide=\"bias\"\n              hidden\n            >\n              <div class=\"wape-guide__formula\">\n                <strong>Formula first</strong>\n                <span>Bias =</span>\n                <span class=\"wape-guide__fraction\">\n                  <b>Σ ( Forecast − Actual )</b>\n                  <b>Σ Actual</b>\n                </span>\n                <span>× 100</span>\n                <em\n                  >Over-forecast gaps are positive; under-forecast gaps are\n                  negative, so opposite directions cancel.</em\n                >\n              </div>\n\n              <div class=\"wape-guide__layout\">\n                <article class=\"revision-guide__card wape-guide__chart-card\">\n                  <div class=\"wape-guide__card-head\">\n                    <div>\n                      <h3>Actual volume with the forecast laid over it</h3>\n                      <p>\n                        Eight high-error rows from distinct SKUs in the active\n                        pipeline. Each bracket keeps its direction before the\n                        rows are added.\n                      </p>\n                    </div>\n                    <div class=\"wape-guide__legend\" aria-label=\"Chart legend\">\n                      <span><i class=\"is-actual\"></i>Actual bar</span>\n                      <span><i class=\"is-forecast\"></i>Forecast marker</span>\n                      <span><i class=\"is-gap\"></i>Signed gap</span>\n                    </div>\n                  </div>\n                  <div class=\"wape-guide__axis\">\n                    <span>SKU · target month</span>\n                    <div>\n                      <b>0</b><b data-bias-guide-axis-quarter>—</b\n                      ><b data-bias-guide-axis-half>—</b\n                      ><b data-bias-guide-axis-three-quarter>—</b\n                      ><b data-bias-guide-axis-max>—</b>\n                    </div>\n                    <span>Forecast / actual</span>\n                  </div>\n                  <div\n                    class=\"wape-guide__lanes\"\n                    data-bias-guide-lanes\n                    role=\"img\"\n                  ></div>\n                </article>\n\n                <aside class=\"revision-guide__card wape-guide__sum-card\">\n                  <h3>\n                    Each signed bracket is<br /><strong\n                      >added to the net error</strong\n                    >\n                  </h3>\n                  <p class=\"wape-guide__primary\">\n                    KPI vintage: <b data-bias-guide-primary>—</b>\n                  </p>\n                  <div class=\"wape-guide__sum\" data-bias-guide-sum></div>\n                  <div class=\"wape-guide__shown-total\">\n                    <span>Eight shown · net</span\n                    ><b data-bias-guide-shown-error>—</b>\n                  </div>\n                  <div class=\"wape-guide__remaining-total\">\n                    <span data-bias-guide-remaining>+ remaining rows</span>\n                    <b data-bias-guide-remaining-error>—</b>\n                  </div>\n                  <div class=\"wape-guide__error-total\">\n                    <span\n                      >Σ signed error · all\n                      <b data-bias-guide-observations>—</b> rows</span\n                    >\n                    <strong data-bias-guide-total-error>—</strong>\n                  </div>\n                  <div class=\"wape-guide__division\">\n                    <span>÷</span><b data-bias-guide-total-actual>—</b\n                    ><span>× 100</span>\n                  </div>\n                  <div class=\"wape-guide__answer\">\n                    <span>Portfolio bias</span>\n                    <strong data-bias-guide-result>—</strong>\n                    <p data-bias-guide-interpretation>\n                      The sign shows whether the portfolio forecast finished\n                      above or below actual demand.\n                    </p>\n                  </div>\n                </aside>\n              </div>\n\n              <p class=\"wape-guide__note\">\n                Positive bias means over-forecast; negative bias means\n                under-forecast. Near zero can still hide large opposing errors,\n                so read Bias beside WAPE.\n              </p>\n            </section>\n\n            <section data-overview-guide=\"actual-volume\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >What is a typical month of actual demand, how much do monthly\n                  totals vary, and are any months unusually high or low?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read the line, box and whiskers</h3>\n                    <p>Every position is one month’s total on the KL scale.</p>\n                  </div>\n                </div>\n                <svg\n                  class=\"overview-guide__boxes\"\n                  viewBox=\"0 0 470 130\"\n                  role=\"img\"\n                  aria-label=\"Box plot anatomy: whiskers reach the most extreme months within one and a half interquartile ranges, the box spans the middle 50 percent of monthly totals, and the centre line is the median month.\"\n                >\n                  <g class=\"is-actual\">\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"70\"\n                      x2=\"400\"\n                      y1=\"62\"\n                      y2=\"62\"\n                    />\n                    <line class=\"box-whisker\" x1=\"70\" x2=\"70\" y1=\"52\" y2=\"72\" />\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"400\"\n                      x2=\"400\"\n                      y1=\"52\"\n                      y2=\"72\"\n                    />\n                    <rect\n                      class=\"box-body\"\n                      x=\"150\"\n                      y=\"50\"\n                      width=\"170\"\n                      height=\"24\"\n                      rx=\"2\"\n                    />\n                    <line\n                      class=\"box-median\"\n                      x1=\"235\"\n                      x2=\"235\"\n                      y1=\"46\"\n                      y2=\"78\"\n                    />\n                  </g>\n                  <text x=\"150\" y=\"36\" text-anchor=\"middle\">Q1</text>\n                  <text x=\"235\" y=\"26\" text-anchor=\"middle\">Median month</text>\n                  <text x=\"320\" y=\"36\" text-anchor=\"middle\">Q3</text>\n                  <text x=\"235\" y=\"100\" text-anchor=\"middle\">\n                    whiskers = extreme months still within 1.5 × IQR\n                  </text>\n                  <text x=\"235\" y=\"116\" text-anchor=\"middle\">\n                    box = middle 50% of months · beyond-fence months are not\n                    drawn\n                  </text>\n                </svg>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>One observation is one month</h3>\n                    <p>Products are summed before the distribution is built.</p>\n                  </div>\n                </div>\n                <div class=\"scatter-guide__build-flow\">\n                  <div>\n                    <b>1</b><span>Apply the active source and filters.</span>\n                  </div>\n                  <div>\n                    <b>2</b\n                    ><span\n                      >Sum product-level values into one total per month.</span\n                    >\n                  </div>\n                  <div>\n                    <b>3</b\n                    ><span\n                      >Keep the common parent-month cohort shared by every\n                      displayed accuracy vintage.</span\n                    >\n                  </div>\n                  <div>\n                    <b>4</b\n                    ><span>Take quartiles across those monthly totals.</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  This is not a distribution of SKUs. A small month count makes\n                  quartiles sensitive, and incomplete periods can create extreme\n                  months.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>Interpret—do not score</h3>\n                    <p>There is no universal good or bad shape.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-watch\">\n                    <b>Narrow box</b\n                    ><span>Stable demand—useful for base-load planning</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Wide box</b\n                    ><span>Variable demand—investigate the drivers</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Similar boxes</b\n                    ><span>Do not prove accuracy; compare with care</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  Matching distributions can hide per-month misses: errors\n                  cancel inside monthly totals. Use the Comparison KPIs for\n                  paired accuracy evidence.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to frame variability</h3>\n                    <p>Start with the shape, then find the months behind it.</p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>Which months sit outside the whiskers, and why?</li>\n                    <li>Does the forecast reproduce or flatten variability?</li>\n                    <li>Do results change after excluding partial periods?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>What capacity covers a typical month?</li>\n                    <li>Which events explain the spread?</li>\n                    <li>What trade-off follows from the variability?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section data-overview-guide=\"forecast-volume\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >What does a typical month’s KPI-vintage forecast total look\n                  like, and does it sit above, below or alongside actual\n                  demand?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>One shared scale, two boxes</h3>\n                    <p>\n                      Compare shift and spread directly—the axis is identical.\n                    </p>\n                  </div>\n                </div>\n                <svg\n                  class=\"overview-guide__boxes\"\n                  viewBox=\"0 0 470 150\"\n                  role=\"img\"\n                  aria-label=\"Actual and forecast monthly totals on one shared KL scale: the forecast box shifted left of the actual box means systematic under-forecasting, and a wider forecast box means extra month-to-month variability.\"\n                >\n                  <line class=\"box-axis\" x1=\"40\" x2=\"430\" y1=\"126\" y2=\"126\" />\n                  <g class=\"is-actual\">\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"80\"\n                      x2=\"380\"\n                      y1=\"44\"\n                      y2=\"44\"\n                    />\n                    <line class=\"box-whisker\" x1=\"80\" x2=\"80\" y1=\"36\" y2=\"52\" />\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"380\"\n                      x2=\"380\"\n                      y1=\"36\"\n                      y2=\"52\"\n                    />\n                    <rect\n                      class=\"box-body\"\n                      x=\"150\"\n                      y=\"32\"\n                      width=\"160\"\n                      height=\"24\"\n                      rx=\"2\"\n                    />\n                    <line\n                      class=\"box-median\"\n                      x1=\"235\"\n                      x2=\"235\"\n                      y1=\"28\"\n                      y2=\"60\"\n                    />\n                    <text x=\"66\" y=\"48\" text-anchor=\"end\">Actual</text>\n                  </g>\n                  <g class=\"is-forecast\">\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"70\"\n                      x2=\"360\"\n                      y1=\"98\"\n                      y2=\"98\"\n                    />\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"70\"\n                      x2=\"70\"\n                      y1=\"90\"\n                      y2=\"106\"\n                    />\n                    <line\n                      class=\"box-whisker\"\n                      x1=\"360\"\n                      x2=\"360\"\n                      y1=\"90\"\n                      y2=\"106\"\n                    />\n                    <rect\n                      class=\"box-body\"\n                      x=\"130\"\n                      y=\"86\"\n                      width=\"180\"\n                      height=\"24\"\n                      rx=\"2\"\n                    />\n                    <line\n                      class=\"box-median\"\n                      x1=\"215\"\n                      x2=\"215\"\n                      y1=\"82\"\n                      y2=\"114\"\n                    />\n                    <text x=\"66\" y=\"102\" text-anchor=\"end\">Forecast</text>\n                  </g>\n                  <text x=\"430\" y=\"118\" text-anchor=\"end\">same KL scale →</text>\n                  <text x=\"235\" y=\"143\" text-anchor=\"middle\">\n                    shifted median = systematic over/under · wider box = more\n                    variability\n                  </text>\n                </svg>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>Monthly totals of the KPI vintage</h3>\n                    <p>\n                      The KPI vintage is summed over the chart’s common cohort.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"scatter-guide__build-flow\">\n                  <div>\n                    <b>1</b\n                    ><span\n                      >Use the oldest displayed historical vintage when several\n                      are selected, the specific vintage when one is selected,\n                      or latest when none are selected.</span\n                    >\n                  </div>\n                  <div>\n                    <b>2</b\n                    ><span\n                      >Sum product forecasts into one total per month.</span\n                    >\n                  </div>\n                  <div>\n                    <b>3</b\n                    ><span>Keep months that also have actual volume.</span>\n                  </div>\n                  <div>\n                    <b>4</b\n                    ><span>Plot on the same KL scale as actual volume.</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  In comparison mode both sources align to one exact horizon;\n                  this card still shows only the request’s selected source.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>Compare level and spread—not accuracy</h3>\n                    <p>Similar boxes do not certify a good forecast.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-watch\">\n                    <b>Shifted median</b\n                    ><span>Systematic over- or under-forecasting</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Wider box</b\n                    ><span>Extra month-to-month variability</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Matching boxes</b\n                    ><span>Product errors can still cancel inside totals</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  These are aggregate months, not paired SKU performance.\n                  Per-product misses can offset, so use the Comparison KPIs to\n                  judge accuracy.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss forecast posture</h3>\n                    <p>\n                      Ask whether the forecast’s typical month matches the\n                      business need.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>Which months drive the forecast’s wide spread?</li>\n                    <li>Do median shifts match known bias months?</li>\n                    <li>Should outlier months be re-forecast?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>How stable is a “typical” month for planning?</li>\n                    <li>Must the business buffer the variability?</li>\n                    <li>What would a narrower spread be worth?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section class=\"wape-guide\" data-overview-guide=\"wape\" hidden>\n              <div class=\"wape-guide__formula\">\n                <strong>Formula first</strong>\n                <span>WAPE =</span>\n                <span class=\"wape-guide__fraction\">\n                  <b>Σ | Forecast − Actual |</b>\n                  <b>Σ Actual</b>\n                </span>\n                <span>× 100</span>\n                <em\n                  >Every coloured distance is positive error, whether the\n                  forecast is high or low.</em\n                >\n              </div>\n\n              <div class=\"wape-guide__layout\">\n                <article class=\"revision-guide__card wape-guide__chart-card\">\n                  <div class=\"wape-guide__card-head\">\n                    <div>\n                      <h3>Actual volume with the forecast laid over it</h3>\n                      <p>\n                        Eight high-error rows from distinct SKUs in the active\n                        pipeline. SKUs are the y-axis; every row uses one KL\n                        scale.\n                      </p>\n                    </div>\n                    <div class=\"wape-guide__legend\" aria-label=\"Chart legend\">\n                      <span><i class=\"is-actual\"></i>Actual bar</span>\n                      <span><i class=\"is-forecast\"></i>Forecast marker</span>\n                      <span><i class=\"is-gap\"></i>Absolute gap</span>\n                    </div>\n                  </div>\n                  <div class=\"wape-guide__axis\">\n                    <span>SKU · target month</span>\n                    <div>\n                      <b>0</b><b data-wape-guide-axis-quarter>—</b\n                      ><b data-wape-guide-axis-half>—</b\n                      ><b data-wape-guide-axis-three-quarter>—</b\n                      ><b data-wape-guide-axis-max>—</b>\n                    </div>\n                    <span>Forecast / actual</span>\n                  </div>\n                  <div\n                    class=\"wape-guide__lanes\"\n                    data-wape-guide-lanes\n                    role=\"img\"\n                  ></div>\n                </article>\n\n                <aside class=\"revision-guide__card wape-guide__sum-card\">\n                  <h3>\n                    Each bracket is<br /><strong\n                      >added to the error total</strong\n                    >\n                  </h3>\n                  <p class=\"wape-guide__primary\">\n                    KPI vintage: <b data-wape-guide-primary>—</b>\n                  </p>\n                  <div class=\"wape-guide__sum\" data-wape-guide-sum></div>\n                  <div class=\"wape-guide__shown-total\">\n                    <span>Eight shown</span><b data-wape-guide-shown-error>—</b>\n                  </div>\n                  <div class=\"wape-guide__remaining-total\">\n                    <span data-wape-guide-remaining>+ remaining rows</span>\n                    <b data-wape-guide-remaining-error>—</b>\n                  </div>\n                  <div class=\"wape-guide__error-total\">\n                    <span\n                      >Σ absolute error · all\n                      <b data-wape-guide-observations>—</b> rows</span\n                    >\n                    <strong data-wape-guide-total-error>—</strong>\n                  </div>\n                  <div class=\"wape-guide__division\">\n                    <span>÷</span><b data-wape-guide-total-actual>—</b\n                    ><span>× 100</span>\n                  </div>\n                  <div class=\"wape-guide__answer\">\n                    <span>Portfolio WAPE</span>\n                    <strong data-wape-guide-result>—</strong>\n                    <p>\n                      For every 100 KL actually sold, this is the KL missed by\n                      the KPI forecast.\n                    </p>\n                  </div>\n                </aside>\n              </div>\n\n              <p class=\"wape-guide__note\">\n                Eligible rows have a positive actual and a forecast for every\n                displayed vintage. Over- and under-forecasts both enter the\n                numerator positively; lower is better.\n              </p>\n            </section>\n\n            <section data-overview-guide=\"effectiveness\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >Within the accuracy chart’s common cohort, how often did a\n                  material move from the KPI vintage to latest improve the\n                  forecast?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read it as a hit rate</h3>\n                    <p>\n                      Every materially revised pair gets one vote, any volume.\n                    </p>\n                  </div>\n                </div>\n                <div\n                  class=\"comparison-kpi-guide__hit-rate\"\n                  aria-label=\"Example hit rate with six improved revisions and four revisions that did not improve\"\n                >\n                  <i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-good\"></i><i class=\"is-good\"></i\n                  ><i class=\"is-bad\"></i><i class=\"is-bad\"></i\n                  ><i class=\"is-bad\"></i><i class=\"is-bad\"></i>\n                </div>\n                <div\n                  class=\"comparison-kpi-guide__dot-legend\"\n                  aria-hidden=\"true\"\n                >\n                  <span><i class=\"is-good\"></i>improved</span>\n                  <span><i class=\"is-bad\"></i>did not improve</span>\n                </div>\n                <div class=\"comparison-kpi-guide__example\">\n                  <b>Example · 60%</b\n                  ><span\n                    >6 of 10 material revisions improved accuracy. It does not\n                    mean error fell by 60%.</span\n                  >\n                </div>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>Count what qualifies</h3>\n                    <p>\n                      Start from common-cohort pairs with positive actual\n                      demand.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>Improved revised pairs</span><b>÷</b\n                  ><span>All materially revised pairs</span><b>× 100</b>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>Improved:</b> error improvement above the\n                    tolerance.</span\n                  >\n                  <span><b>Worsened:</b> materially farther from actual.</span>\n                  <span\n                    ><b>Neutral:</b> moved but barely changed—still counted\n                    below the line.</span\n                  >\n                  <span><b>Unchanged:</b> excluded entirely.</span>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  Count-based, not volume-weighted. With no materially revised\n                  pairs the KPI is undefined—not zero.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>Frequency here; magnitude lives in the other cards.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Above 50%</b><span>Most material revisions helped</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Around 50%</b><span>Mixed process—inspect where</span>\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Below 50%</b\n                    ><span>More revisions failed than helped</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>N/A</b><span>No materially revised pairs—not 0%</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  A high hit rate can hide tiny gains; a low one can coexist\n                  with large net improvement. On the Comparison tab, read beside\n                  accuracy delta and KL error improvement.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss process reliability</h3>\n                    <p>\n                      Ask why revision decisions succeed or fail repeatedly.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>Which revision types hold the strongest hit rate?</li>\n                    <li>Are failures concentrated by horizon or product?</li>\n                    <li>Which checks prevent avoidable harmful moves?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>Which inputs consistently improve the forecast?</li>\n                    <li>Where do assumption changes add noise?</li>\n                    <li>What evidence is required before a late override?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section\n              class=\"error-accumulated-guide\"\n              data-overview-guide=\"error-accumulated\"\n              hidden\n            >\n              <article class=\"error-accumulated-guide__chart-card\">\n                <div class=\"error-accumulated-guide__card-head\">\n                  <div>\n                    <h3>First, measure the gap each month</h3>\n                    <p>\n                      Simple one-product example. Labels show the size of each\n                      shaded miss.\n                    </p>\n                  </div>\n                  <div\n                    class=\"error-accumulated-guide__legend\"\n                    aria-label=\"Chart legend\"\n                  >\n                    <span><i class=\"is-actual\"></i>Actual</span>\n                    <span><i class=\"is-forecast\"></i>Forecast</span>\n                    <span><i class=\"is-over\"></i>Over</span>\n                    <span><i class=\"is-under\"></i>Under</span>\n                  </div>\n                </div>\n                <svg\n                  class=\"error-accumulated-guide__chart\"\n                  viewBox=\"0 0 850 300\"\n                  role=\"img\"\n                  aria-label=\"Actual and forecast lines with shaded monthly forecast errors\"\n                >\n                  <g class=\"error-accumulated-guide__grid\">\n                    <line x1=\"58\" y1=\"50\" x2=\"790\" y2=\"50\" />\n                    <line x1=\"58\" y1=\"100\" x2=\"790\" y2=\"100\" />\n                    <line x1=\"58\" y1=\"150\" x2=\"790\" y2=\"150\" />\n                    <line x1=\"58\" y1=\"200\" x2=\"790\" y2=\"200\" />\n                    <line x1=\"58\" y1=\"250\" x2=\"790\" y2=\"250\" />\n                  </g>\n                  <g class=\"error-accumulated-guide__axis-labels\">\n                    <text x=\"15\" y=\"54\">High</text>\n                    <text x=\"18\" y=\"254\">Low</text>\n                    <text x=\"15\" y=\"155\" transform=\"rotate(-90 15 155)\">\n                      Volume\n                    </text>\n                  </g>\n                  <g\n                    aria-label=\"Continuous shaded space between forecast and actual\"\n                  >\n                    <path class=\"is-under\" d=\"M120 170 L189 157 L120 215 Z\" />\n                    <path\n                      class=\"is-over\"\n                      d=\"M189 157 L250 145 L330 159 L250 105 Z\"\n                    />\n                    <path\n                      class=\"is-under\"\n                      d=\"M330 159 L380 168 L426 151 L380 193 Z\"\n                    />\n                    <path\n                      class=\"is-over\"\n                      d=\"M426 151 L510 121 L595 142 L510 76 Z\"\n                    />\n                    <path\n                      class=\"is-under\"\n                      d=\"M595 142 L640 153 L770 106 L770 138 L640 177 Z\"\n                    />\n                  </g>\n                  <g class=\"error-accumulated-guide__gap-labels\">\n                    <text class=\"is-under\" x=\"120\" y=\"159\">10 KL under</text>\n                    <text class=\"is-over\" x=\"250\" y=\"94\">15 KL over</text>\n                    <text class=\"is-under\" x=\"380\" y=\"157\">5 KL under</text>\n                    <text class=\"is-over\" x=\"510\" y=\"65\">20 KL over</text>\n                    <text class=\"is-under\" x=\"640\" y=\"142\">5 KL under</text>\n                    <text class=\"is-under\" x=\"770\" y=\"95\">8 KL under</text>\n                  </g>\n                  <polyline\n                    class=\"error-accumulated-guide__actual-line\"\n                    points=\"120,170 250,145 380,168 510,121 640,153 770,106\"\n                  />\n                  <polyline\n                    class=\"error-accumulated-guide__forecast-line\"\n                    points=\"120,215 250,105 380,193 510,76 640,177 770,138\"\n                  />\n                  <g class=\"error-accumulated-guide__actual-points\">\n                    <circle cx=\"120\" cy=\"170\" r=\"6\" />\n                    <circle cx=\"250\" cy=\"145\" r=\"6\" />\n                    <circle cx=\"380\" cy=\"168\" r=\"6\" />\n                    <circle cx=\"510\" cy=\"121\" r=\"6\" />\n                    <circle cx=\"640\" cy=\"153\" r=\"6\" />\n                    <circle cx=\"770\" cy=\"106\" r=\"6\" />\n                  </g>\n                  <g class=\"error-accumulated-guide__forecast-points\">\n                    <circle cx=\"120\" cy=\"215\" r=\"6\" />\n                    <circle cx=\"250\" cy=\"105\" r=\"6\" />\n                    <circle cx=\"380\" cy=\"193\" r=\"6\" />\n                    <circle cx=\"510\" cy=\"76\" r=\"6\" />\n                    <circle cx=\"640\" cy=\"177\" r=\"6\" />\n                    <circle cx=\"770\" cy=\"138\" r=\"6\" />\n                  </g>\n                  <text\n                    class=\"error-accumulated-guide__line-label is-actual\"\n                    x=\"793\"\n                    y=\"107\"\n                  >\n                    Actual\n                  </text>\n                  <text\n                    class=\"error-accumulated-guide__line-label is-forecast\"\n                    x=\"793\"\n                    y=\"141\"\n                  >\n                    Forecast\n                  </text>\n                  <g class=\"error-accumulated-guide__month-labels\">\n                    <text x=\"120\" y=\"280\">May</text>\n                    <text x=\"250\" y=\"280\">Jun</text>\n                    <text x=\"380\" y=\"280\">Jul</text>\n                    <text x=\"510\" y=\"280\">Aug</text>\n                    <text x=\"640\" y=\"280\">Sep</text>\n                    <text x=\"770\" y=\"280\">Oct</text>\n                  </g>\n                </svg>\n                <div\n                  class=\"error-accumulated-guide__example-equation\"\n                  aria-label=\"Example errors added into a total\"\n                >\n                  <span class=\"is-under\">10</span><b>+</b>\n                  <span class=\"is-over\">15</span><b>+</b>\n                  <span class=\"is-under\">5</span><b>+</b>\n                  <span class=\"is-over\">20</span><b>+</b>\n                  <span class=\"is-under\">5</span><b>+</b>\n                  <span class=\"is-under\">8</span><b>=</b>\n                  <strong>63 KL total error</strong>\n                </div>\n              </article>\n\n              <aside class=\"error-accumulated-guide__rule-card\">\n                <div class=\"error-accumulated-guide__rule-top\">\n                  <p class=\"eyebrow\">The whole rule</p>\n                  <h3>\n                    Measure every gap.\n                    <strong>Ignore the direction.</strong>\n                    Add the sizes.\n                  </h3>\n                </div>\n                <div class=\"error-accumulated-guide__rule-steps\">\n                  <div>\n                    <b>1</b>\n                    <p>\n                      <strong>Find the shaded space</strong>\n                      <span\n                        >The vertical distance between forecast and\n                        actual.</span\n                      >\n                    </p>\n                  </div>\n                  <div>\n                    <b>2</b>\n                    <p>\n                      <strong>Turn every gap positive</strong>\n                      <span\n                        >10 under counts as 10. Fifteen over counts as 15.</span\n                      >\n                    </p>\n                  </div>\n                  <div>\n                    <b>3</b>\n                    <p>\n                      <strong>Add every product and month</strong>\n                      <span>The resulting pile is accumulated error.</span>\n                    </p>\n                  </div>\n                </div>\n                <p class=\"error-accumulated-guide__no-cancel\">\n                  <strong>Important:</strong> over and under misses do not\n                  cancel. Both increase accumulated error.\n                </p>\n              </aside>\n\n              <section class=\"error-accumulated-guide__rollup\">\n                <div class=\"error-accumulated-guide__rollup-months\">\n                  <div class=\"error-accumulated-guide__rollup-title\">\n                    <h3>\n                      Then repeat that calculation across the dashboard’s\n                      <span data-error-accumulated-month-count>months</span>\n                    </h3>\n                    <span>Monthly absolute errors · KL</span>\n                  </div>\n                  <div\n                    class=\"error-accumulated-guide__month-errors\"\n                    data-error-accumulated-months\n                    aria-label=\"Monthly absolute error totals\"\n                  ></div>\n                </div>\n                <div\n                  class=\"error-accumulated-guide__result\"\n                  aria-label=\"Accumulated error comparison\"\n                >\n                  <div class=\"is-primary\">\n                    <strong data-error-accumulated-primary>—</strong>\n                    <span data-error-accumulated-primary-label\n                      >selected forecast</span\n                    >\n                  </div>\n                  <b>−</b>\n                  <div>\n                    <strong data-error-accumulated-latest>—</strong>\n                    <span>latest forecast</span>\n                  </div>\n                  <b>=</b>\n                  <div class=\"is-extra\" data-error-accumulated-extra-box>\n                    <strong data-error-accumulated-extra>—</strong>\n                    <span>extra error</span>\n                  </div>\n                </div>\n              </section>\n            </section>\n\n            <section data-overview-guide=\"accuracy-chart\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >Did waiting for newer forecasts improve accuracy, and is the\n                  KPI vintage systematically too high or too low?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Two stacked zones</h3>\n                    <p>Accuracy lines on top; signed bias bars below.</p>\n                  </div>\n                </div>\n                <svg\n                  class=\"overview-guide__micro\"\n                  viewBox=\"0 0 470 210\"\n                  role=\"img\"\n                  aria-label=\"Miniature accuracy chart: coloured historical vintage lines and a fixed teal latest line above, with amber over-bias and blue under-bias bars around a dashed zero line below.\"\n                >\n                  <g class=\"grid\">\n                    <line x1=\"40\" x2=\"440\" y1=\"20\" y2=\"20\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"45\" y2=\"45\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"70\" y2=\"70\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"95\" y2=\"95\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"120\" y2=\"120\" />\n                  </g>\n                  <path\n                    class=\"line-old\"\n                    d=\"M50 96 C 120 88, 200 78, 280 72 S 400 62, 430 58\"\n                  />\n                  <path\n                    class=\"line-mid\"\n                    d=\"M50 88 C 130 84, 210 74, 290 68 S 400 56, 430 50\"\n                  />\n                  <path\n                    class=\"line-fixed\"\n                    d=\"M50 80 C 140 74, 220 66, 300 60 S 400 48, 430 42\"\n                  />\n                  <text x=\"446\" y=\"32\" text-anchor=\"end\" class=\"is-teal\">\n                    latest · fixed\n                  </text>\n                  <text x=\"446\" y=\"80\" text-anchor=\"end\">\n                    selected vintages\n                  </text>\n                  <text x=\"235\" y=\"10\" text-anchor=\"middle\">\n                    read the gap between lines—not their height\n                  </text>\n                  <line class=\"bias-zero\" x1=\"40\" x2=\"440\" y1=\"165\" y2=\"165\" />\n                  <rect\n                    class=\"bias-bar--over\"\n                    x=\"60\"\n                    y=\"147\"\n                    width=\"12\"\n                    height=\"18\"\n                    rx=\"1\"\n                  />\n                  <rect\n                    class=\"bias-bar--under\"\n                    x=\"120\"\n                    y=\"165\"\n                    width=\"12\"\n                    height=\"14\"\n                    rx=\"1\"\n                  />\n                  <rect\n                    class=\"bias-bar--over\"\n                    x=\"180\"\n                    y=\"152\"\n                    width=\"12\"\n                    height=\"13\"\n                    rx=\"1\"\n                  />\n                  <rect\n                    class=\"bias-bar--under\"\n                    x=\"240\"\n                    y=\"165\"\n                    width=\"12\"\n                    height=\"20\"\n                    rx=\"1\"\n                  />\n                  <rect\n                    class=\"bias-bar--over\"\n                    x=\"300\"\n                    y=\"150\"\n                    width=\"12\"\n                    height=\"15\"\n                    rx=\"1\"\n                  />\n                  <rect\n                    class=\"bias-bar--under\"\n                    x=\"360\"\n                    y=\"165\"\n                    width=\"12\"\n                    height=\"10\"\n                    rx=\"1\"\n                  />\n                  <text x=\"66\" y=\"141\" text-anchor=\"middle\">over</text>\n                  <text x=\"126\" y=\"192\" text-anchor=\"middle\">under</text>\n                  <text x=\"235\" y=\"205\" text-anchor=\"middle\">\n                    amber bars lean over actual · blue bars lean under\n                  </text>\n                </svg>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>One shared cohort, recomputed</h3>\n                    <p>\n                      Every selected vintage must exist for a parent to count.\n                    </p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__equation\">\n                  <span>FA% = 100 × (1 − Σ|forecast − actual| ÷ Σ actual)</span>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>1.</b> Keep parents with positive actual volume.</span\n                  >\n                  <span\n                    ><b>2.</b> Keep a parent only if every selected vintage and\n                    the latest (M1) forecast exist.</span\n                  >\n                  <span\n                    ><b>3.</b> Bias uses the KPI vintage on this same cohort:\n                    oldest selected, or latest M1 when none are selected.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  Accuracy lines, bias bars and KPI cards share one cohort.\n                  Selecting vintages can change that cohort and the bias bars.\n                  Deselecting the oldest promotes the next oldest selection.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>Consistent gaps beat lucky months.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Good</b\n                    ><span\n                      >Historical lines sit below the teal line; bias bars stay\n                      small</span\n                    >\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Watch</b\n                    ><span\n                      >Lines crossing or converging—waiting buys nothing</span\n                    >\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Bad</b\n                    ><span>One-sided amber or blue bias runs for months</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  The y-axis zooms to the data. Check the tooltip’s “common\n                  cohort” before trusting a small-month swing.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to time the signal</h3>\n                    <p>\n                      Ask how much accuracy each extra month of waiting buys.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>Which months show the biggest vintage accuracy gap?</li>\n                    <li>Do 2–4-month-ahead forecasts already match latest?</li>\n                    <li>Which months had the smallest cohort, and why?</li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>\n                      Is the KPI vintage over or under (amber/blue) in decision\n                      months?\n                    </li>\n                    <li>What did systematic bias cost in service or waste?</li>\n                    <li>Which decision changes with one month’s notice?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n\n            <section data-overview-guide=\"volume-chart\" hidden>\n              <div class=\"comparison-kpi-guide__definition\">\n                <strong>The question it answers</strong>\n                <span\n                  >Were selected historical forecasts aligned with actual\n                  demand, and did latest M1 move the aggregate forecast\n                  closer?</span\n                >\n              </div>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__visual-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>01</span>\n                  <div>\n                    <h3>Read every selected line</h3>\n                    <p>\n                      All selected vintages, latest M1 and actual share one\n                      cohort.\n                    </p>\n                  </div>\n                </div>\n                <svg\n                  class=\"overview-guide__micro\"\n                  viewBox=\"0 0 470 190\"\n                  role=\"img\"\n                  aria-label=\"Illustrative volume comparison: navy actual, dashed historical A and latest B. The live chart shows every selected historical vintage with colors matching the accuracy chart.\"\n                >\n                  <g class=\"grid\">\n                    <line x1=\"40\" x2=\"440\" y1=\"20\" y2=\"20\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"60\" y2=\"60\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"100\" y2=\"100\" />\n                    <line x1=\"40\" x2=\"440\" y1=\"140\" y2=\"140\" />\n                  </g>\n                  <text x=\"44\" y=\"14\">4,500 KL</text>\n                  <text x=\"44\" y=\"156\">1,600 KL</text>\n                  <path\n                    class=\"line-actual\"\n                    d=\"M60 92 C 130 84, 210 76, 290 70 S 400 58, 430 54\"\n                  />\n                  <path\n                    class=\"line-vintage-a\"\n                    d=\"M60 118 C 130 108, 210 100, 290 88 S 400 70, 430 64\"\n                  />\n                  <path\n                    class=\"line-vintage-b\"\n                    d=\"M60 106 C 130 98, 210 88, 290 78 S 400 62, 430 58\"\n                  />\n                  <text x=\"446\" y=\"56\" text-anchor=\"end\">actual</text>\n                  <text x=\"446\" y=\"70\" text-anchor=\"end\">B</text>\n                  <text x=\"446\" y=\"84\" text-anchor=\"end\">A</text>\n                  <text x=\"235\" y=\"170\" text-anchor=\"middle\">\n                    smaller gap to actual = closer aggregate alignment for that\n                    month\n                  </text>\n                  <text x=\"235\" y=\"184\" text-anchor=\"middle\">\n                    example: A = historical · B = latest M1 · navy = actual\n                  </text>\n                </svg>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__formula-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>02</span>\n                  <div>\n                    <h3>Separate revision from outcome</h3>\n                    <p>First how the forecast moved; then whether it helped.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__steps\">\n                  <span\n                    ><b>B − A</b> is the revision: how much the forecast\n                    moved.</span\n                  >\n                  <span\n                    ><b>B − actual</b> is the signed gap shown in the\n                    tooltip.</span\n                  >\n                  <span\n                    ><b>Compare</b> |A − actual| with |B − actual| to judge\n                    whether the revision helped.</span\n                  >\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  A means a selected historical vintage; B means fixed latest\n                  M1. Hover or focus a month for every selected forecast, actual\n                  and latest − actual. Colors match the accuracy chart and\n                  selector.\n                </p>\n              </article>\n              <article\n                class=\"revision-guide__card comparison-kpi-guide__interpret-card\"\n              >\n                <div class=\"revision-guide__card-head\">\n                  <span>03</span>\n                  <div>\n                    <h3>What good and bad look like</h3>\n                    <p>Judge B against A, not against perfection.</p>\n                  </div>\n                </div>\n                <div class=\"comparison-kpi-guide__bands\">\n                  <div class=\"is-good\">\n                    <b>Good</b><span>B sits closer to actual than A</span>\n                  </div>\n                  <div class=\"is-watch\">\n                    <b>Watch</b\n                    ><span>Lines cross, or both gaps stay large</span>\n                  </div>\n                  <div class=\"is-bad\">\n                    <b>Bad</b><span>B sits farther from actual than A</span>\n                  </div>\n                </div>\n                <p class=\"comparison-kpi-guide__caution\">\n                  The 1,600–4,500 KL scale is fixed and clips out-of-range\n                  values—the tooltip keeps exact numbers. Aggregate closeness\n                  can hide offsetting product errors.\n                </p>\n              </article>\n              <section\n                class=\"revision-guide__discussion comparison-kpi-guide__discussion\"\n              >\n                <div class=\"revision-guide__discussion-intro\">\n                  <span>04</span>\n                  <div>\n                    <h3>Use it to discuss demand alignment</h3>\n                    <p>\n                      Find the months worth investigating, then open the\n                      evidence.\n                    </p>\n                  </div>\n                </div>\n                <div>\n                  <strong>With the forecasting team</strong>\n                  <ul>\n                    <li>\n                      Which months show B moving toward or away from actual?\n                    </li>\n                    <li>Which products created the largest A-to-B movement?</li>\n                    <li>\n                      Did the revision use better evidence, or just shift\n                      volume?\n                    </li>\n                  </ul>\n                </div>\n                <div>\n                  <strong>With the business team</strong>\n                  <ul>\n                    <li>Which demand event explains the gap?</li>\n                    <li>Did revised volume arrive in time to act on?</li>\n                    <li>Are alignment gains hiding mix risk?</li>\n                  </ul>\n                </div>\n              </section>\n            </section>\n          </div>\n\n          <footer class=\"revision-effectiveness-guide-dialog__foot\">\n            <span\n              ><b>Population:</b> active source, filters and vintage rules</span\n            >\n            <span\n              ><b>Tip:</b> the ? button is available on every KPI and\n              chart</span\n            >\n            <span\n              ><b>Best practice:</b> read accuracy, bias and volume\n              together</span\n            >\n          </footer>\n        </section>\n      </div>\n\n      <footer class=\"statusbar\">\n        <span class=\"statusbar__seg\"\n          ><i class=\"lamp lamp--live\" aria-hidden=\"true\"></i\n          ><span data-status>Loading canonical dataset</span></span\n        ><span class=\"statusbar__seg\" data-status-population></span\n        ><span\n          class=\"statusbar__seg statusbar__seg--mono\"\n          data-status-source\n        ></span\n        ><span class=\"statusbar__seg statusbar__seg--right\"\n          >metrics computed by forecast_analysis</span\n        >\n      </footer>\n    </div>\n\n    <div class=\"loading\" role=\"status\" aria-live=\"polite\">\n      <span class=\"loading__spinner\" aria-hidden=\"true\"></span\n      ><strong>Computing active population</strong>\n    </div>\n    <div\n      class=\"toast\"\n      role=\"status\"\n      aria-live=\"polite\"\n      aria-atomic=\"true\"\n    ></div>\n    <script src=\"timeline.js\"></script>\n    <script src=\"filter-multiselect.js\"></script>\n    <script src=\"app.js\"></script>\n  </body>\n</html>\n"
          },
