__item rect {\n  fill: rgba(46, 121, 165, 0.19);\n}\n.chart__axis-year {\n  fill: var(--faint-2);\n  font-size: 10.8px;\n}\n.chart--overview .chart__labels text,\n.chart--overview-volume .chart__labels text {\n  font-size: 12px;\n}\n.chart--overview .chart__data-labels text {\n  font-size: 14.25px;\n}\n.chart__points circle {\n  fill: var(--panel);\n  stroke: var(--series, var(--teal));\n  stroke-width: 3;\n}\n.chart__points circle:focus {\n  outline: none;\n  stroke-width: 5;\n}\n.chart__points--amber circle {\n  stroke: var(--amber);\n}\n.has-chart-dialog {\n  overflow: hidden;\n}\n.chart-dialog {\n  position: fixed;\n  inset: 0;\n  z-index: 50;\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr);\n  padding: 18px 22px 22px;\n  background: var(--panel);\n}\n.chart-dialog__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--hairline);\n}\n.chart-dialog__head h2 {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  font: 600 21px / 1.15 var(--display);\n}\n.chart-guide-trigger--dialog {\n  width: 22px;\n  height: 22px;\n  font-size: 11px;\n}\n.chart-dialog__actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.chart-dialog__legend {\n  justify-self: end;\n  padding: 10px 0;\n}\n.chart-dialog__body {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background-image: repeating-linear-gradient(\n    45deg,\n    rgba(23, 36, 33, 0.025) 0 1px,\n    transparent 1px 11px\n  );\n  border: 1px solid var(--hairline);\n  border-radius: 8px;\n}\n.chart-dialog__body .chart {\n  width: 100%;\n  height: 100%;\n  padding: 18px 24px;\n}\n.chart-dialog[data-chart-kind=\"revision-paired\"] .chart-dialog__legend:empty {\n  display: none;\n}\n.chart-dialog[data-chart-kind=\"revision-paired\"] .chart-dialog__body {\n  display: grid;\n}\n.chart-dialog-pair {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  min-width: 0;\n  min-height: 0;\n  padding: 10px;\n}\n.chart-dialog-pair__panel {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--panel);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 6px;\n}\n.chart-dialog-pair__panel > h3 {\n  margin: 0;\n  padding: 8px 10px;\n  color: var(--muted);\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 600 9px / 1.2 var(--mono);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.chart-dialog-pair__chart {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n.chart-dialog-pair__chart > * {\n  height: 100%;\n}\n.chart-dialog[data-chart-kind=\"revision-paired\"] .chart--revision-history,\n.chart-dialog[data-chart-kind=\"revision-paired\"] .chart--revision-scatter {\n  min-height: 0;\n  padding: 12px 14px 4px;\n}\n.chart-dialog[data-chart-kind=\"revision-paired\"] .revision-history__legend,\n.chart-dialog[data-chart-kind=\"revision-paired\"] .revision-scatter__legend {\n  padding: 7px 9px;\n  font-size: 8px;\n}\n.chart-dialog[data-chart-kind=\"revision-paired\"] .scatter-toolbar {\n  padding: 6px 8px;\n}\n.chart-dialog__body .chart--overview .chart__smooth-line,\n.chart-dialog__body .chart--overview-volume .chart__smooth-line {\n  stroke-width: 3.8;\n}\n.chart-dialog__body .chart__series--actual {\n  stroke-width: 3.4px;\n}\n.chart-dialog__body .chart--overview .chart__data-labels text {\n  font-size: 10.5px;\n}\n.chart-dialog__body .bias-strip__bar text {\n  font-size: 9.5px;\n}\n.chart-dialog__body .chart--overview .chart__labels text,\n.chart-dialog__body .chart--overview-volume .chart__labels text {\n  font-size: 10px;\n}\n.chart-dialog__body .chart__axis-year,\n.chart-dialog__body .chart__grid--volume text {\n  font-size: 9px;\n}\n.chart-dialog__body .chart .chart__axis-unit,\n.chart-dialog__body .chart .chart__section-label {\n  font-size: 9px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .chart-dialog__legend:empty {\n  display: none;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .chart-dialog__body {\n  display: grid;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .revision-scatter {\n  height: 100%;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .chart--revision-scatter {\n  min-height: 0;\n  padding: 18px 28px 4px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .scatter__grid text {\n  font-size: 10px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .scatter__quadrant {\n  font-size: 9px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .scatter__axis-title {\n  font-size: 10px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .revision-scatter__legend {\n  padding: 10px 12px 14px;\n  font-size: 12px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-toolbar {\n  padding: 8px 12px;\n}\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-control,\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-toolbar__label,\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-toolbar__zoom,\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-toolbar__filter,\n.chart-dialog[data-chart-kind=\"revision\"] .scatter-toolbar__filter select {\n  font-size: 9px;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .chart-dialog__legend:empty {\n  display: none;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .chart-dialog__body {\n  display: grid;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .revision-history-chart {\n  min-height: 0;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .chart--revision-history {\n  min-height: 0;\n  padding: 24px 34px 8px;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .revision-history__grid text,\n.chart-dialog[data-chart-kind=\"revision-history\"] .revision-history__month,\n.chart-dialog[data-chart-kind=\"revision-history\"]\n  .revision-history__axis-title {\n  font-size: 11px;\n}\n.chart-dialog[data-chart-kind=\"revision-history\"] .revision-history__legend {\n  padding: 10px 14px 14px;\n  font-size: 10px;\n}\n.chart-dialog > .scope-drawer {\n  top: 68px;\n  right: 22px;\n  left: 22px;\n  z-index: 2;\n}\n.chart-tooltip {\n  position: fixed;\n  z-index: 60;\n  width: min(250px, calc(100vw - 20px));\n  padding: 11px 12px;\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n  background: var(--panel);\n  box-shadow: 0 10px 30px rgba(20, 35, 31, 0.16);\n  color: var(--text);\n  font: 12px var(--body);\n  pointer-events: none;\n}\n.chart-tooltip[hidden] {\n  display: none;\n}\n.chart-tooltip--revision {\n  width: min(340px, calc(100vw - 20px));\n  padding: 13px 14px;\n}\n.chart-tooltip__head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n.chart-tooltip__head strong {\n  font-size: 12px;\n}\n.chart-tooltip__head span {\n  padding: 2px 6px;\n  border-radius: 3px;\n  background: var(--panel-2);\n  color: var(--faint);\n  font: 600 10px var(--mono);\n}\n.chart-tooltip p {\n  margin: 3px 0 9px;\n  color: var(--faint);\n  font: 10px var(--mono);\n}\n.chart-tooltip__description {\n  margin-top: 5px;\n  color: var(--text);\n  font: 500 11px / 1.3 var(--body);\n}\n.chart-tooltip__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin: 0 0 10px;\n}\n.chart-tooltip__meta span {\n  padding: 2px 5px;\n  color: var(--faint);\n  background: var(--panel-2);\n  border-radius: 3px;\n  font: 500 9px / 1.2 var(--mono);\n}\n.chart-tooltip dl {\n  display: grid;\n  gap: 4px;\n  margin: 0;\n}\n.chart-tooltip dl div {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n}\n.chart-tooltip dt {\n  color: var(--faint);\n}\n.chart-tooltip dd {\n  margin: 0;\n  font-family: var(--mono);\n  font-weight: 600;\n  text-align: right;\n}\n.chart-tooltip dd small {\n  display: block;\n  margin-top: 1px;\n  color: var(--faint);\n  font-size: 8px;\n  font-weight: 400;\n}\n.chart-tooltip__result {\n  margin-top: 3px;\n  padding-top: 6px;\n  border-top: 1px solid var(--hairline-soft);\n}\n.chart-tooltip__over {\n  color: var(--amber);\n}\n.chart-tooltip__under {\n  color: var(--blue);\n}\n.volume-bars rect {\n  fill: rgba(46, 121, 165, 0.14);\n}\n.chart__callout rect {\n  fill: var(--panel);\n  stroke: var(--teal-dim);\n}\n.chart__callout text {\n  fill: var(--text);\n  font-weight: 600;\n}\n.diagonal {\n  stroke: var(--faint-2);\n  stroke-dasharray: 5 5;\n  stroke-width: 1.5;\n}\n.zero-line {\n  stroke: var(--blue);\n  stroke-dasharray: 5 4;\n  stroke-width: 1.5;\n}\n.actual-line {\n  stroke: var(--blue);\n  stroke-dasharray: 7 4;\n  stroke-width: 2;\n}\n.scatter circle {\n  fill: rgba(8, 127, 117, 0.6);\n  stroke: var(--panel);\n  stroke-width: 1.5;\n}\n.scatter .scatter--warn {\n  fill: rgba(182, 59, 53, 0.68);\n}\n.chart--revision-scatter {\n  min-width: 0;\n  max-width: 100%;\n  min-height: 300px;\n  padding: 2px 4px 0;\n  cursor: grab;\n  touch-action: none;\n  user-select: none;\n}\n.chart--revision-scatter.is-dragging {\n  cursor: grabbing;\n}\n.scatter__grid text {\n  fill: var(--faint-2);\n  font-size: 11px;\n  font-weight: 500;\n}\n.scatter__grid text[text-anchor=\"end\"] {\n  text-anchor: end;\n}\n.scatter__tolerance {\n  fill: rgba(46, 121, 165, 0.065);\n  pointer-events: none;\n}\n.chart .scatter__quadrant {\n  fill: var(--faint-2);\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.055em;\n  opacity: 0.78;\n  pointer-events: none;\n  text-transform: uppercase;\n}\n.chart .scatter__axis-title {\n  fill: var(--muted);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.025em;\n}\n.scatter .scatter__point {\n  fill: rgba(8, 127, 117, 0.42);\n  cursor: pointer;\n  stroke: rgba(255, 255, 255, 0.92);\n  stroke-width: 1.15;\n  transition:\n    r 0.16s var(--ease),\n    stroke-width 0.12s var(--ease),\n    opacity 0.12s var(--ease);\n}\n.scatter .scatter--worsened {\n  fill: rgba(182, 59, 53, 0.48);\n}\n.scatter .scatter--neutral,\n.scatter .scatter--unchanged {\n  fill: rgba(83, 103, 98, 0.36);\n}\n.scatter .scatter__point--top-volume {\n  stroke: rgba(23, 36, 33, 0.72);\n  stroke-width: 1.65;\n}\n.scatter .scatter__point--context {\n  opacity: 0.16;\n  stroke-opacity: 0.38;\n}\n.scatter .scatter__point--selected {\n  opacity: 1;\n  filter: drop-shadow(0 0 2px rgba(16, 32, 28, 0.34));\n  stroke: #10201c;\n  stroke-width: 2.8;\n}\n.scatter .scatter__point:hover,\n.scatter .scatter__point:focus {\n  outline: none;\n  opacity: 1;\n  stroke: var(--text);\n  stroke-width: 2.5;\n}\n.revision-scatter {\n  display: grid;\n  width: 100%;\n  max-width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  background: #fbfdfc;\n}\n.scatter-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  min-width: 0;\n  padding: 5px 7px;\n  overflow-x: auto;\n  background: var(--panel);\n  border-bottom: 1px solid var(--hairline-soft);\n  scrollbar-width: thin;\n}\n.scatter-toolbar__label {\n  flex: 0 0 auto;\n  color: var(--faint);\n  font: 500 7.5px / 1.2 var(--mono);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.scatter-toolbar__zoom select {\n  min-width: 64px;\n}\n.scatter-toolbar__filter {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 4px;\n  padding-left: 3px;\n  color: var(--faint);\n  font: 500 7.5px / 1.2 var(--mono);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.scatter-toolbar__filter select {\n  min-width: 74px;\n  height: 23px;\n  padding: 2px 20px 2px 6px;\n  color: var(--text);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  font: 500 8px / 1.15 var(--mono);\n  text-transform: none;\n}\n.scatter-toolbar__spacer {\n  flex: 1 1 auto;\n  min-width: 8px;\n}\n.scatter-control {\n  flex: 0 0 auto;\n  min-height: 23px;\n  padding: 3px 7px;\n  color: var(--faint);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  font: 500 7.5px / 1.15 var(--mono);\n  white-space: nowrap;\n}\n.scatter-control:hover,\n.scatter-control[aria-pressed=\"true\"] {\n  color: var(--teal);\n  background: var(--panel-3);\n  border-color: var(--teal-dim);\n}\n.scatter__density rect {\n  fill: var(--teal);\n  pointer-events: none;\n}\n.revision-scatter[data-scatter-density=\"off\"] .scatter__density {\n  display: none;\n}\n.scatter__crosshair {\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.1s var(--ease);\n}\n.scatter__crosshair.is-visible {\n  opacity: 1;\n}\n.scatter__crosshair line {\n  stroke: rgba(23, 36, 33, 0.38);\n  stroke-dasharray: 2 3;\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n.scatter__selection-box {\n  fill: rgba(8, 127, 117, 0.08);\n  stroke: var(--teal);\n  stroke-dasharray: 4 3;\n  stroke-width: 1.2;\n  pointer-events: none;\n  vector-effect: non-scaling-stroke;\n}\n.chart .scatter__selection-label {\n  fill: var(--text);\n  font-size: 8px;\n  font-weight: 600;\n  paint-order: stroke;\n  pointer-events: none;\n  stroke: var(--panel);\n  stroke-width: 3px;\n  text-anchor: start;\n}\n.revision-scatter__legend {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 7px 14px;\n  padding: 6px 8px 8px;\n  color: var(--faint);\n  font: 500 10px / 1.25 var(--mono);\n}\n.revision-scatter__legend span {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  white-space: nowrap;\n}\n.scatter-key {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  background: var(--teal);\n  border: 1px solid var(--panel);\n  border-radius: 50%;\n  box-shadow: 0 0 0 1px var(--hairline);\n}\n.scatter-key--worsened {\n  background: var(--red);\n}\n.scatter-key--neutral {\n  background: var(--faint);\n}\n.scatter-key--size {\n  width: 11px;\n  height: 11px;\n  background: transparent;\n  border-color: var(--faint);\n  box-shadow: none;\n}\n.scatter-key--density {\n  width: 11px;\n  height: 8px;\n  background: rgba(8, 127, 117, 0.3);\n  border: 0;\n  border-radius: 2px;\n  box-shadow: none;\n}\n\n.metricbar {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: 1fr 0.85fr 1.2fr 1.5fr;\n  align-items: end;\n  gap: 8px;\n  min-height: 39px;\n  padding: 5px 8px;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n}\n.metricbar label {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n.metricbar label span {\n  color: var(--faint);\n  font: 400 7px / 1.2 var(--mono);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.metricbar select {\n  width: 100%;\n  min-width: 0;\n  height: 22px;\n  padding: 1px 3px;\n  color: var(--text);\n  background: var(--bg-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 3px;\n  font: 500 8px / 1.2 var(--mono);\n}\n.metricbar__note {\n  align-self: center;\n  color: var(--faint);\n  font: 400 7.5px / 1.3 var(--mono);\n}\n#pane-trends.is-active {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(350px, 0.85fr);\n  grid-template-rows: auto auto minmax(0, 1fr);\n}\n#pane-trends .pane__head,\n#pane-trends .metricbar {\n  grid-column: 1 / -1;\n}\n.trend-main {\n  grid-column: 1;\n  grid-row: 3;\n}\n.grid2 {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px;\n  min-height: 0;\n}\n.trend-lower {\n  grid-column: 2;\n  grid-row: 3;\n  grid-template-columns: minmax(0, 1fr);\n  grid-template-rows: repeat(2, minmax(0, 1fr));\n}\n.dual-bars {\n  display: grid;\n  align-content: center;\n  gap: 5px;\n  width: 100%;\n  padding: 7px 12px;\n}\n.dual-row {\n  display: grid;\n  grid-template-columns: 32px minmax(0, 1fr) 62px;\n  align-items: center;\n  gap: 7px;\n  color: var(--faint);\n  font: 500 7.5px / 1.2 var(--mono);\n}\n.dual-row i {\n  position: relative;\n  display: block;\n  height: 11px;\n  overflow: hidden;\n  background: var(--panel-2);\n  border-radius: 5px;\n}\n.dual-row i::before,\n.dual-row i::after {\n  position: absolute;\n  left: 0;\n  height: 4px;\n  content: \"\";\n  border-radius: 4px;\n}\n.dual-row i::before {\n  top: 1px;\n  width: var(--tm);\n  background: var(--amber);\n}\n.dual-row i::after {\n  bottom: 1px;\n  width: var(--ml);\n  background: var(--teal);\n}\n.dual-row strong {\n  color: var(--text);\n  text-align: right;\n}\n\n.heatmap {\n  display: grid;\n  grid-template-columns: 66px repeat(6, minmax(22px, 1fr));\n  gap: 1px;\n  width: 100%;\n  padding: 2px 9px;\n  font: 500 7px / 1 var(--mono);\n}\n.heatmap b,\n.heatmap i {\n  display: grid;\n  min-width: 0;\n  min-height: 13px;\n  place-items: center;\n  overflow: hidden;\n  font-style: normal;\n  border-radius: 2px;\n}\n.heatmap b {\n  color: var(--faint);\n  font-weight: 500;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.heatmap > b:nth-child(7n + 1) {\n  justify-content: start;\n}\n.heatmap i {\n  color: #17322d;\n  border: 1px solid rgba(8, 127, 117, 0.08);\n}\n.heatmap [data-level=\"1\"] {\n  background: #f6e9e5;\n}\n.heatmap [data-level=\"2\"] {\n  background: #e9efdc;\n}\n.heatmap [data-level=\"3\"] {\n  background: #d5e9df;\n}\n.heatmap [data-level=\"4\"] {\n  background: #aad4c9;\n}\n.heatmap [data-level=\"5\"] {\n  background: #7bbeb2;\n}\n\n.subtabs {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-self: flex-start;\n  min-height: 30px;\n  padding: 3px;\n  background: #e9efed;\n  border: 1px solid var(--hairline);\n  border-radius: 6px;\n}\n.subtab {\n  min-height: 24px;\n  padding: 3px 10px;\n  color: var(--faint);\n  background: transparent;\n  border: 0;\n  border-radius: 4px;\n  font: 500 8.5px / 1.2 var(--mono);\n  letter-spacing: 0.035em;\n}\n.subtab:hover {\n  color: var(--text);\n}\n.subtab.is-active {\n  color: var(--teal);\n  background: var(--panel);\n  box-shadow: 0 1px 2px rgba(23, 36, 33, 0.08);\n}\n.subpanel {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  min-height: 0;\n}\n.comparison-ledger,\n.exception-summary {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 14px;\n  min-height: 28px;\n  padding: 5px 9px;\n  color: var(--muted);\n  background: var(--panel);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 5px;\n  font: 500 8px / 1.2 var(--mono);\n  white-space: nowrap;\n}\n.comparison-ledger span,\n.exception-summary span {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n.comparison-kpis .kpi {\n  min-height: 70px;\n}\n[data-revision-panel] {\n  overflow: auto;\n  padding-right: 2px;\n}\n.outcome__content {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 7px;\n  width: 100%;\n}\n.outcome__content > .severity,\n.outcome__content > .outcome__instructions {\n  grid-column: 1;\n  justify-self: start;\n}\n.outcome__content > strong {\n  grid-column: 2;\n  justify-self: end;\n}\n.outcome__instructions {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 2px;\n}\n.outcome .severity {\n  padding: 1px 4px;\n  font-size: 6px;\n}\n.revision-layout,\n.source-layout,\n.history-layout {\n  display: grid;\n  flex: 1 1 auto;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px;\n  min-height: 0;\n}\n.revision-layout {\n  flex: 0 0 auto;\n  min-height: 360px;\n}\n#pane-comparison {\n  gap: 7px;\n  padding-bottom: 12px;\n}\n#pane-comparison .subpanel {\n  gap: 6px;\n}\n#pane-comparison .revision-layout {\n  min-height: 330px;\n}\n#pane-comparison .revision-layout .frame__body {\n  grid-template-columns: minmax(0, 1fr);\n  place-items: stretch;\n  min-width: 0;\n  width: 100%;\n}\n#pane-comparison .revision-queue {\n  min-height: 320px;\n}\n.outcome-body {\n  display: grid;\n  flex: 1 1 auto;\n  grid-template-rows: 62px minmax(0, 1fr);\n  gap: 7px;\n  min-height: 0;\n  padding: 8px;\n}\n.outcome-strip {\n  display: flex;\n  overflow: hidden;\n  border: 1px solid var(--hairline-soft);\n  border-radius: 6px;\n}\n.outcome {\n  display: grid;\n  flex: 1 1 0;\n  grid-template-columns: minmax(0, 1fr);\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  align-items: center;\n  row-gap: 1px;\n  min-width: 44px;\n  padding: 5px;\n  color: var(--text);\n  border-right: 1px solid rgba(255, 255, 255, 0.7);\n  text-align: center;\n}\n.outcome:last-child {\n  border-right: 0;\n}\n.outcome > b {\n  grid-column: 1;\n  grid-row: 1;\n  justify-self: end;\n  font: 600 8.5px / 1.2 var(--mono);\n  text-align: right;\n  text-transform: uppercase;\n}\n.outcome > .outcome__content {\n  grid-column: 1;\n  grid-row: 2;\n  min-height: 0;\n}\n.outcome strong {\n  font: 600 16px / 1.15 var(--display);\n}\n.outcome--good {\n  background: #dceeea;\n}\n.outcome--bad {\n  background: #f5dfdd;\n}\n.outcome--neutral {\n  background: #f3ead8;\n}\n.outcome--idle {\n  background: #edf1ef;\n}\n.outcome__drilldown {\n  position: static;\n  grid-column: 1;\n  grid-row: 3;\n  display: grid;\n  width: 16px;\n  height: 16px;\n  padding: 0;\n  place-items: center end;\n  align-self: end;\n  justify-self: end;\n  color: var(--muted);\n  background: transparent;\n  border: 0;\n  border-radius: 0;\n  cursor: pointer;\n}\n.outcome__drilldown:hover,\n.outcome__drilldown[aria-expanded=\"true\"] {\n  color: var(--text);\n  background: transparent;\n}\n.outcome__drilldown:focus-visible {\n  color: var(--text);\n  outline: 2px solid var(--teal);\n  outline-offset: 2px;\n}\n.outcome__drilldown svg {\n  width: 12px;\n  height: 12px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.4;\n}\n.revision-selection-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-height: 28px;\n  margin: 0 0 7px;\n  padding: 4px 8px;\n  color: var(--muted);\n  background: var(--panel);\n  border: 1px solid var(--teal);\n  border-radius: 5px;\n  font: 500 9px / 1.2 var(--mono);\n}\n.revision-selection-bar[hidden] {\n  display: none;\n}\n.revision-selection-bar__copy {\n  display: grid;\n  gap: 2px;\n}\n.revision-selection-bar__copy small {\n  color: var(--faint);\n  font-size: 8px;\n}\n.revision-selection-bar b {\n  color: var(--text);\n}\n.btn--quiet {\n  min-height: 20px;\n  padding: 2px 7px;\n  color: var(--muted);\n  background: transparent;\n  border: 1px solid var(--hairline-soft);\n  font-size: 8px;\n}\n.revision-drilldown-popover {\n  position: fixed;\n  z-index: 30;\n  width: min(650px, calc(100vw - 20px));\n  max-height: min(470px, calc(100vh - 20px));\n  overflow: auto;\n  color: var(--text);\n  background: var(--panel);\n  border: 1px solid var(--teal);\n  border-radius: 7px;\n  box-shadow: 0 14px 34px rgba(23, 36, 33, 0.2);\n}\n.revision-drilldown-popover[hidden] {\n  display: none;\n}\n.revision-drilldown-popover__head {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 10px 12px 8px;\n  background: var(--panel);\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.revision-drilldown-popover__head div {\n  display: grid;\n  gap: 2px;\n}\n.revision-drilldown-popover__head span,\n.revision-drilldown-popover__head small {\n  color: var(--muted);\n  font: 500 8px / 1.3 var(--mono);\n}\n.revision-drilldown-popover__head strong {\n  font: 600 15px / 1.1 var(--display);\n}\n.revision-drilldown-popover__head > button {\n  width: 23px;\n  height: 23px;\n  padding: 0;\n  color: var(--muted);\n  background: transparent;\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  font-size: 17px;\n  line-height: 1;\n  cursor: pointer;\n}\n.revision-drilldown-table {\n  display: grid;\n  min-width: 560px;\n  padding: 6px;\n  font: 500 9px / 1.25 var(--mono);\n}\n.revision-drilldown-head,\n.revision-drilldown-row {\n  display: grid;\n  grid-template-columns: minmax(170px, 1.8fr) 48px 90px 90px 100px;\n  align-items: center;\n  gap: 7px;\n  padding: 6px 7px;\n}\n.revision-drilldown-head {\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.revision-drilldown-row {\n  width: 100%;\n  color: var(--text);\n  text-align: left;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.revision-drilldown-row:hover,\n.revision-drilldown-row:focus-visible,\n.revision-drilldown-row.is-selected {\n  background: #e5f1ee;\n  border-color: var(--teal);\n  outline: none;\n}\n.revision-drilldown-row > span:first-child {\n  display: grid;\n  min-width: 0;\n  gap: 2px;\n}\n.revision-drilldown-row b {\n  font-weight: 700;\n}\n.revision-drilldown-row small {\n  overflow: hidden;\n  color: var(--muted);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.revision-drilldown-row > span:not(:first-child) {\n  text-align: right;\n}\n.revision-drilldown-empty {\n  margin: 14px 7px;\n  color: var(--muted);\n}\n@media (max-width: 720px) {\n  #pane-comparison .revision-layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .revision-drilldown-popover {\n    width: calc(100vw - 20px);\n  }\n  .revision-drilldown-table {\n    min-width: 0;\n    font-size: 8px;\n  }\n  .revision-drilldown-head,\n  .revision-drilldown-row {\n    grid-template-columns: minmax(120px, 1.6fr) 34px 69px 73px 78px;\n    gap: 4px;\n    padding-inline: 4px;\n  }\n}\n.revision-history-body,\n.revision-history-chart {\n  min-width: 0;\n  min-height: 0;\n}\n.revision-history-body {\n  overflow: hidden;\n  border: 1px solid var(--hairline-soft);\n  border-radius: 5px;\n  background: #fbfdfc;\n}\n.revision-history-chart {\n  display: grid;\n  width: 100%;\n  height: 100%;\n  grid-template-rows: minmax(0, 1fr) auto;\n}\n.chart--revision-history {\n  min-height: 0;\n  padding: 1px 3px 0;\n  shape-rendering: geometricPrecision;\n}\n.revision-history__grid line {\n  stroke: var(--hairline-soft);\n  stroke-width: 1;\n}\n.revision-history__grid .revision-history__baseline {\n  stroke: var(--faint-2);\n  stroke-dasharray: 4 4;\n  stroke-width: 1.35;\n}\n.chart--revision-history .revision-history__grid text {\n  fill: var(--faint-2);\n  font-size: 9px;\n  text-anchor: end;\n}\n.revision-history__band-bg {\n  fill: rgba(8, 127, 117, 0.018);\n}\n.revision-history__band:nth-of-type(odd) .revision-history__band-bg {\n  fill: rgba(23, 36, 33, 0.026);\n}\n.revision-history__separator {\n  stroke: var(--hairline);\n  stroke-width: 1;\n}\n.revision-history__path {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 2.35;\n  pointer-events: none;\n  vector-effect: non-scaling-stroke;\n}\n.revision-history__segment--improved {\n  stroke: var(--series-vintage-b);\n}\n.revision-history__segment--worsened {\n  stroke: var(--red);\n}\n.revision-history__segment--neutral {\n  stroke: var(--faint-2);\n}\n.revision-history__segment-hit {\n  fill: none;\n  cursor: help;\n  pointer-events: stroke;\n  stroke: transparent;\n  stroke-width: 14;\n}\n.revision-history__segment-hit:focus {\n  outline: none;\n}\n.revision-history__node {\n  fill: var(--panel);\n  stroke-width: 1.8;\n  pointer-events: all;\n  vector-effect: non-scaling-stroke;\n}\n.revision-history__point {\n  cursor: pointer;\n}\n.revision-history__point:focus {\n  outline: none;\n}\n.revision-history__point:hover .revision-history__node,\n.revision-history__point:focus .revision-history__node {\n  fill: var(--panel-3);\n  stroke-width: 3;\n}\n.revision-history__node--baseline {\n  stroke: var(--faint-2);\n  stroke-dasharray: 2 1;\n}\n.revision-history__node--improved {\n  stroke: var(--series-vintage-b);\n}\n.revision-history__node--worsened {\n  stroke: var(--red);\n}\n.revision-history__node--neutral {\n  stroke: var(--faint-2);\n}\n.revision-history__point.is-selected .revision-history__node {\n  stroke-width: 3;\n}\n.revision-history__score,\n.revision-history__vintage {\n  fill: var(--faint-2);\n  font-family: var(--mono);\n  font-size: 6.5px;\n  font-weight: 600;\n  pointer-events: none;\n}\n.chart--revision-history .revision-history__month {\n  fill: var(--muted);\n  font-size: 9px;\n  font-weight: 600;\n}\n.chart--revision-history .revision-history__axis-title {\n  fill: var(--faint-2);\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 0.025em;\n}\n.revision-history__legend {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 4px 12px;\n  min-height: 25px;\n  padding: 4px 7px 5px;\n  color: var(--faint);\n  border-top: 1px solid var(--hairline-soft);\n  font: 500 7px / 1.2 var(--mono);\n}\n.revision-history__legend span {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  white-space: nowrap;\n}\n.revision-history__legend i {\n  display: inline-block;\n  width: 8px;\n  height: 6px;\n  background: var(--teal);\n  border: 1px solid var(--panel);\n  box-shadow: 0 0 0 1px var(--hairline);\n}\n.revision-history__legend .revision-history__legend-improved,\n.revision-history__legend .revision-history__legend-worsened,\n.revision-history__legend .revision-history__legend-neutral {\n  width: 11px;\n  height: 3px;\n  border: 0;\n  box-shadow: none;\n}\n.revision-history__legend .revision-history__legend-improved {\n  background: var(--series-vintage-b);\n}\n.revision-history__legend .revision-history__legend-worsened {\n  background: var(--red);\n}\n.revision-history__legend .revision-history__legend-neutral {\n  background: var(--faint-2);\n}\n\n.has-revision-effectiveness-guide-dialog {\n  overflow: hidden;\n}\n.revision-effectiveness-guide-dialog {\n  position: fixed;\n  inset: 0;\n  z-index: 80;\n  display: grid;\n  place-items: center;\n  padding: 5vh 5vw;\n  background: rgba(18, 31, 28, 0.58);\n  backdrop-filter: blur(4px) saturate(0.76);\n}\n.revision-effectiveness-guide-dialog__panel {\n  position: relative;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  width: min(1460px, 90vw);\n  height: min(820px, 90vh);\n  min-height: 0;\n  overflow: hidden;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 10px;\n  box-shadow: 0 32px 100px rgba(15, 34, 29, 0.3);\n}\n.revision-effectiveness-guide-dialog__panel::before {\n  position: absolute;\n  inset: 0 0 auto;\n  height: 4px;\n  background: linear-gradient(\n    90deg,\n    var(--teal) 0 52%,\n    var(--amber) 52% 72%,\n    var(--red) 72% 100%\n  );\n  content: \"\";\n}\n.revision-effectiveness-guide-dialog__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 17px 22px 14px;\n  border-bottom: 1px solid var(--hairline);\n}\n.revision-effectiveness-guide-dialog__head h2 {\n  margin: 2px 0 0;\n  font: 600 23px / 1.08 var(--display);\n  letter-spacing: -0.015em;\n}\n.revision-effectiveness-guide-dialog__head p:last-child {\n  max-width: 900px;\n  margin: 6px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.35;\n}\n.revision-effectiveness-guide-dialog__body {\n  display: grid;\n  grid-template-columns: 0.96fr 1.1fr 0.94fr;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  gap: 11px;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  padding: 12px 16px;\n  background-image: repeating-linear-gradient(\n    45deg,\n    rgba(23, 36, 33, 0.017) 0 1px,\n    transparent 1px 13px\n  );\n}\n.revision-guide__distinction {\n  display: grid;\n  grid-column: 1 / -1;\n  grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);\n  gap: 8px 18px;\n  align-items: center;\n  padding: 8px 12px;\n  color: var(--muted);\n  background: #eef5f3;\n  border: 1px solid #cbded9;\n  border-radius: 5px;\n  font-size: 11px;\n  line-height: 1.3;\n}\n.revision-guide__distinction > strong {\n  color: var(--teal);\n  font: 600 9px / 1.25 var(--mono);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.revision-guide__distinction b {\n  color: var(--text);\n}\n.revision-guide__card {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  padding: 12px 13px;\n  background: rgba(255, 255, 255, 0.92);\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n}\n.revision-guide__card-head {\n  display: flex;\n  gap: 9px;\n  align-items: flex-start;\n}\n.revision-guide__card-head > span,\n.revision-guide__discussion-intro > span {\n  display: grid;\n  flex: 0 0 auto;\n  width: 24px;\n  height: 24px;\n  place-items: center;\n  color: var(--panel);\n  background: var(--teal);\n  border-radius: 3px;\n  font: 600 8px / 1 var(--mono);\n  letter-spacing: 0.06em;\n}\n.revision-guide__card-head h3,\n.revision-guide__discussion h3 {\n  margin: 0;\n  font: 600 15px / 1.15 var(--display);\n}\n.revision-guide__card-head p,\n.revision-guide__discussion-intro p {\n  margin: 3px 0 0;\n  color: var(--faint);\n  font-size: 10px;\n  line-height: 1.3;\n}\n.revision-guide__step-visual {\n  display: block;\n  width: 100%;\n  height: min(165px, 23vh);\n  margin-top: auto;\n}\n.revision-guide__micro-grid line {\n  stroke: var(--hairline-soft);\n}\n.revision-guide__micro-grid text,\n.revision-guide__micro-labels text {\n  fill: var(--faint);\n  font: 9px var(--mono);\n}\n.revision-guide__neutral-line {\n  stroke: var(--faint-2);\n  stroke-dasharray: 4 4;\n}\n.revision-guide__example-path {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 3;\n}\n.revision-guide__example-path--good {\n  stroke: var(--teal);\n}\n.revision-guide__example-path--bad {\n  stroke: var(--red);\n}\n.revision-guide__micro-points circle {\n  fill: var(--panel);\n  stroke: var(--teal);\n  stroke-width: 2;\n}\n.revision-guide__micro-points circle:nth-of-type(n + 6) {\n  stroke: var(--red);\n}\n.revision-guide__reading-key {\n  display: grid;\n  gap: 4px;\n  color: var(--muted);\n  margin-bottom: auto;\n  font: 9px / 1.3 var(--mono);\n}\n.revision-guide__reading-key span {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.revision-guide__reading-key i {\n  width: 14px;\n  height: 3px;\n  background: var(--teal);\n}\n.revision-guide__reading-key .is-down {\n  background: var(--red);\n}\n.revision-guide__reading-key .is-latest {\n  width: 7px;\n  height: 7px;\n  background: var(--panel);\n  border: 2px solid var(--teal);\n  border-radius: 50%;\n}\n.revision-guide__formula {\n  display: grid;\n  gap: 8px;\n  margin-top: auto;\n}\n.revision-guide__ingredient {\n  padding: 8px 9px;\n  background: var(--panel-2);\n  border-left: 3px solid var(--teal);\n  border-radius: 0 4px 4px 0;\n}\n.revision-guide__ingredient > div:first-child {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n}\n.revision-guide__ingredient strong {\n  color: var(--teal);\n  font: 600 16px / 1 var(--mono);\n}\n.revision-guide__ingredient b {\n  font-size: 12px;\n}\n.revision-guide__ingredient p {\n  margin: 3px 0 5px;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.25;\n}\n.revision-guide__ingredient-visual,\n.revision-guide__ratio-visual,\n.revision-guide__outcome-visual {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--faint);\n  font: 8.5px / 1 var(--mono);\n}\n.revision-guide__ingredient-visual i {\n  position: relative;\n  flex: 1;\n  height: 6px;\n  overflow: hidden;\n  background: #dfe8e5;\n  border-radius: 2px;\n}\n.revision-guide__ingredient-visual i::after {\n  display: block;\n  width: var(--score-width);\n  height: 100%;\n  background: var(--teal);\n  content: \"\";\n}\n.revision-guide__ingredient-visual em {\n  color: var(--teal);\n  font-style: normal;\n}\n.revision-guide__ratio-visual span {\n  flex: 1;\n  padding: 4px 5px;\n  text-align: center;\n  background: var(--panel);\n  border: 1px solid var(--hairline-soft);\n}\n.revision-guide__outcome-visual i {\n  flex: 1;\n  height: 6px;\n  background: var(--teal);\n  border-radius: 2px;\n}\n.revision-guide__outcome-visual .is-harmful {\n  background: var(--red);\n}\n.revision-guide__equation {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  align-items: center;\n  margin-top: 9px;\n  padding: 8px;\n  color: var(--faint);\n  background: #f2f7f6;\n  border: 1px solid #d9e7e3;\n  border-radius: 4px;\n  margin-bottom: auto;\n  font: 8.5px / 1.2 var(--mono);\n}\n.revision-guide__equation b {\n  color: var(--faint-2);\n}\n.revision-guide__equation strong {\n  color: var(--teal);\n}\n.revision-guide__bands {\n  display: grid;\n  gap: 6px;\n  margin-top: auto;\n}\n.revision-guide__bands > div {\n  display: grid;\n  grid-template-columns: 51px 85px minmax(0, 1fr);\n  gap: 7px;\n  align-items: center;\n  padding: 8px;\n  border-left: 4px solid currentcolor;\n  border-radius: 0 4px 4px 0;\n}\n.revision-guide__bands b {\n  font: 600 12px / 1 var(--mono);\n}\n.revision-guide__bands span {\n  color: var(--text);\n  font-size: 11px;\n  font-weight: 600;\n}\n.revision-guide__bands small {\n  color: var(--muted);\n  font-size: 9px;\n  line-height: 1.25;\n}\n.revision-guide__bands .is-high,\n.revision-guide__bands .is-useful {\n  color: var(--teal);\n  background: #eef7f5;\n}\n.revision-guide__bands .is-mixed {\n  color: var(--amber);\n  background: #faf4e8;\n}\n.revision-guide__bands .is-harmful {\n  color: var(--red);\n  background: #fbefed;\n}\n.revision-guide__shape-notes {\n  display: grid;\n  gap: 5px;\n  margin-top: 9px;\n  margin-bottom: auto;\n  color: var(--muted);\n  font-size: 9.5px;\n  line-height: 1.25;\n}\n.revision-guide__shape-notes b {\n  color: var(--text);\n}\n.revision-guide__discussion {\n  display: grid;\n  grid-column: 1 / -1;\n  grid-template-columns: 1.12fr 1fr 1fr;\n  gap: 15px;\n  padding: 11px 13px;\n  background: #eff5f3;\n  border: 1px solid #cfdfdb;\n  border-radius: 6px;\n}\n.revision-guide__discussion-intro {\n  display: flex;\n  gap: 9px;\n}\n.revision-guide__discussion > div:not(:first-child) {\n  padding-left: 14px;\n  border-left: 1px solid #cbdad6;\n}\n.revision-guide__discussion strong {\n  color: var(--teal);\n  font-size: 11px;\n}\n.revision-guide__discussion ul {\n  display: grid;\n  gap: 3px;\n  margin: 5px 0 0;\n  padding-left: 15px;\n  color: var(--muted);\n  font-size: 9.5px;\n  line-height: 1.3;\n}\n.revision-effectiveness-guide-dialog__foot {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 5px 18px;\n  padding: 8px 14px;\n  color: var(--faint);\n  background: var(--panel-2);\n  border-top: 1px solid var(--hairline);\n  font: 8.5px / 1.25 var(--mono);\n}\n.revision-effectiveness-guide-dialog__foot b {\n  color: var(--muted);\n}\n@media (max-height: 760px) {\n  .revision-effectiveness-guide-dialog__head {\n    padding: 11px 16px 9px;\n  }\n  .revision-effectiveness-guide-dialog__head h2 {\n    font-size: 18px;\n  }\n  .revision-effectiveness-guide-dialog__head p:last-child {\n    margin-top: 3px;\n    font-size: 10px;\n  }\n  .revision-effectiveness-guide-dialog__body {\n    gap: 8px;\n    padding: 9px 12px;\n  }\n  .revision-guide__distinction {\n    padding: 6px 9px;\n  }\n  .revision-guide__card {\n    padding: 9px 10px;\n  }\n  .revision-guide__card-head h3,\n  .revision-guide__discussion h3 {\n    font-size: 13px;\n  }\n  .revision-guide__card-head p,\n  .revision-guide__discussion-intro p,\n  .revision-guide__ingredient p {\n    font-size: 9px;\n  }\n  .revision-guide__distinction {\n    font-size: 9.5px;\n  }\n  .revision-guide__step-visual {\n    height: 155px;\n  }\n  .revision-guide__formula,\n  .revision-guide__bands {\n    gap: 5px;\n    margin-top: 7px;\n  }\n  .revision-guide__ingredient,\n  .revision-guide__bands > div {\n    padding: 5px 7px;\n  }\n  .revision-guide__ingredient p {\n    margin-block: 2px 4px;\n  }\n  .revision-guide__equation,\n  .revision-guide__shape-notes {\n    margin-top: 6px;\n  }\n  .revision-guide__discussion {\n    gap: 11px;\n    padding: 8px 10px;\n  }\n  .revision-guide__discussion strong {\n    font-size: 10px;\n  }\n  .revision-guide__discussion ul {\n    gap: 1px;\n    margin-top: 3px;\n    font-size: 8.5px;\n  }\n  .revision-effectiveness-guide-dialog__foot {\n    padding-block: 5px;\n    font-size: 7px;\n  }\n}\n\n.chart-dialog-pair__title-row {\n  display: flex;\n  gap: 7px;\n  align-items: center;\n}\n.chart-dialog-pair__title-row h3 {\n  margin: 0;\n}\n\n.has-revision-scatter-guide-dialog,\n.has-comparison-kpi-guide-dialog,\n.has-overview-guide-dialog {\n  overflow: hidden;\n}\n.scatter-guide__body,\n.comparison-kpi-guide__body {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  padding: 12px 16px;\n  background-image: repeating-linear-gradient(\n    45deg,\n    rgba(23, 36, 33, 0.017) 0 1px,\n    transparent 1px 13px\n  );\n}\n.scatter-guide__body {\n  display: grid;\n  grid-template-columns: 1.05fr 0.98fr 0.97fr;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  gap: 11px;\n}\n.scatter-guide__scope,\n.comparison-kpi-guide__definition {\n  display: flex;\n  grid-column: 1 / -1;\n  gap: 9px;\n  align-items: center;\n  padding: 8px 12px;\n  color: var(--muted);\n  background: #eef5f3;\n  border: 1px solid #cbded9;\n  border-radius: 5px;\n  font-size: 10.5px;\n  line-height: 1.25;\n}\n.scatter-guide__scope strong,\n.comparison-kpi-guide__definition strong {\n  color: var(--teal);\n  font: 600 9px / 1.25 var(--mono);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.scatter-guide__scope strong {\n  margin-right: auto;\n}\n.scatter-guide__scope b {\n  color: var(--faint-2);\n}\n.scatter-guide__quadrant {\n  display: block;\n  width: 100%;\n  height: min(250px, 30vh);\n  margin: auto 0;\n}\n.scatter-guide__grid line {\n  stroke: var(--hairline-soft);\n}\n.scatter-guide__heat-cells rect {\n  fill: var(--teal);\n  opacity: 0.08;\n}\n.scatter-guide__heat-cells rect.is-medium {\n  opacity: 0.15;\n}\n.scatter-guide__heat-cells rect.is-peak {\n  opacity: 0.25;\n}\n.scatter-guide__zero {\n  stroke: #318eab;\n  stroke-dasharray: 4 3;\n  stroke-width: 1.5;\n}\n.scatter-guide__quadrant-labels text {\n  fill: var(--faint);\n  font: 8px var(--mono);\n  letter-spacing: 0.035em;\n}\n.scatter-guide__bubbles circle {\n  opacity: 0.78;\n  stroke: var(--panel);\n  stroke-width: 2;\n}\n.scatter-guide__bubbles .is-good {\n  fill: var(--teal);\n}\n.scatter-guide__bubbles .is-bad {\n  fill: var(--red);\n}\n.scatter-guide__bubbles .is-neutral {\n  fill: var(--faint-2);\n}\n.scatter-guide__axis {\n  fill: var(--muted);\n  font: 8.5px var(--mono);\n}\n.scatter-guide__reading-key {\n  display: grid;\n  gap: 4px;\n  color: var(--muted);\n  font: 9px / 1.25 var(--mono);\n}\n.scatter-guide__reading-key span {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n}\n.scatter-guide__reading-key i {\n  width: 9px;\n  height: 9px;\n  background: var(--teal);\n  border-radius: 50%;\n}\n.scatter-guide__reading-key i.is-bad {\n  background: var(--red);\n}\n.scatter-guide__reading-key i.is-density {\n  border-radius: 2px;\n  background: rgba(10, 137, 125, 0.22);\n}\n.scatter-guide__reading-key b {\n  color: var(--text);\n}\n.scatter-guide__build-flow {\n  display: grid;\n  gap: 7px;\n  margin: auto 0;\n}\n.scatter-guide__build-flow > div {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr);\n  gap: 7px;\n  align-items: center;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.3;\n}\n.scatter-guide__build-flow b {\n  display: grid;\n  width: 22px;\n  height: 22px;\n  place-items: center;\n  color: var(--panel);\n  background: var(--teal);\n  border-radius: 50%;\n  font: 600 8px / 1 var(--mono);\n}\n.scatter-guide__axis-cards {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 7px;\n  margin-top: 10px;\n}\n.scatter-guide__axis-cards > div {\n  padding: 8px;\n  background: var(--panel-2);\n  border-top: 3px solid var(--teal);\n  border-radius: 0 0 4px 4px;\n}\n.scatter-guide__axis-cards strong,\n.scatter-guide__controls strong {\n  color: var(--teal);\n  font-size: 10px;\n}\n.scatter-guide__axis-cards p {\n  margin: 5px 0 0;\n  color: var(--muted);\n  font-size: 8.8px;\n  line-height: 1.25;\n}\n.scatter-guide__axis-cards b,\n.scatter-guide__controls b {\n  color: var(--text);\n}\n.scatter-guide__caution,\n.comparison-kpi-guide__caution {\n  margin: 9px 0 0;\n  padding: 7px 8px;\n  color: var(--muted);\n  background: #faf4e8;\n  border-left: 3px solid var(--amber);\n  font-size: 9px;\n  line-height: 1.3;\n}\n.scatter-guide__signals {\n  display: grid;\n  gap: 6px;\n  margin: auto 0 7px;\n}\n.scatter-guide__signals > div {\n  display: grid;\n  grid-template-columns: 72px minmax(0, 1fr);\n  gap: 8px;\n  padding: 8px;\n  border-left: 4px solid currentcolor;\n  border-radius: 0 4px 4px 0;\n}\n.scatter-guide__signals b {\n  font-size: 10px;\n}\n.scatter-guide__signals span {\n  color: var(--muted);\n  font-size: 9px;\n  line-height: 1.25;\n}\n.scatter-guide__signals .is-good {\n  color: var(--teal);\n  background: #eef7f5;\n}\n.scatter-guide__signals .is-watch {\n  color: var(--amber);\n  background: #faf4e8;\n}\n.scatter-guide__signals .is-bad {\n  color: var(--red);\n  background: #fbefed;\n}\n.scatter-guide__heatmap-explainer {\n  display: grid;\n  grid-template-columns: 72px minmax(0, 1fr);\n  gap: 9px;\n  align-items: center;\n  margin-bottom: 7px;\n  padding: 7px 8px;\n  background: #eef5f3;\n  border: 1px solid #cbded9;\n  border-radius: 4px;\n}\n.scatter-guide__heatmap-scale {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 2px;\n}\n.scatter-guide__heatmap-scale i {\n  aspect-ratio: 1;\n  background: var(--teal);\n  border-radius: 2px;\n}\n.scatter-guide__heatmap-scale i:nth-child(1) {\n  opacity: 0.07;\n}\n.scatter-guide__heatmap-scale i:nth-child(2) {\n  opacity: 0.11;\n}\n.scatter-guide__heatmap-scale i:nth-child(3) {\n  opacity: 0.16;\n}\n.scatter-guide__heatmap-scale i:nth-child(4) {\n  opacity: 0.2;\n}\n.scatter-guide__heatmap-scale i:nth-child(5) {\n  opacity: 0.25;\n}\n.scatter-guide__heatmap-explainer strong {\n  color: var(--teal);\n  font-size: 9.5px;\n}\n.scatter-guide__heatmap-explainer p {\n  margin: 3px 0 0;\n  color: var(--muted);\n  font-size: 8.7px;\n  line-height: 1.25;\n}\n.scatter-guide__heatmap-explainer b {\n  color: var(--text);\n}\n.scatter-guide__controls {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 5px 8px;\n  padding: 8px;\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  color: var(--muted);\n  font-size: 8.8px;\n  line-height: 1.25;\n}\n.scatter-guide__controls strong {\n  grid-column: 1 / -1;\n}\n.scatter-guide__discussion,\n.comparison-kpi-guide__discussion {\n  min-height: 0;\n  overflow: hidden;\n}\n\n.comparison-kpi-guide__body {\n  display: block;\n}\n.comparison-kpi-guide__body > section {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  gap: 11px;\n  height: 100%;\n  min-height: 0;\n}\n.comparison-kpi-guide__body > section[hidden] {\n  display: none;\n}\n.comparison-kpi-guide__definition {\n  justify-content: flex-start;\n}\n.comparison-kpi-guide__definition strong {\n  flex: 0 0 auto;\n}\n.comparison-kpi-guide__visual-card,\n.comparison-kpi-guide__formula-card,\n.comparison-kpi-guide__interpret-card {\n  min-height: 0;\n}\n.comparison-kpi-guide__error-bars {\n  display: grid;\n  gap: 9px;\n  margin: auto 0;\n}\n.comparison-kpi-guide__error-bars > div {\n  display: grid;\n  grid-template-columns: 80px minmax(0, 1fr) 96px;\n  gap: 7px;\n  align-items: center;\n  color: var(--muted);\n  font: 9px / 1.2 var(--mono);\n}\n.comparison-kpi-guide__error-bars i {\n  position: relative;\n  height: 15px;\n  overflow: hidden;\n  background: #e3e9e7;\n  border-radius: 2px;\n}\n.comparison-kpi-guide__error-bars i::after {\n  display: block;\n  width: var(--guide-bar);\n  height: 100%;\n  background: var(--red);\n  content: \"\";\n}\n.comparison-kpi-guide__error-bars .is-good i::after {\n  background: var(--teal);\n}\n.comparison-kpi-guide__error-bars b {\n  color: var(--text);\n  font-size: 8px;\n  white-space: nowrap;\n}\n.comparison-kpi-guide__error-bars em {\n  justify-self: center;\n  color: var(--teal);\n  font: 8.5px / 1.2 var(--mono);\n}\n.comparison-kpi-guide__example {\n  display: grid;\n  gap: 4px;\n  margin-bottom: auto;\n  padding: 9px;\n  color: var(--muted);\n  background: #eef7f5;\n  border: 1px solid #cfe3de;\n  border-radius: 4px;\n  font-size: 9.5px;\n  line-height: 1.3;\n}\n.comparison-kpi-guide__example b {\n  color: var(--teal);\n  font: 600 10px / 1.2 var(--mono);\n}\n.comparison-kpi-guide__equation {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n  justify-content: center;\n  margin: auto 0 12px;\n  padding: 13px 9px;\n  color: var(--text);\n  background: #eef5f3;\n  border: 1px solid #cbded9;\n  border-radius: 5px;\n  font: 9px / 1.3 var(--mono);\n  text-align: center;\n}\n.comparison-kpi-guide__equation span {\n  padding: 5px 7px;\n  background: var(--panel);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 3px;\n}\n.comparison-kpi-guide__equation b {\n  color: var(--teal);\n}\n.comparison-kpi-guide__steps {\n  display: grid;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 9.5px;\n  line-height: 1.3;\n}\n.comparison-kpi-guide__steps b {\n  color: var(--text);\n}\n.comparison-kpi-guide__bands {\n  display: grid;\n  gap: 7px;\n  margin: auto 0;\n}\n.comparison-kpi-guide__bands > div {\n  display: grid;\n  grid-template-columns: 100px minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n  padding: 10px;\n  border-left: 4px solid currentcolor;\n  border-radius: 0 4px 4px 0;\n}\n.comparison-kpi-guide__bands b {\n  font: 600 10px / 1.2 var(--mono);\n}\n.comparison-kpi-guide__bands span {\n  color: var(--muted);\n  font-size: 9.5px;\n  line-height: 1.25;\n}\n.comparison-kpi-guide__bands .is-good {\n  color: var(--teal);\n  background: #eef7f5;\n}\n.comparison-kpi-guide__bands .is-watch {\n  color: var(--amber);\n  background: #faf4e8;\n}\n.comparison-kpi-guide__bands .is-bad {\n  color: var(--red);\n  background: #fbefed;\n}\n.comparison-kpi-guide__bands .is-over {\n  color: var(--amber);\n  background: #faf4e8;\n}\n.comparison-kpi-guide__bands .is-under {\n  color: var(--blue);\n  background: #edf3f8;\n}\n.comparison-kpi-guide__hit-rate {\n  display: grid;\n  grid-template-columns: repeat(6, 22px);\n  gap: 8px;\n  justify-content: center;\n  margin: auto 0;\n}\n.comparison-kpi-guide__hit-rate i {\n  width: 22px;\n  height: 22px;\n  background: var(--red);\n  border-radius: 50%;\n}\n.comparison-kpi-guide__hit-rate i.is-good {\n  background: var(--teal);\n}\n.comparison-kpi-guide__ledger {\n  position: relative;\n  display: flex;\n  height: 145px;\n  gap: 10px;\n  align-items: center;\n  justify-content: center;\n  margin: auto 0;\n  padding-bottom: 22px;\n  border-bottom: 1px solid var(--hairline);\n}\n.comparison-kpi-guide__ledger span {\n  display: flex;\n  width: 38px;\n  height: var(--ledger-height);\n  align-items: flex-start;\n  justify-content: center;\n  padding-top: 5px;\n  color: var(--panel);\n  background: var(--teal);\n  border-radius: 3px 3px 0 0;\n  font: 600 7px / 1 var(--mono);\n}\n.comparison-kpi-guide__ledger span.is-bad {\n  align-items: flex-end;\n  padding: 0 0 5px;\n  background: var(--red);\n  border-radius: 0 0 3px 3px;\n  transform: translateY(24px);\n}\n.comparison-kpi-guide__ledger em {\n  position: absolute;\n  right: 0;\n  bottom: 3px;\n  left: 0;\n  color: var(--faint);\n  font: 8px / 1.2 var(--mono);\n  text-align: center;\n}\n.comparison-kpi-guide__dot-legend {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n  justify-content: center;\n  color: var(--muted);\n  font: 8.5px / 1.2 var(--mono);\n}\n.comparison-kpi-guide__dot-legend span {\n  display: inline-flex;\n  gap: 5px;\n  align-items: center;\n}\n.comparison-kpi-guide__dot-legend i {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n}\n.comparison-kpi-guide__dot-legend i.is-good {\n  background: var(--teal);\n}\n.comparison-kpi-guide__dot-legend i.is-bad {\n  background: var(--red);\n}\n\n.comparison-kpi-guide__error-bars .is-over i::after {\n  background: var(--amber);\n}\n.comparison-kpi-guide__error-bars .is-under i::after {\n  background: var(--blue);\n}\n.overview-guide__boxes {\n  display: block;\n  width: 100%;\n  height: min(185px, 24vh);\n  margin: auto 0;\n}\n.overview-guide__boxes .box-whisker {\n  stroke: currentcolor;\n  stroke-width: 1.5;\n}\n.overview-guide__boxes .box-body {\n  fill: currentcolor;\n  fill-opacity: 0.14;\n  stroke: currentcolor;\n  stroke-width: 1.5;\n}\n.overview-guide__boxes .box-median {\n  stroke: currentcolor;\n  stroke-width: 2.5;\n}\n.overview-guide__boxes .box-axis {\n  stroke: var(--hairline);\n}\n.overview-guide__boxes .is-actual {\n  color: var(--blue);\n}\n.overview-guide__boxes .is-forecast {\n  color: var(--teal);\n}\n.overview-guide__boxes text {\n  fill: var(--muted);\n  font: 10px var(--mono);\n}\n.overview-guide__micro {\n  display: block;\n  width: 100%;\n  height: min(225px, 29vh);\n  margin: auto 0;\n}\n.overview-guide__micro .grid line {\n  stroke: var(--hairline-soft);\n}\n.overview-guide__micro .line-fixed {\n  fill: none;\n  stroke: var(--teal);\n  stroke-width: 2.5;\n  stroke-linecap: round;\n}\n.overview-guide__micro .line-old {\n  fill: none;\n  stroke: var(--amber);\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n.overview-guide__micro .line-mid {\n  fill: none;\n  stroke: var(--blue);\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n.overview-guide__micro .line-actual {\n  fill: none;\n  stroke: var(--series-actual);\n  stroke-width: 2.2;\n  stroke-linecap: round;\n}\n.overview-guide__micro .line-vintage-a {\n  fill: none;\n  stroke: var(--series-vintage-a);\n  stroke-width: 2;\n  stroke-dasharray: 6 4;\n}\n.overview-guide__micro .line-vintage-b {\n  fill: none;\n  stroke: var(--series-vintage-b);\n  stroke-width: 2.2;\n  stroke-linecap: round;\n}\n.overview-guide__micro .bias-zero {\n  stroke: var(--faint-2);\n  stroke-dasharray: 4 3;\n}\n.overview-guide__micro .bias-bar--over {\n  fill: var(--amber);\n}\n.overview-guide__micro .bias-bar--under {\n  fill: var(--blue);\n}\n.overview-guide__micro .gap-brace {\n  fill: none;\n  stroke: var(--faint-2);\n  stroke-width: 1;\n}\n.overview-guide__micro text {\n  fill: var(--muted);\n  font: 9.5px var(--mono);\n}\n.overview-guide__micro text.is-teal {\n  fill: var(--teal);\n}\n\n.revision-effectiveness-guide-dialog.is-wape-guide {\n  padding: 3vh 2vw;\n}\n.is-wape-guide .revision-effectiveness-guide-dialog__panel {\n  width: min(1460px, 96vw);\n  height: min(760px, 94vh);\n}\n.is-wape-guide .revision-effectiveness-guide-dialog__head h2 {\n  font-size: 28px;\n}\n.is-wape-guide .revision-effectiveness-guide-dialog__head p:last-child {\n  font-size: 12px;\n}\n.is-wape-guide .revision-effectiveness-guide-dialog__foot {\n  display: none;\n}\n.is-wape-guide .overview-guide__body {\n  padding: 10px 12px 12px;\n  background-image: none;\n}\n.comparison-kpi-guide__body > .wape-guide {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  gap: 9px;\n  height: 100%;\n}\n.wape-guide__formula {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n  min-width: 0;\n  padding: 7px 11px;\n  color: var(--muted);\n  background: #eef5f3;\n  border: 1px solid #cbded9;\n  border-radius: 5px;\n  font: 9px / 1.2 var(--mono);\n}\n.wape-guide__formula > strong {\n  color: var(--teal);\n  font-size: 8px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.wape-guide__formula > span:nth-of-type(1) {\n  color: var(--teal);\n  font: 600 14px / 1 var(--display);\n}\n.wape-guide__fraction {\n  display: grid;\n  min-width: 178px;\n  color: var(--text);\n  text-align: center;\n}\n.wape-guide__fraction b {\n  padding: 2px 8px;\n  font-weight: 600;\n}\n.wape-guide__fraction b:first-child {\n  border-bottom: 1px solid var(--text);\n}\n.wape-guide__formula em {\n  overflow: hidden;\n  font-family: var(--sans);\n  font-style: normal;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.wape-guide__layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1.62fr) minmax(300px, 0.74fr);\n  gap: 10px;\n  min-width: 0;\n  min-height: 0;\n}\n.wape-guide__chart-card,\n.wape-guide__sum-card {\n  padding: 10px 11px;\n}\n.wape-guide__card-head {\n  display: flex;\n  gap: 12px;\n  align-items: flex-start;\n  justify-content: space-between;\n}\n.wape-guide__card-head h3,\n.wape-guide__sum-card h3 {\n  margin: 0;\n  font: 600 17px / 1.08 var(--display);\n}\n.wape-guide__card-head p {\n  margin: 3px 0 0;\n  color: var(--muted);\n  font-size: 9px;\n  line-height: 1.25;\n}\n.wape-guide__legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 10px;\n  justify-content: flex-end;\n  color: var(--muted);\n  font: 7.5px / 1 var(--mono);\n}\n.wape-guide__legend span {\n  display: inline-flex;\n  gap: 5px;\n  align-items: center;\n  white-space: nowrap;\n}\n.wape-guide__legend i {\n  display: inline-block;\n  width: 16px;\n  height: 5px;\n  background: var(--teal);\n  border-radius: 1px;\n}\n.wape-guide__legend i.is-forecast {\n  width: 2px;\n  height: 13px;\n  background: var(--red);\n}\n.wape-guide__legend i.is-gap {\n  height: 2px;\n  background: linear-gradient(90deg, var(--red) 0 50%, var(--blue) 50%);\n}\n.wape-guide__axis,\n.wape-guide__lane {\n  display: grid;\n  grid-template-columns: 190px minmax(0, 1fr) 94px;\n  gap: 9px;\n  align-items: center;\n}\n.wape-guide__axis {\n  margin-top: 7px;\n  color: var(--muted);\n  font: 7px / 1 var(--mono);\n}\n.wape-guide__axis > div {\n  display: flex;\n  justify-content: space-between;\n  padding-bottom: 4px;\n  border-bottom: 1px solid var(--hairline);\n}\n.wape-guide__axis > span:last-child {\n  text-align: right;\n}\n.wape-guide__lanes {\n  display: grid;\n  flex: 1;\n  grid-template-rows: repeat(8, minmax(39px, 1fr));\n  min-height: 0;\n}\n.wape-guide__lane {\n  min-height: 0;\n}\n.wape-guide__lane-title,\n.wape-guide__values {\n  min-width: 0;\n}\n.wape-guide__lane-title strong,\n.wape-guide__lane-title span,\n.wape-guide__values span {\n  display: block;\n}\n.wape-guide__lane-title strong {\n  overflow: hidden;\n  font: 600 7.5px / 1.15 var(--mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.wape-guide__lane-title span,\n.wape-guide__values {\n  color: var(--muted);\n  font: 7px / 1.2 var(--mono);\n}\n.wape-guide__values {\n  padding-left: 7px;\n  border-left: 1px solid var(--hairline-soft);\n}\n.wape-guide__lane-plot {\n  position: relative;\n  height: 38px;\n  background: repeating-linear-gradient(\n    90deg,\n    transparent 0 calc(25% - 1px),\n    var(--hairline-soft) calc(25% - 1px) 25%\n  );\n}\n.wape-guide__actual,\n.wape-guide__gap,\n.wape-guide__forecast,\n.wape-guide__bracket,\n.wape-guide__error-label {\n  position: absolute;\n}\n.wape-guide__actual {\n  top: 4px;\n  left: 0;\n  height: 8px;\n  background: color-mix(in srgb, var(--teal) 74%, white);\n  border-radius: 2px;\n}\n.wape-guide__gap {\n  top: 7px;\n  height: 2px;\n  background: var(--gap-color);\n}\n.wape-guide__forecast {\n  top: 0;\n  width: 3px;\n  height: 17px;\n  background: #f5bbb6;\n  border: 1px solid var(--red);\n  border-radius: 1px;\n  transform: translateX(-50%);\n}\n.wape-guide__bracket {\n  top: 17px;\n  height: 8px;\n  border-right: 1.5px solid var(--gap-color);\n  border-bottom: 1.5px solid var(--gap-color);\n  border-left: 1.5px solid var(--gap-color);\n}\n.wape-guide__error-label {\n  top: 27px;\n  color: var(--gap-color);\n  font: 600 6.8px / 1 var(--mono);\n  transform: translateX(-50%);\n  white-space: nowrap;\n}\n.wape-guide__lane.is-over,\n.wape-guide__sum-row.is-over {\n  --gap-color: var(--red);\n}\n.wape-guide__lane.is-under,\n.wape-guide__sum-row.is-under {\n  --gap-color: var(--blue);\n}\n.wape-guide__lane.is-match,\n.wape-guide__sum-row.is-match {\n  --gap-color: var(--faint-2);\n}\n.wape-guide__sum-card h3 strong {\n  color: var(--red);\n  font-weight: 600;\n}\n.wape-guide__primary {\n  margin: 5px 0 7px;\n  color: var(--muted);\n  font: 7.5px / 1.2 var(--mono);\n}\n.wape-guide__primary b {\n  color: var(--text);\n}\n.wape-guide__sum {\n  display: grid;\n}\n.wape-guide__sum-row {\n  display: grid;\n  grid-template-columns: 50px minmax(0, 1fr) 66px;\n  gap: 6px;\n  align-items: center;\n  min-height: 22px;\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 7px / 1 var(--mono);\n}\n.wape-guide__sum-row span {\n  color: var(--muted);\n}\n.wape-guide__sum-row i {\n  height: 3px;\n  background: linear-gradient(\n    90deg,\n    var(--gap-color) 0 var(--sum-width),\n    transparent var(--sum-width)\n  );\n}\n.wape-guide__sum-row b {\n  color: var(--gap-color);\n  text-align: right;\n  white-space: nowrap;\n}\n.wape-guide__shown-total,\n.wape-guide__remaining-total {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 6px 7px;\n  font: 7.5px / 1 var(--mono);\n}\n.wape-guide__shown-total {\n  margin-top: auto;\n  color: var(--muted);\n  background: var(--panel-2);\n}\n.wape-guide__remaining-total {\n  color: var(--red);\n  border-top: 1px solid var(--hairline);\n  border-bottom: 1px solid var(--hairline);\n  font-weight: 600;\n}\n.wape-guide__error-total {\n  padding: 7px 8px;\n  background: #fbefed;\n  border-left: 3px solid var(--red);\n  border-radius: 0 5px 5px 0;\n}\n.wape-guide__error-total span,\n.wape-guide__error-total strong {\n  display: block;\n}\n.wape-guide__error-total span {\n  color: var(--muted);\n  font: 7px / 1.2 var(--mono);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.wape-guide__error-total strong {\n  margin-top: 2px;\n  font: 600 18px / 1 var(--display);\n}\n.wape-guide__division {\n  display: flex;\n  gap: 7px;\n  align-items: center;\n  justify-content: center;\n  padding: 6px 0;\n  color: var(--teal);\n  font: 600 8px / 1 var(--mono);\n}\n.wape-guide__division b {\n  color: var(--text);\n  font-size: 9px;\n}\n.wape-guide__answer {\n  padding: 8px 9px;\n  color: var(--panel);\n  background: var(--teal);\n  border-radius: 6px;\n}\n.wape-guide__answer span {\n  font: 7px / 1 var(--mono);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.wape-guide__answer strong {\n  display: block;\n  margin-top: 2px;\n  font: 600 30px / 1 var(--display);\n}\n.wape-guide__answer p {\n  margin: 4px 0 0;\n  font-size: 8.5px;\n  line-height: 1.25;\n}\n.wape-guide__note {\n  margin: 0;\n  color: var(--muted);\n  font: 7px / 1.2 var(--mono);\n  text-align: center;\n}\n.wape-guide__empty {\n  grid-row: 1 / -1;\n  margin: auto;\n  color: var(--muted);\n  font-size: 10px;\n}\n.bias-guide {\n  --bias-accent: var(--faint-2);\n  --bias-soft: var(--panel-2);\n}\n.bias-guide.is-over {\n  --bias-accent: var(--red);\n  --bias-soft: #fbefed;\n}\n.bias-guide.is-under {\n  --bias-accent: var(--blue);\n  --bias-soft: #eef5fa;\n}\n.bias-guide.is-match {\n  --bias-accent: var(--teal);\n  --bias-soft: #eef5f3;\n}\n.bias-guide .wape-guide__sum-card h3 strong,\n.bias-guide .wape-guide__remaining-total {\n  color: var(--bias-accent);\n}\n.bias-guide .wape-guide__error-total {\n  background: var(--bias-soft);\n  border-left-color: var(--bias-accent);\n}\n\n.revision-effectiveness-guide-dialog.is-error-accumulated-guide {\n  padding: 3vh 2vw;\n}\n.is-error-accumulated-guide .revision-effectiveness-guide-dialog__panel {\n  width: min(1460px, 96vw);\n  height: auto;\n  max-height: 94vh;\n}\n.is-error-accumulated-guide .revision-effectiveness-guide-dialog__head h2 {\n  font-size: 28px;\n}\n.is-error-accumulated-guide\n  .revision-effectiveness-guide-dialog__head\n  p:last-child {\n  font-size: 13px;\n}\n.is-error-accumulated-guide .revision-effectiveness-guide-dialog__foot {\n  display: none;\n}\n.is-error-accumulated-guide .overview-guide__body {\n  padding: 12px 14px 14px;\n  background-image: none;\n}\n.comparison-kpi-guide__body > .error-accumulated-guide {\n  grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.8fr);\n  grid-template-rows: auto auto;\n  gap: 12px;\n  height: auto;\n}\n.error-accumulated-guide__chart-card,\n.error-accumulated-guide__rule-card,\n.error-accumulated-guide__rollup {\n  min-width: 0;\n  min-height: 0;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 8px;\n}\n.error-accumulated-guide__chart-card {\n  display: flex;\n  flex-direction: column;\n  padding: 13px 15px 11px;\n}\n.error-accumulated-guide__card-head {\n  display: flex;\n  gap: 18px;\n  align-items: flex-start;\n  justify-content: space-between;\n}\n.error-accumulated-guide__card-head h3,\n.error-accumulated-guide__rollup-title h3 {\n  margin: 0;\n  font: 600 17px / 1.15 var(--display);\n}\n.error-accumulated-guide__card-head p {\n  margin: 3px 0 0;\n  color: var(--muted);\n  font-size: 10.5px;\n  line-height: 1.3;\n}\n.error-accumulated-guide__legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 11px;\n  justify-content: flex-end;\n  color: var(--muted);\n  font-size: 9.5px;\n  font-weight: 600;\n}\n.error-accumulated-guide__legend span {\n  display: inline-flex;\n  gap: 5px;\n  align-items: center;\n  white-space: nowrap;\n}\n.error-accumulated-guide__legend i {\n  width: 16px;\n  height: 3px;\n  background: #183f3d;\n  border-radius: 999px;\n}\n.error-accumulated-guide__legend .is-forecast {\n  background: var(--red);\n}\n.error-accumulated-guide__legend .is-over,\n.error-accumulated-guide__legend .is-under {\n  height: 8px;\n  background: #fbefed;\n  border: 1px solid var(--red);\n}\n.error-accumulated-guide__legend .is-under {\n  background: #faf4e8;\n  border-color: var(--amber);\n}\n.error-accumulated-guide__chart {\n  display: block;\n  width: 100%;\n  height: min(280px, 37vh);\n  margin: 4px 0;\n  overflow: visible;\n}\n.error-accumulated-guide__grid line {\n  stroke: var(--hairline-soft);\n}\n.error-accumulated-guide__axis-labels text,\n.error-accumulated-guide__month-labels text {\n  fill: var(--muted);\n  font: 10px var(--mono);\n}\n.error-accumulated-guide__month-labels {\n  text-anchor: middle;\n}\n.error-accumulated-guide__chart path.is-over {\n  fill: #fbefed;\n  stroke: var(--red);\n  stroke-width: 1.5;\n}\n.error-accumulated-guide__chart path.is-under {\n  fill: #faf4e8;\n  stroke: var(--amber);\n  stroke-width: 1.5;\n}\n.error-accumulated-guide__gap-labels text {\n  font: 600 10px var(--mono);\n  text-anchor: middle;\n}\n.error-accumulated-guide__gap-labels .is-over {\n  fill: var(--red);\n}\n.error-accumulated-guide__gap-labels .is-under {\n  fill: #976300;\n}\n.error-accumulated-guide__actual-line,\n.error-accumulated-guide__forecast-line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n.error-accumulated-guide__actual-line {\n  stroke: #183f3d;\n  stroke-width: 5;\n}\n.error-accumulated-guide__forecast-line {\n  stroke: var(--red);\n  stroke-width: 4;\n}\n.error-accumulated-guide__actual-points circle,\n.error-accumulated-guide__forecast-points circle {\n  stroke: var(--panel);\n  stroke-width: 3;\n}\n.error-accumulated-guide__actual-points circle {\n  fill: #183f3d;\n}\n.error-accumulated-guide__forecast-points circle {\n  fill: var(--red);\n}\n.error-accumulated-guide__line-label {\n  font: 600 10px var(--mono);\n}\n.error-accumulated-guide__line-label.is-actual {\n  fill: #183f3d;\n}\n.error-accumulated-guide__line-label.is-forecast {\n  fill: var(--red);\n}\n.error-accumulated-guide__example-equation {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  padding: 8px 10px;\n  overflow-x: auto;\n  color: var(--text);\n  background: #eef5f3;\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n.error-accumulated-guide__example-equation .is-over {\n  color: var(--red);\n}\n.error-accumulated-guide__example-equation .is-under {\n  color: #976300;\n}\n.error-accumulated-guide__example-equation b {\n  color: var(--text);\n}\n.error-accumulated-guide__example-equation strong {\n  color: var(--teal);\n  font-size: 16px;\n}\n.error-accumulated-guide__rule-card {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.error-accumulated-guide__rule-top {\n  padding: 16px 18px;\n  background: #eef5f3;\n  border-bottom: 1px solid var(--hairline);\n}\n.error-accumulated-guide__rule-top h3 {\n  margin: 7px 0 0;\n  font: 600 clamp(22px, 2vw, 31px) / 1.04 var(--display);\n  letter-spacing: -0.025em;\n}\n.error-accumulated-guide__rule-top h3 strong {\n  display: block;\n  color: var(--red);\n}\n.error-accumulated-guide__rule-steps {\n  display: grid;\n  flex: 1;\n  grid-template-rows: repeat(3, minmax(0, 1fr));\n  padding: 3px 18px 7px;\n}\n.error-accumulated-guide__rule-steps > div {\n  display: grid;\n  grid-template-columns: 28px minmax(0, 1fr);\n  gap: 10px;\n  align-items: start;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.error-accumulated-guide__rule-steps > div:last-child {\n  border-bottom: 0;\n}\n.error-accumulated-guide__rule-steps > div > b {\n  display: grid;\n  width: 26px;\n  height: 26px;\n  place-items: center;\n  color: var(--panel);\n  background: var(--teal);\n  border-radius: 5px;\n  font: 600 9px / 1 var(--mono);\n}\n.error-accumulated-guide__rule-steps p {\n  margin: 0;\n}\n.error-accumulated-guide__rule-steps strong,\n.error-accumulated-guide__rule-steps span {\n  display: block;\n}\n.error-accumulated-guide__rule-steps strong {\n  margin-bottom: 2px;\n  font-size: 11px;\n}\n.error-accumulated-guide__rule-steps span {\n  color: var(--muted);\n  font-size: 9.5px;\n  line-height: 1.3;\n}\n.error-accumulated-guide__no-cancel {\n  margin: 0 18px 14px;\n  padding: 9px 11px;\n  color: #6f4e0d;\n  background: #faf4e8;\n  border-left: 3px solid var(--amber);\n  border-radius: 5px;\n  font-size: 9.5px;\n  line-height: 1.3;\n}\n.error-accumulated-guide__rollup {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 14px;\n  align-items: center;\n  padding: 11px 13px;\n}\n.error-accumulated-guide__rollup-title {\n  display: flex;\n  gap: 8px;\n  align-items: baseline;\n  margin-bottom: 8px;\n}\n.error-accumulated-guide__rollup-title h3 {\n  font-size: 14px;\n}\n.error-accumulated-guide__rollup-title > span {\n  color: var(--muted);\n  font-size: 9px;\n  white-space: nowrap;\n}\n.error-accumulated-guide__month-errors {\n  display: grid;\n  grid-template-columns: repeat(12, minmax(43px, 1fr));\n  gap: 7px;\n}\n.error-accumulated-guide__month-error {\n  position: relative;\n  padding: 5px 3px;\n  text-align: center;\n  background: #f1f6f5;\n  border: 1px solid #dae6e3;\n  border-radius: 4px;\n}\n.error-accumulated-guide__month-error:not(:last-child)::after {\n  position: absolute;\n  top: 50%;\n  right: -6px;\n  z-index: 1;\n  color: var(--teal);\n  font-size: 9px;\n  font-weight: 600;\n  transform: translate(50%, -50%);\n  content: \"+\";\n}\n.error-accumulated-guide__month-error span,\n.error-accumulated-guide__month-error strong {\n  display: block;\n}\n.error-accumulated-guide__month-error span {\n  color: var(--muted);\n  font: 600 7.5px / 1 var(--mono);\n  letter-spacing: 0.04em;\n}\n.error-accumulated-guide__month-error strong {\n  margin-top: 3px;\n  font-size: 10px;\n}\n.error-accumulated-guide__month-errors > .error-accumulated-guide__empty {\n  grid-column: 1 / -1;\n}\n.error-accumulated-guide__empty {\n  margin: 0;\n  padding: 10px;\n  color: var(--muted);\n  background: var(--panel-2);\n  border-radius: 5px;\n  font-size: 10px;\n}\n.error-accumulated-guide__result {\n  display: grid;\n  grid-template-columns: auto 14px auto 14px auto;\n  gap: 7px;\n  align-items: center;\n}\n.error-accumulated-guide__result > div {\n  min-width: 104px;\n  padding: 8px 10px;\n  text-align: center;\n  background: #eef5f3;\n  border-radius: 6px;\n}\n.error-accumulated-guide__result strong,\n.error-accumulated-guide__result span {\n  display: block;\n}\n.error-accumulated-guide__result strong {\n  font: 600 20px / 1 var(--display);\n}\n.error-accumulated-guide__result span {\n  margin-top: 3px;\n  color: var(--muted);\n  font-size: 8.5px;\n}\n.error-accumulated-guide__result > b {\n  color: var(--teal);\n  font-size: 16px;\n}\n.error-accumulated-guide__result .is-primary {\n  color: var(--panel);\n  background: #183f3d;\n}\n.error-accumulated-guide__result .is-primary span {\n  color: #c8d9d6;\n}\n.error-accumulated-guide__result .is-extra {\n  color: #a8362f;\n  background: #fbefed;\n  border: 1px solid #efc2bd;\n}\n.error-accumulated-guide__result .is-extra.is-good {\n  color: var(--teal);\n  background: #eef7f5;\n  border-color: #cfe3de;\n}\n\n@media (max-height: 760px) {\n  .is-error-accumulated-guide .revision-effectiveness-guide-dialog__head {\n    padding: 12px 16px 10px;\n  }\n  .is-error-accumulated-guide .revision-effectiveness-guide-dialog__head h2 {\n    font-size: 23px;\n  }\n  .is-error-accumulated-guide\n    .revision-effectiveness-guide-dialog__head\n    p:last-child {\n    margin-top: 4px;\n    font-size: 11px;\n  }\n  .is-error-accumulated-guide .overview-guide__body {\n    padding: 8px 10px 10px;\n  }\n  .comparison-kpi-guide__body > .error-accumulated-guide {\n    gap: 8px;\n  }\n  .error-accumulated-guide__chart-card {\n    padding: 9px 11px 8px;\n  }\n  .error-accumulated-guide__chart {\n    height: 255px;\n  }\n  .error-accumulated-guide__rule-top {\n    padding: 11px 14px;\n  }\n  .error-accumulated-guide__rule-top h3 {\n    font-size: 23px;\n  }\n  .error-accumulated-guide__rule-steps {\n    padding-inline: 14px;\n  }\n  .error-accumulated-guide__rule-steps > div {\n    padding: 7px 0;\n  }\n  .error-accumulated-guide__no-cancel {\n    margin: auto 14px 10px;\n    padding: 7px 9px;\n  }\n  .error-accumulated-guide__rollup {\n    padding: 8px 10px;\n  }\n  .error-accumulated-guide__rollup-title {\n    margin-bottom: 6px;\n  }\n  .scatter-guide__body,\n  .comparison-kpi-guide__body {\n    padding: 9px 12px;\n  }\n  .scatter-guide__body,\n  .comparison-kpi-guide__body > section {\n    gap: 8px;\n  }\n  .scatter-guide__scope,\n  .comparison-kpi-guide__definition {\n    padding: 6px 9px;\n    font-size: 9px;\n  }\n  .scatter-guide__quadrant {\n    height: 190px;\n  }\n  .scatter-guide__build-flow {\n    gap: 4px;\n  }\n  .scatter-guide__build-flow > div {\n    font-size: 8.7px;\n  }\n  .scatter-guide__axis-cards {\n    margin-top: 6px;\n  }\n  .scatter-guide__axis-cards > div,\n  .scatter-guide__signals > div,\n  .scatter-guide__controls {\n    padding: 5px 6px;\n  }\n  .scatter-guide__caution,\n  .comparison-kpi-guide__caution {\n    margin-top: 5px;\n    padding: 5px 6px;\n    font-size: 8px;\n  }\n  .scatter-guide__signals {\n    gap: 3px;\n    margin-bottom: 4px;\n  }\n  .scatter-guide__heatmap-explainer {\n    grid-template-columns: 56px minmax(0, 1fr);\n    gap: 6px;\n    margin-bottom: 4px;\n    padding: 5px 6px;\n  }\n  .scatter-guide__heatmap-explainer p {\n    font-size: 7.7px;\n  }\n  .comparison-kpi-guide__equation {\n    margin-bottom: 7px;\n    padding: 8px 6px;\n  }\n  .comparison-kpi-guide__steps,\n  .comparison-kpi-guide__bands {\n    gap: 4px;\n  }\n  .comparison-kpi-guide__bands > div {\n    padding: 7px;\n  }\n  .comparison-kpi-guide__error-bars {\n    gap: 6px;\n  }\n  .comparison-kpi-guide__example {\n    padding: 6px;\n    font-size: 8.5px;\n  }\n  .comparison-kpi-guide__hit-rate {\n    grid-template-columns: repeat(6, 18px);\n    gap: 6px;\n  }\n  .comparison-kpi-guide__hit-rate i {\n    width: 18px;\n    height: 18px;\n  }\n  .comparison-kpi-guide__ledger {\n    height: 105px;\n  }\n}\n\n.chart-tooltip__action {\n  margin: 9px -11px -10px;\n  padding: 8px 11px;\n  color: var(--teal);\n  background: var(--panel-3);\n  border-top: 1px solid var(--hairline-soft);\n  font: 600 8.5px / 1.2 var(--mono);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.chart__month-hit:not(.chart__volume-hit) {\n  cursor: pointer;\n}\n.has-vintage-gap-dialog {\n  overflow: hidden;\n}\n.vintage-gap-dialog {\n  position: fixed;\n  inset: 0;\n  z-index: 82;\n  display: grid;\n  place-items: center;\n  padding: 16px;\n  background: rgba(15, 31, 27, 0.58);\n  backdrop-filter: blur(4px) saturate(0.78);\n}\n.vintage-gap-dialog__panel {\n  position: relative;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: min(1540px, calc(100vw - 32px));\n  height: min(900px, calc(100vh - 32px));\n  overflow: hidden;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 9px;\n  box-shadow: 0 32px 100px rgba(12, 29, 24, 0.3);\n}\n.vintage-gap-dialog__panel::before {\n  position: absolute;\n  inset: 0 0 auto;\n  z-index: 1;\n  height: 3px;\n  background: linear-gradient(\n    90deg,\n    var(--amber),\n    var(--teal) 72%,\n    transparent\n  );\n  content: \"\";\n}\n.vintage-gap-dialog__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 18px 22px 14px;\n  border-bottom: 1px solid var(--hairline);\n}\n.vintage-gap-dialog__head h2 {\n  margin: 1px 0 0;\n  font: 600 24px / 1.1 var(--display);\n  letter-spacing: -0.018em;\n}\n.vintage-gap-dialog__head p:last-child {\n  max-width: 1100px;\n  margin: 6px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.35;\n}\n.vintage-gap-dialog__body {\n  display: grid;\n  grid-template-rows: auto auto auto minmax(0, 1fr) auto;\n  min-width: 0;\n  min-height: 0;\n  gap: 10px;\n  padding: 13px 16px 10px;\n  overflow: hidden;\n}\n.vintage-gap__loading {\n  display: grid;\n  place-content: center;\n  gap: 8px;\n  height: 100%;\n  color: var(--muted);\n  text-align: center;\n}\n.vintage-gap__loading strong {\n  color: var(--text);\n  font: 600 24px / 1.1 var(--display);\n}\n.vintage-gap__loading--error strong {\n  color: var(--red);\n}\n.vintage-gap__summary {\n  display: grid;\n  grid-template-columns: 1fr 28px 1fr 1.18fr 1fr 1fr;\n  overflow: hidden;\n  border: 1px solid var(--hairline);\n  border-radius: 6px;\n}\n.vintage-gap__summary > div {\n  min-width: 0;\n  padding: 10px 12px;\n  background: #fbfcfc;\n  border-right: 1px solid var(--hairline-soft);\n}\n.vintage-gap__summary > div:last-child {\n  border-right: 0;\n}\n.vintage-gap__summary > i {\n  display: grid;\n  place-items: center;\n  color: var(--faint);\n  background: var(--panel-2);\n  border-right: 1px solid var(--hairline-soft);\n  font: 16px var(--mono);\n  font-style: normal;\n}\n.vintage-gap__summary span,\n.vintage-gap__summary small {\n  display: block;\n  overflow: hidden;\n  color: var(--faint);\n  font: 8px / 1.3 var(--mono);\n  letter-spacing: 0.07em;\n  text-overflow: ellipsis;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.vintage-gap__summary strong {\n  display: block;\n  margin: 4px 0 3px;\n  font: 600 21px / 1 var(--display);\n}\n.vintage-gap__summary-result {\n  box-shadow: inset 3px 0 var(--teal);\n}\n.vintage-gap__toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n.vintage-gap__toolbar > div {\n  display: inline-flex;\n  padding: 2px;\n  background: var(--panel-2);\n  border: 1px solid var(--hairline);\n  border-radius: 5px;\n}\n.vintage-gap__toolbar button {\n  padding: 7px 10px;\n  color: var(--muted);\n  background: transparent;\n  border: 0;\n  border-radius: 3px;\n  font: 600 9px / 1 var(--mono);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.vintage-gap__toolbar button[aria-pressed=\"true\"] {\n  color: white;\n  background: var(--teal);\n}\n.vintage-gap__toolbar button b {\n  margin-left: 6px;\n  font-weight: 600;\n}\n.vintage-gap__toolbar .vintage-gap__show-all {\n  border: 1px solid var(--hairline);\n}\n.vintage-gap__toolbar .vintage-gap__show-all[aria-pressed=\"true\"] {\n  color: var(--teal);\n  background: var(--panel-3);\n  border-color: #a8cec7;\n}\n.vintage-gap__searches {\n  display: grid;\n  grid-template-columns: minmax(220px, 0.72fr) minmax(320px, 1.28fr);\n  gap: 10px;\n}\n.vintage-gap__searches label {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n}\n.vintage-gap__searches span {\n  color: var(--faint);\n  font: 8px var(--mono);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.vintage-gap__searches input {\n  min-width: 0;\n  height: 30px;\n  padding: 0 9px;\n  color: var(--text);\n  background: white;\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 10px var(--mono);\n}\n.vintage-gap__workspace {\n  display: grid;\n  grid-template-columns: minmax(300px, 0.72fr) minmax(650px, 1.55fr);\n  min-height: 0;\n  overflow: hidden;\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n}\n.vintage-gap__brands,\n.vintage-gap__parents {\n  display: grid;\n  min-width: 0;\n  min-height: 0;\n  background: white;\n}\n.vintage-gap__brands {\n  grid-template-rows: auto minmax(0, 1fr);\n  border-right: 1px solid var(--hairline);\n}\n.vintage-gap__parents {\n  grid-template-rows: auto auto minmax(0, 1fr) auto;\n}\n.vintage-gap__brands > header,\n.vintage-gap__parents > header {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 10px;\n  min-height: 50px;\n  padding: 9px 11px;\n  background: var(--panel-2);\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.vintage-gap__brands h3,\n.vintage-gap__parents h3 {\n  margin: 1px 0 0;\n  font: 600 15px / 1.1 var(--display);\n}\n.vintage-gap__brands header > span,\n.vintage-gap__parents header > span {\n  color: var(--faint);\n  font: 8px / 1.25 var(--mono);\n  text-align: right;\n}\n.vintage-gap__brand-list,\n.vintage-gap__parent-list {\n  min-height: 0;\n  overflow: auto;\n  scrollbar-color: #bccbc7 transparent;\n  scrollbar-width: thin;\n}\n.vintage-gap__brand {\n  display: grid;\n  width: 100%;\n  gap: 5px;\n  padding: 8px 10px;\n  color: var(--text);\n  background: white;\n  border: 0;\n  border-bottom: 1px solid var(--hairline-soft);\n  text-align: left;\n}\nbutton.vintage-gap__brand:hover,\nbutton.vintage-gap__brand.is-selected {\n  background: #f0f8f6;\n  box-shadow: inset 3px 0 var(--teal);\n}\n.vintage-gap__brand > span {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  align-items: baseline;\n}\n.vintage-gap__brand > span strong {\n  overflow: hidden;\n  font-size: 11px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.vintage-gap__brand > span b {\n  flex: 0 0 auto;\n  color: var(--teal);\n  font: 600 10px var(--mono);\n}\n.vintage-gap__brand > i {\n  display: block;\n  height: 5px;\n  overflow: hidden;\n  background: #e7eeec;\n  border-radius: 1px;\n}\n.vintage-gap__brand > i em {\n  display: block;\n  height: 100%;\n  background: var(--teal);\n}\n.vintage-gap__brand small {\n  overflow: hidden;\n  color: var(--faint);\n  font: 7.5px / 1.3 var(--mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.vintage-gap__other {\n  background: var(--panel-2);\n}\n.vintage-gap__other > i em {\n  background: var(--faint);\n}\n.vintage-gap__parent-head,\n.vintage-gap__parent-row {\n  display: grid;\n  grid-template-columns: minmax(145px, 1.3fr) 0.48fr 0.78fr 0.78fr 0.72fr 0.38fr;\n  gap: 8px;\n  align-items: center;\n}\n.vintage-gap__parent-head {\n  min-height: 34px;\n  padding: 5px 9px;\n  color: var(--faint);\n  background: #fafcfc;\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 7.5px / 1.25 var(--mono);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.vintage-gap__parent-head > :not(:first-child) {\n  text-align: right;\n}\n.vintage-gap__parent-row {\n  width: 100%;\n  min-height: 43px;\n  padding: 5px 9px;\n  color: var(--text);\n  background: white;\n  border: 0;\n  border-bottom: 1px solid var(--hairline-soft);\n  text-align: left;\n}\nbutton.vintage-gap__parent-row:hover,\nbutton.vintage-gap__parent-row.is-selected {\n  background: #f4f9f8;\n  box-shadow: inset 3px 0 var(--teal);\n}\n.vintage-gap__parent-row > span:first-child {\n  min-width: 0;\n}\n.vintage-gap__parent-row > span:first-child strong,\n.vintage-gap__parent-row > span:first-child small {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.vintage-gap__parent-row > span:first-child strong {\n  font: 600 10px var(--mono);\n}\n.vintage-gap__parent-row > span:first-child small {\n  margin-top: 2px;\n  color: var(--faint);\n  font-size: 8px;\n}\n.vintage-gap__parent-row > b,\n.vintage-gap__parent-row > span:not(:first-child),\n.vintage-gap__parent-row > strong,\n.vintage-gap__parent-row > em {\n  font: 9px / 1.2 var(--mono);\n  font-style: normal;\n  text-align: right;\n}\n.vintage-gap__parent-row > span:not(:first-child) i {\n  margin: 0 4px;\n  color: var(--faint);\n  font-style: normal;\n}\n.vintage-gap__parent-row > strong {\n  color: var(--teal);\n  font-weight: 600;\n}\n.vintage-gap__parent-row > strong small {\n  display: block;\n  margin-top: 2px;\n  color: var(--faint);\n  font: 7px / 1.2 var(--mono);\n}\n.vintage-gap__parent-row--other {\n  background: var(--panel-2);\n}\n.vintage-gap__parent-detail {\n  display: grid;\n  grid-template-columns: minmax(220px, 1fr) minmax(330px, 1.1fr) auto;\n  gap: 14px;\n  align-items: center;\n  min-height: 76px;\n  padding: 8px 11px;\n  background: #f4f8f7;\n  border-top: 1px solid var(--hairline);\n}\n.vintage-gap__parent-detail h4 {\n  margin: 2px 0 3px;\n  overflow: hidden;\n  font: 600 13px / 1.15 var(--display);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.vintage-gap__parent-detail > div > span {\n  color: var(--muted);\n  font: 8px / 1.25 var(--mono);\n}\n.vintage-gap__parent-detail dl {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  margin: 0;\n}\n.vintage-gap__parent-detail dl > div {\n  padding: 2px 10px;\n  border-left: 1px solid var(--hairline);\n}\n.vintage-gap__parent-detail dt {\n  color: var(--faint);\n  font: 7px / 1.2 var(--mono);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.vintage-gap__parent-detail dd {\n  margin: 4px 0 0;\n  font: 600 11px / 1 var(--mono);\n}\n.vintage-gap__parent-detail .btn {\n  white-space: nowrap;\n}\n.vintage-gap__empty {\n  margin: auto;\n  padding: 24px;\n  color: var(--faint);\n  font: 9px / 1.5 var(--mono);\n  text-align: center;\n}\n.vintage-gap__foot {\n  color: var(--faint);\n  font: 7.5px / 1.3 var(--mono);\n  text-align: center;\n}\n.vintage-gap-dialog button:focus-visible,\n.vintage-gap-dialog input:focus-visible {\n  outline: 2px solid var(--teal);\n  outline-offset: 2px;\n}\n.vintage-gap-dialog[data-gap-mode=\"regressions\"] .vintage-gap__brand > span b,\n.vintage-gap-dialog[data-gap-mode=\"regressions\"]\n  .vintage-gap__parent-row\n  > strong {\n  color: var(--red);\n}\n.vintage-gap-dialog[data-gap-mode=\"regressions\"] .vintage-gap__brand > i em {\n  background: var(--red);\n}\n@media (max-height: 760px) {\n  .vintage-gap-dialog {\n    padding: 8px;\n  }\n  .vintage-gap-dialog__panel {\n    width: calc(100vw - 16px);\n    height: calc(100vh - 16px);\n  }\n  .vintage-gap-dialog__head {\n    padding: 11px 15px 9px;\n  }\n  .vintage-gap-dialog__head h2 {\n    font-size: 19px;\n  }\n  .vintage-gap-dialog__head p:last-child {\n    margin-top: 3px;\n    font-size: 10px;\n  }\n  .vintage-gap-dialog__body {\n    gap: 7px;\n    padding: 8px 10px 7px;\n  }\n  .vintage-gap__summary > div {\n    padding: 7px 9px;\n  }\n  .vintage-gap__summary strong {\n    font-size: 17px;\n  }\n  .vintage-gap__toolbar button {\n    padding: 6px 8px;\n    font-size: 8px;\n  }\n  .vintage-gap__brand {\n    gap: 3px;\n    padding: 6px 8px;\n  }\n  .vintage-gap__parent-row {\n    min-height: 37px;\n    padding-block: 4px;\n  }\n  .vintage-gap__parent-detail {\n    min-height: 62px;\n    padding-block: 6px;\n  }\n}\n\n.has-revision-effectiveness-dialog {\n  overflow: hidden;\n}\n.revision-effectiveness-dialog {\n  position: fixed;\n  inset: 0;\n  z-index: 70;\n  display: grid;\n  place-items: center;\n  padding: 30px;\n  background: rgba(18, 31, 28, 0.48);\n  backdrop-filter: blur(2.5px) saturate(0.8);\n}\n.revision-effectiveness-dialog__panel {\n  position: relative;\n  width: min(1060px, calc(100vw - 60px));\n  max-height: calc(100vh - 60px);\n  overflow: auto;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 9px;\n  box-shadow: 0 28px 80px rgba(15, 34, 29, 0.22);\n}\n.revision-effectiveness-dialog__panel::before {\n  position: absolute;\n  inset: 0 0 auto;\n  height: 3px;\n  background: linear-gradient(90deg, var(--teal), #6cb8ae 68%, transparent);\n  border-radius: 9px 9px 0 0;\n  content: \"\";\n}\n.revision-effectiveness-dialog__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 22px;\n  padding: 20px 24px 16px;\n  border-bottom: 1px solid var(--hairline);\n}\n.revision-effectiveness-dialog__head h2 {\n  margin: 0;\n  font: 600 22px / 1.12 var(--display);\n}\n.revision-effectiveness-dialog__head p:last-child {\n  margin: 7px 0 0;\n  color: var(--muted);\n  font-size: 13px;\n}\n.revision-effectiveness-dialog__body {\n  padding: 19px 24px 22px;\n}\n.revision-effectiveness__summary {\n  display: grid;\n  grid-template-columns: 150px minmax(300px, 0.9fr) minmax(360px, 1.2fr);\n  gap: 24px;\n  align-items: start;\n}\n.revision-effectiveness__score {\n  min-height: 164px;\n  padding-right: 20px;\n  border-right: 1px solid var(--hairline);\n}\n.revision-effectiveness__score strong {\n  display: block;\n  color: var(--teal);\n  font: 600 56px / 0.9 var(--display);\n  letter-spacing: -0.04em;\n}\n.revision-effectiveness__score span {\n  display: block;\n  margin-top: 4px;\n  color: var(--faint);\n  font: 600 9px / 1.35 var(--mono);\n  letter-spacing: 0.13em;\n  text-transform: uppercase;\n}\n.revision-effectiveness__score em {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 12px;\n  padding: 5px 8px;\n  color: var(--teal);\n  background: var(--panel-3);\n  border: 1px solid #a8cec7;\n  border-radius: 4px;\n  font: 600 9px / 1 var(--mono);\n  font-style: normal;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.revision-effectiveness__score em::before {\n  width: 7px;\n  height: 7px;\n  background: currentcolor;\n  border-radius: 50%;\n  content: \"\";\n}\n.revision-effectiveness[data-effectiveness-tone=\"mixed\"]\n  .revision-effectiveness__score\n  strong,\n.revision-effectiveness[data-effectiveness-tone=\"mixed\"]\n  .revision-effectiveness__score\n  em {\n  color: var(--amber);\n}\n.revision-effectiveness[data-effectiveness-tone=\"harmful\"]\n  .revision-effectiveness__score\n  strong,\n.revision-effectiveness[data-effectiveness-tone=\"harmful\"]\n  .revision-effectiveness__score\n  em {\n  color: var(--red);\n}\n.revision-effectiveness__components {\n  display: grid;\n  gap: 13px;\n}\n.revision-effectiveness__component {\n  display: grid;\n  gap: 6px;\n}\n.revision-effectiveness__component-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  font-weight: 600;\n}\n.revision-effectiveness__component-head b {\n  font: 600 13px / 1 var(--mono);\n}\n.revision-effectiveness__track {\n  height: 9px;\n  overflow: hidden;\n  background: #e4ebe9;\n  border: 1px solid #d6e0dd;\n  border-radius: 2px;\n}\n.revision-effectiveness__track i {\n  display: block;\n  height: 100%;\n  background: var(--teal);\n}\n.revision-effectiveness__component small {\n  color: var(--faint);\n  font: 9px / 1.35 var(--mono);\n}\n.revision-effectiveness__evolution .eyebrow {\n  margin-bottom: 8px;\n}\n.revision-effectiveness__evolution svg {\n  display: block;\n  width: 100%;\n  height: 150px;\n  border-bottom: 1px solid var(--hairline);\n}\n.revision-effectiveness__evolution svg > path {\n  fill: none;\n  stroke: var(--teal);\n  stroke-width: 2.5;\n}\n.revision-effectiveness__micro-grid line {\n  stroke: var(--hairline-soft);\n}\n.revision-effectiveness__micro-points circle {\n  fill: var(--panel);\n  stroke: var(--teal);\n  stroke-width: 2;\n}\n.revision-effectiveness__micro-points text {\n  fill: var(--muted);\n  font: 9px var(--mono);\n}\n.revision-effectiveness__evolution > div {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 7px;\n  color: var(--faint);\n  font: 9px / 1.35 var(--mono);\n}\n.revision-effectiveness__metrics {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  margin: 18px 0 0;\n  overflow: hidden;\n  border: 1px solid var(--hairline);\n  border-radius: 6px;\n}\n.revision-effectiveness__metrics > div {\n  min-width: 0;\n  padding: 12px 13px;\n  background: #fbfcfc;\n  border-right: 1px solid var(--hairline-soft);\n}\n.revision-effectiveness__metrics > div:last-child {\n  border-right: 0;\n}\n.revision-effectiveness__metrics dt {\n  margin-bottom: 5px;\n  color: var(--faint);\n  font: 8.5px / 1.3 var(--mono);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.revision-effectiveness__metrics dd {\n  margin: 0;\n  font: 600 17px / 1.1 var(--display);\n}\n.revision-effectiveness__evidence {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px 16px;\n  margin-top: 12px;\n  padding: 10px 13px;\n  color: var(--muted);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 5px;\n  font: 9px / 1.4 var(--mono);\n}\n.revision-effectiveness__evidence b {\n  color: var(--text);\n}\n@media (max-width: 1080px) {\n  .revision-effectiveness__summary {\n    grid-template-columns: 145px 1fr;\n  }\n  .revision-effectiveness__evolution {\n    grid-column: 1 / -1;\n  }\n  .revision-effectiveness__metrics {\n    grid-template-columns: repeat(3, 1fr);\n  }\n  .revision-effectiveness__metrics > div:nth-child(3) {\n    border-right: 0;\n  }\n  .revision-effectiveness__metrics > div:nth-child(n + 4) {\n    border-top: 1px solid var(--hairline-soft);\n  }\n}\n@media (max-width: 1080px) and (max-height: 760px) {\n  .revision-effectiveness-dialog {\n    padding: 12px;\n  }\n  .revision-effectiveness-dialog__panel {\n    max-height: calc(100vh - 24px);\n  }\n  .revision-effectiveness-dialog__head {\n    padding: 13px 18px 10px;\n  }\n  .revision-effectiveness-dialog__head h2 {\n    font-size: 18px;\n  }\n  .revision-effectiveness-dialog__head p:last-child {\n    margin-top: 4px;\n    font-size: 11px;\n  }\n  .revision-effectiveness-dialog__body {\n    padding: 12px 18px 14px;\n  }\n  .revision-effectiveness__summary {\n    gap: 13px;\n  }\n  .revision-effectiveness__score {\n    min-height: 135px;\n  }\n  .revision-effectiveness__components {\n    gap: 8px;\n  }\n  .revision-effectiveness__evolution svg {\n    height: 100px;\n  }\n  .revision-effectiveness__metrics {\n    margin-top: 10px;\n  }\n  .revision-effectiveness__metrics > div {\n    padding: 8px 10px;\n  }\n  .revision-effectiveness__metrics dd {\n    font-size: 15px;\n  }\n  .revision-effectiveness__evidence {\n    margin-top: 8px;\n    padding: 7px 9px;\n  }\n}\n.population-table {\n  display: grid;\n  align-content: center;\n  min-height: 0;\n  padding: 2px 8px 8px;\n}\n.population-table > div {\n  display: grid;\n  grid-template-columns: 1fr 0.55fr 0.8fr 1fr;\n  gap: 6px;\n  align-items: center;\n  min-height: 28px;\n  padding: 5px 2px;\n  color: var(--muted);\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 400 8px / 1.2 var(--mono);\n}\n.population-table > div:first-child {\n  color: var(--faint);\n  font-size: 7px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.population-table em,\n.population-table i {\n  font-style: normal;\n}\n.revision-queue {\n  flex: 0 0 auto;\n  min-height: 360px;\n}\n.revision-queue__toolbar {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 10px;\n  background: var(--panel-2);\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.revision-queue__toolbar label {\n  display: grid;\n  gap: 3px;\n  width: min(430px, 100%);\n  color: var(--faint);\n  font: 600 8px / 1.2 var(--mono);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.revision-queue__toolbar input {\n  width: 100%;\n  min-height: 31px;\n  padding: 5px 9px;\n  color: var(--text);\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 500 10px / 1.2 var(--mono);\n}\n.revision-queue__toolbar > span {\n  padding-bottom: 7px;\n  color: var(--faint);\n  font: 400 8px / 1.2 var(--mono);\n}\n.revision-queue__body {\n  display: block;\n  max-height: 360px;\n  min-height: 0;\n  overflow: auto;\n  scrollbar-gutter: stable;\n}\n.revision-queue__head,\n.revision-queue__row {\n  display: grid;\n  grid-template-columns: 0.62fr 1.75fr 1.22fr 0.72fr 0.82fr 1.18fr;\n  align-items: center;\n  gap: 9px;\n  min-width: 960px;\n  min-height: 52px;\n  padding: 6px 10px;\n  border-bottom: 1px solid var(--hairline-soft);\n  color: var(--muted);\n  font: 400 9px / 1.25 var(--mono);\n}\n.revision-queue__head {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  color: var(--faint);\n  background: var(--bg-2);\n  font-size: 8px;\n  font-weight: 600;\n  letter-spacing: 0.055em;\n  text-transform: uppercase;\n}\n.revision-queue__head button {\n  min-width: 0;\n  padding: 3px 0;\n  overflow: hidden;\n  color: inherit;\n  background: transparent;\n  border: 0;\n  font: inherit;\n  letter-spacing: inherit;\n  text-align: left;\n  text-overflow: ellipsis;\n  text-transform: inherit;\n  white-space: nowrap;\n}\n.revision-queue__head button:hover,\n.revision-queue__head button[aria-pressed=\"true\"] {\n  color: var(--teal);\n}\n.revision-queue__row:last-child {\n  border-bottom: 0;\n}\n.revision-queue__row > * {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.revision-queue__row strong {\n  color: var(--text);\n}\n.revision-queue__material {\n  display: grid;\n  gap: 2px;\n  white-space: normal;\n}\n.revision-queue__material em {\n  overflow: hidden;\n  color: var(--faint);\n  font-style: normal;\n  line-height: 1.2;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.revision-queue__row .bad {\n  display: grid;\n  gap: 2px;\n}\n.revision-queue__row .bad small {\n  color: var(--faint);\n  font-size: 7.5px;\n  font-weight: 400;\n}\n.revision-queue__sparkline {\n  display: grid;\n  min-width: 0;\n  overflow: visible;\n}\n.revision-queue__sparkline svg {\n  display: block;\n  width: 100%;\n  height: 38px;\n  overflow: visible;\n}\n.revision-queue__sparkline-zero {\n  stroke: var(--hairline);\n  stroke-width: 1;\n  stroke-dasharray: 2 3;\n}\n.revision-queue__sparkline-line {\n  fill: none;\n  stroke: var(--teal);\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n.revision-queue__sparkline-point {\n  fill: var(--panel);\n  stroke: var(--teal);\n  stroke-width: 1.5;\n}\n.revision-queue__sparkline-point--improved {\n  stroke: var(--series-vintage-b);\n}\n.revision-queue__sparkline-point--worsened {\n  stroke: var(--red);\n}\n.revision-queue__sparkline-point--neutral,\n.revision-queue__sparkline-point--unchanged {\n  stroke: var(--faint);\n}\n.revision-queue__sparkline-point:hover,\n.revision-queue__sparkline-point:focus-visible {\n  fill: var(--panel-3);\n  stroke-width: 2.4;\n  outline: none;\n}\n.revision-queue__sparkline-range {\n  display: flex;\n  justify-content: space-between;\n  margin-top: -3px;\n  color: var(--faint);\n  font-size: 7px;\n}\n.revision-queue__sparkline-range i {\n  overflow: hidden;\n  font-style: normal;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.revision-queue__sparkline small,\n.revision-queue__sparkline-empty {\n  margin-top: 1px;\n  overflow: hidden;\n  color: var(--faint);\n  font-size: 7px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.comparison-alert,\n.blocking {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 10px;\n  min-height: 31px;\n  padding: 5px 9px;\n  color: var(--muted);\n  background: #f8fbfa;\n  border: 1px solid var(--hairline);\n  border-radius: 6px;\n  font: 400 8px / 1.25 var(--mono);\n}\n.comparison-alert strong,\n.blocking strong {\n  color: var(--text);\n}\n.source-compare-kpis {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: 1fr 1fr 1.15fr;\n  gap: 9px;\n}\n.source-card {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 6px;\n  min-width: 0;\n  padding: 8px 9px;\n  border-radius: 7px;\n}\n.source-card header {\n  display: flex;\n  grid-column: 1 / -1;\n  align-items: center;\n  gap: 7px