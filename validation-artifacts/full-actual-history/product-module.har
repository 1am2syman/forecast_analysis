ne);\n  border-radius: 4px;\n  font: 500 8.5px / 1.2 var(--mono);\n  cursor: pointer;\n}\n.product-picker__trigger span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.product-picker__trigger i {\n  width: 6px;\n  height: 6px;\n  border-right: 1px solid currentColor;\n  border-bottom: 1px solid currentColor;\n  transform: translateY(-2px) rotate(45deg);\n  transition: transform 140ms ease;\n}\n.product-picker.is-open .product-picker__trigger {\n  border-color: var(--teal);\n  box-shadow: 0 0 0 1px var(--teal-dim);\n}\n.product-picker.is-open .product-picker__trigger i {\n  transform: translateY(2px) rotate(225deg);\n}\n.product-picker__popover {\n  position: absolute;\n  top: calc(100% + 5px);\n  left: 0;\n  z-index: 45;\n  display: grid;\n  width: min(390px, calc(100vw - 64px));\n  gap: 7px;\n  padding: 9px;\n  background: var(--panel);\n  border: 1px solid var(--teal-dim);\n  border-radius: 6px;\n  box-shadow: 0 12px 28px rgba(23, 36, 33, 0.2);\n}\n.product-picker__popover[hidden] {\n  display: none;\n}\n.product-picker__search {\n  display: grid;\n  gap: 4px;\n  color: var(--faint);\n  font: 600 8px / 1.2 var(--mono);\n}\n.product-picker__search input {\n  width: 100%;\n  height: 30px;\n  padding: 5px 7px;\n  color: var(--text);\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 500 8px / 1.2 var(--mono);\n}\n.product-picker__status {\n  color: var(--faint);\n  font: 500 7.5px / 1.2 var(--mono);\n}\n.product-picker__options {\n  display: grid;\n  max-height: 240px;\n  overflow: auto;\n  overscroll-behavior: contain;\n  border-top: 1px solid var(--hairline-soft);\n}\n.product-picker__option {\n  display: grid;\n  grid-template-columns: 17px minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 4px;\n  color: var(--text);\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 500 8px / 1.25 var(--mono);\n  cursor: pointer;\n}\n.product-picker__option i {\n  display: grid;\n  place-items: center;\n  width: 14px;\n  height: 14px;\n  color: #fff;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 3px;\n  font: 700 9px / 1 var(--mono);\n}\n.product-picker__option:hover,\n.product-picker__option[aria-selected=\"true\"] {\n  background: var(--panel-3);\n}\n.product-picker__option[aria-selected=\"true\"] i {\n  background: var(--teal);\n  border-color: var(--teal);\n}\n.product-picker__empty {\n  margin: 0;\n  padding: 14px 4px;\n  color: var(--faint);\n  font: 500 8px / 1.3 var(--mono);\n  text-align: center;\n}\n.product-picker__trigger:focus-visible,\n.product-picker__search input:focus-visible,\n.product-picker__option:focus-visible {\n  outline: 2px solid var(--amber);\n  outline-offset: 2px;\n}\n.field__readout {\n  overflow: hidden;\n  color: var(--text);\n  font: 600 9px / 1.25 var(--mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.product-summary {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: 0.6fr 1.45fr 0.8fr 0.65fr 0.65fr 1.4fr;\n  min-height: 36px;\n  overflow: hidden;\n  border-radius: 6px;\n}\n.history-context {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: minmax(255px, 1.35fr) minmax(128px, 0.65fr) minmax(0, 3fr);\n  min-width: 0;\n  min-height: 50px;\n  align-items: stretch;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n  box-shadow: var(--panel-shadow);\n}\n.history-context .history-toolbar {\n  min-width: 0;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 0;\n  border-right: 1px solid var(--hairline-soft);\n}\n.history-context .history-toolbar .field {\n  min-height: 48px;\n  padding: 5px 9px;\n  border: 0;\n  border-radius: 0;\n  box-shadow: none;\n}\n.history-context .product-summary {\n  grid-template-columns: minmax(0, 1.1fr) minmax(54px, 0.7fr);\n  min-width: 0;\n  min-height: 48px;\n  overflow: hidden;\n  border: 0;\n  border-right: 1px solid var(--hairline-sof