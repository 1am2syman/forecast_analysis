            "mimeType": "text/css",
            "size": 175922,
            "text": "/* Forecast performance · canonical real-data dashboard */\n\n@font-face {\n  font-family: \"Chakra Petch\";\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"fonts/chakra-petch-600.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Mono\";\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-mono-400.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Mono\";\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-mono-500.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Mono\";\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-mono-600.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Sans\";\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-sans-400.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Sans\";\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-sans-500.ttf\") format(\"truetype\");\n}\n@font-face {\n  font-family: \"IBM Plex Sans\";\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"fonts/ibm-plex-sans-600.ttf\") format(\"truetype\");\n}\n\n:root {\n  color-scheme: light;\n  --bg: #edf3f1;\n  --bg-2: #f4f7f6;\n  --panel: #ffffff;\n  --panel-2: #eef3f1;\n  --panel-3: #e8f3f0;\n  --hairline: #c8d5d1;\n  --hairline-soft: #dbe4e1;\n  --teal: #087f75;\n  --teal-dim: #69aaa3;\n  --teal-glow: rgba(8, 127, 117, 0.2);\n  --amber: #9a5e00;\n  --amber-dim: #d9b677;\n  --red: #b63b35;\n  --red-dim: #dda7a3;\n  --blue: #2e79a5;\n  --series-actual: #1e3a8a;\n  --series-vintage-a: #d6b98c;\n  --series-vintage-b: #15803d;\n  --text: #172421;\n  --muted: #536762;\n  --faint: #586b66;\n  --faint-2: #5d6f6a;\n  --panel-shadow: 0 1px 2px rgba(23, 36, 33, 0.055);\n  --display: \"Chakra Petch\", system-ui, sans-serif;\n  --body: \"IBM Plex Sans\", system-ui, sans-serif;\n  --mono: \"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", monospace;\n  --topbar-h: 56px;\n  --statusbar-h: 30px;\n  --scopebar-h: 48px;\n  --rail-w: 232px;\n  --rail-collapsed-w: 72px;\n  --ease: cubic-bezier(0.22, 0.61, 0.36, 1);\n}\n\n* {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml,\nbody {\n  margin: 0;\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  color: var(--text);\n  background: var(--bg);\n  background-image:\n    radial-gradient(\n      900px 460px at 84% -12%,\n      rgba(8, 127, 117, 0.08),\n      transparent 62%\n    ),\n    radial-gradient(\n      640px 420px at -6% 110%,\n      rgba(154, 94, 0, 0.045),\n      transparent 60%\n    ),\n    repeating-linear-gradient(\n      0deg,\n      rgba(23, 36, 33, 0.025) 0 1px,\n      transparent 1px 34px\n    ),\n    repeating-linear-gradient(\n      90deg,\n      rgba(23, 36, 33, 0.025) 0 1px,\n      transparent 1px 34px\n    );\n  font: 14px / 1.5 var(--body);\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\nselect,\ninput {\n  font: inherit;\n}\n\nbutton,\nselect,\ninput[type=\"checkbox\"] {\n  cursor: pointer;\n}\n\n::selection {\n  color: var(--text);\n  background: rgba(8, 127, 117, 0.18);\n}\n\n:focus-visible {\n  outline: 2px solid var(--teal);\n  outline-offset: 2px;\n  border-radius: 4px;\n}\n\n.app {\n  display: grid;\n  grid-template-rows: var(--topbar-h) 1fr var(--statusbar-h);\n  height: 100vh;\n  min-width: 0;\n}\n\n.body {\n  display: grid;\n  grid-template-columns: var(--rail-w) minmax(0, 1fr);\n  min-height: 0;\n  background: var(--bg-2);\n  border-top: 1px solid var(--hairline-soft);\n  border-bottom: 1px solid var(--hairline-soft);\n  transition: grid-template-columns 0.2s var(--ease);\n}\n.body.is-rail-collapsed {\n  grid-template-columns: var(--rail-collapsed-w) minmax(0, 1fr);\n}\n\n.lamp {\n  flex: 0 0 auto;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--faint-2);\n  box-shadow: 0 0 0 1px rgba(23, 36, 33, 0.18);\n}\n.lamp--live {\n  background: var(--teal);\n  box-shadow:\n    0 0 8px var(--teal-glow),\n    0 0 0 1px rgba(23, 36, 33, 0.18);\n}\n.lamp--warn {\n  background: var(--amber);\n  box-shadow:\n    0 0 8px rgba(154, 94, 0, 0.2),\n    0 0 0 1px rgba(23, 36, 33, 0.18);\n}\n\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 0 16px;\n  background: var(--panel);\n  border-bottom: 1px solid var(--hairline);\n}\n.topbar__sig,\n.topbar__right {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n.topbar__sig {\n  gap: 12px;\n}\n.topbar__right {\n  gap: 8px;\n}\n.topbar__title {\n  margin: 0;\n  color: #10201c;\n  font: 600 19px / 1 var(--display);\n  letter-spacing: 0.005em;\n  white-space: nowrap;\n}\n.topbar__ctx {\n  padding-left: 12px;\n  color: var(--faint);\n  border-left: 1px solid var(--hairline);\n  font: 400 10px / 1.4 var(--mono);\n  letter-spacing: 0.05em;\n  white-space: nowrap;\n}\n.refresh {\n  color: var(--faint);\n  font: 400 9px / 1.3 var(--mono);\n  letter-spacing: 0.035em;\n  white-space: nowrap;\n}\n.topbar__sig .lamp--live {\n  animation: breathe 3.2s ease-in-out infinite;\n}\n\n.chip,\n.btn {\n  font-family: var(--mono);\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.chip {\n  padding: 3px 8px;\n  color: var(--muted);\n  background: rgba(23, 36, 33, 0.035);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font-size: 10px;\n  letter-spacing: 0.11em;\n}\n.chip--live {\n  color: #076d62;\n  background: #e4f2ef;\n  border-color: #a8cec7;\n}\n.btn {\n  min-height: 29px;\n  padding: 5px 11px;\n  color: var(--muted);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font-size: 9.5px;\n  letter-spacing: 0.08em;\n  transition:\n    color 0.15s var(--ease),\n    border-color 0.15s var(--ease),\n    background 0.15s var(--ease);\n}\n.btn:hover,\n.btn--accent[aria-expanded=\"true\"] {\n  color: var(--text);\n  background: var(--panel-3);\n  border-color: var(--teal-dim);\n}\n.btn--accent {\n  color: var(--teal);\n  background: rgba(8, 127, 117, 0.07);\n  border-color: #9fc8c1;\n}\n\n.rail {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  padding: 14px 10px 12px;\n  overflow: hidden;\n  background: var(--panel);\n  border-right: 1px solid var(--hairline);\n}\n.rail__head {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 24px;\n  margin: 0 2px 8px 8px;\n}\n.rail__label {\n  margin: 0;\n  color: var(--faint-2);\n  font: 400 10px / 1.4 var(--mono);\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n}\n.rail__toggle {\n  display: grid;\n  flex: 0 0 auto;\n  width: 26px;\n  height: 26px;\n  padding: 0;\n  place-items: center;\n  color: var(--faint);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline);\n  border-radius: 5px;\n  transition:\n    color 0.15s var(--ease),\n    background 0.15s var(--ease),\n    border-color 0.15s var(--ease);\n}\n.rail__toggle:hover {\n  color: var(--teal);\n  background: var(--panel-3);\n  border-color: var(--teal-dim);\n}\n.rail__toggle svg {\n  width: 14px;\n  height: 14px;\n  fill: none;\n  stroke: currentcolor;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 1.8;\n  transition: transform 0.2s var(--ease);\n}\n.rail__list {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: 5px;\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n.tab {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  min-height: 44px;\n  padding: 9px 10px 9px 12px;\n  color: var(--muted);\n  text-align: left;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  transition:\n    background 0.16s var(--ease),\n    color 0.16s var(--ease);\n}\n.tab::before {\n  position: absolute;\n  top: 22%;\n  bottom: 22%;\n  left: -10px;\n  width: 2px;\n  content: \"\";\n  background: var(--teal);\n  border-radius: 0 2px 2px 0;\n  opacity: 0;\n}\n.tab:hover {\n  color: var(--text);\n  background: rgba(8, 127, 117, 0.055);\n}\n.tab.is-active {\n  color: var(--text);\n  background: var(--panel-3);\n  border-color: var(--hairline);\n}\n.tab.is-active::before {\n  opacity: 1;\n}\n.tab.is-active .tab__name {\n  color: #10201c;\n}\n.tab.is-active .lamp--live {\n  animation: breathe 3.2s ease-in-out infinite;\n}\n.tab__icon {\n  display: none;\n  flex: 0 0 auto;\n  color: currentcolor;\n}\n.tab__icon svg {\n  width: 20px;\n  height: 20px;\n  fill: none;\n  stroke: currentcolor;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 1.65;\n}\n.tab__icon rect {\n  fill: none;\n}\n.tab__icon--warn {\n  color: var(--amber);\n}\n.tab__copy {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  min-width: 0;\n}\n.tab__name,\n.tab__meta,\n.tab__badge {\n  font-family: var(--mono);\n  white-space: nowrap;\n}\n.tab__name {\n  overflow: hidden;\n  font-size: 11.5px;\n  font-weight: 500;\n  letter-spacing: 0.045em;\n  text-overflow: ellipsis;\n}\n.tab__meta {\n  min-width: 0;\n  margin-top: 2px;\n  overflow: hidden;\n  color: var(--faint);\n  font-size: 8.5px;\n  line-height: 1.25;\n  letter-spacing: 0.045em;\n  text-overflow: ellipsis;\n}\n.tab__badge {\n  padding: 1px 5px;\n  margin-left: auto;\n  color: var(--amber);\n  background: rgba(154, 94, 0, 0.09);\n  border: 1px solid var(--amber-dim);\n  border-radius: 4px;\n  font-size: 9px;\n  font-weight: 600;\n}\n.rail__foot {\n  padding-top: 10px;\n  margin-top: 12px;\n  color: var(--faint-2);\n  border-top: 1px solid var(--hairline-soft);\n  font: 400 9px / 1.6 var(--mono);\n  letter-spacing: 0.07em;\n  text-transform: uppercase;\n}\n.body.is-rail-collapsed .rail {\n  padding-right: 8px;\n  padding-left: 8px;\n}\n.body.is-rail-collapsed .rail__head {\n  justify-content: center;\n  margin-right: 0;\n  margin-left: 0;\n}\n.body.is-rail-collapsed .rail__label,\n.body.is-rail-collapsed .tab__copy,\n.body.is-rail-collapsed .tab__name,\n.body.is-rail-collapsed .tab__meta,\n.body.is-rail-collapsed .tab__badge,\n.body.is-rail-collapsed .tab > .lamp,\n.body.is-rail-collapsed .rail__foot {\n  display: none;\n}\n.body.is-rail-collapsed .rail__toggle svg {\n  transform: rotate(180deg);\n}\n.body.is-rail-collapsed .tab {\n  justify-content: center;\n  gap: 0;\n  padding-right: 6px;\n  padding-left: 6px;\n}\n.body.is-rail-collapsed .tab__icon {\n  display: grid;\n  place-items: center;\n}\n.body.is-rail-collapsed .tab.is-active .tab__icon {\n  color: var(--teal);\n}\n.body.is-rail-collapsed .tab.is-active .tab__icon--warn {\n  color: var(--amber);\n}\n\n.workspace {\n  position: relative;\n  display: grid;\n  grid-template-rows: var(--scopebar-h) minmax(0, 1fr);\n  min-width: 0;\n  min-height: 0;\n}\n.workspace.has-state {\n  grid-template-rows: var(--scopebar-h) 34px minmax(0, 1fr);\n}\n\n.scopebar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  min-width: 0;\n  padding: 6px 18px;\n  background: #fbfdfc;\n  border-bottom: 1px solid var(--hairline);\n}\n.scopebar__primary,\n.scopebar__audit {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n.scopebar__primary {\n  gap: 6px;\n}\n.scopebar__overview-title,\n.scopebar__overview-stamp {\n  display: none;\n}\n.workspace.is-overview .scopebar {\n  justify-content: flex-start;\n  gap: 10px;\n}\n.workspace.is-overview .scopebar__overview-title {\n  display: block;\n  flex: 0 0 auto;\n}\n.scopebar__overview-title h2 {\n  margin: 0;\n  color: #10201c;\n  font: 600 17px / 1.1 var(--display);\n  letter-spacing: -0.01em;\n  white-space: nowrap;\n}\n.workspace.is-overview .scopebar__primary {\n  flex: 1 1 auto;\n  overflow: hidden;\n}\n.workspace.is-overview .scopebar__overview-stamp {\n  display: block;\n  flex: 0 0 auto;\n  color: var(--faint);\n  font: 400 8px / 1.2 var(--mono);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.workspace.is-overview .scopebar__audit {\n  display: none;\n}\n.scopebar__audit {\n  gap: 13px;\n  margin-left: auto;\n  color: var(--faint);\n  font: 400 8.5px / 1.25 var(--mono);\n  white-space: nowrap;\n}\n.scopebar__audit b {\n  color: var(--muted);\n  font-weight: 600;\n  text-transform: uppercase;\n}\n.scope-token {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 7px;\n  color: var(--faint);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  font: 400 8.5px / 1.25 var(--mono);\n  white-space: nowrap;\n}\n.scope-token b {\n  color: var(--faint-2);\n  font-weight: 500;\n  text-transform: uppercase;\n}\n.scope-token strong {\n  color: var(--text);\n  font-weight: 600;\n}\n\n.scope-drawer {\n  position: absolute;\n  top: calc(var(--scopebar-h) - 1px);\n  right: 14px;\n  left: 14px;\n  z-index: 20;\n  padding: 14px;\n  background: rgba(255, 255, 255, 0.985);\n  border: 1px solid var(--teal-dim);\n  border-radius: 0 0 9px 9px;\n  box-shadow: 0 16px 38px rgba(23, 36, 33, 0.18);\n}\n.scope-drawer__head {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 16px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.scope-drawer__head h2 {\n  margin: 0;\n  font: 600 18px / 1.1 var(--display);\n}\n.scope-drawer__head > span {\n  color: var(--faint);\n  font: 400 9px / 1.3 var(--mono);\n}\n.filter-groups {\n  display: grid;\n  grid-template-columns: 1.05fr 1.18fr 1fr;\n  gap: 12px;\n  align-items: start;\n  padding-top: 12px;\n}\n.filter-group {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  min-width: 0;\n  padding: 8px;\n  margin: 0;\n  background: var(--bg-2);\n  border: 1px solid var(--hairline);\n  border-radius: 7px;\n}\n.filter-group legend {\n  padding: 0 5px;\n  color: var(--teal);\n  font: 600 9px / 1 var(--mono);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n.compact-field {\n  display: grid;\n  grid-template-columns: minmax(82px, 0.75fr) minmax(0, 1.25fr);\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n.compact-field > span,\n.check-field {\n  color: var(--faint);\n  font: 500 8px / 1.2 var(--mono);\n}\n.compact-field select,\n.compact-field input {\n  min-width: 0;\n  width: 100%;\n  height: 27px;\n  padding: 3px 5px;\n  overflow: hidden;\n  color: var(--text);\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 500 8px / 1.2 var(--mono);\n  text-overflow: ellipsis;\n}\n.compact-field--multiselect {\n  align-items: start;\n}\n.compact-field--multiselect > span {\n  padding-top: 9px;\n}\n.filter-multiselect {\n  position: relative;\n  min-width: 0;\n}\n.filter-multiselect__trigger {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 10px;\n  align-items: center;\n  gap: 5px;\n  width: 100%;\n  height: 27px;\n  padding: 3px 6px;\n  overflow: hidden;\n  color: var(--text);\n  text-align: left;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 500 8px / 1.2 var(--mono);\n  cursor: pointer;\n}\n.filter-multiselect__trigger span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.filter-multiselect__trigger i {\n  width: 6px;\n  height: 6px;\n  border-right: 1px solid currentColor;\n  border-bottom: 1px solid currentColor;\n  transform: translateY(-2px) rotate(45deg);\n  transition: transform 140ms ease;\n}\n.filter-multiselect.is-open .filter-multiselect__trigger {\n  border-color: var(--teal);\n  box-shadow: 0 0 0 1px var(--teal-dim);\n}\n.filter-multiselect.is-open .filter-multiselect__trigger i {\n  transform: translateY(2px) rotate(225deg);\n}\n.filter-multiselect__trigger:focus-visible,\n.filter-multiselect__search input:focus-visible,\n.filter-multiselect__meta button:focus-visible,\n.filter-multiselect__option:focus-visible {\n  outline: 2px solid var(--amber);\n  outline-offset: 2px;\n}\n.filter-multiselect__popover {\n  position: absolute;\n  top: calc(100% + 5px);\n  left: 0;\n  z-index: 45;\n  display: grid;\n  width: min(340px, calc(100vw - 64px));\n  gap: 7px;\n  padding: 9px;\n  background: var(--panel);\n  border: 1px solid var(--teal-dim);\n  border-radius: 6px;\n  box-shadow: 0 12px 28px rgba(23, 36, 33, 0.2);\n}\n.filter-multiselect__popover[hidden] {\n  display: none;\n}\n.filter-multiselect__search {\n  display: grid;\n  gap: 4px;\n}\n.filter-multiselect__search > span,\n.filter-multiselect__meta {\n  color: var(--faint);\n  font: 600 8px / 1.2 var(--mono);\n}\n.filter-multiselect__search input {\n  height: 30px;\n  padding: 5px 7px;\n}\n.filter-multiselect__meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.filter-multiselect__meta button {\n  padding: 2px 0;\n  color: var(--teal);\n  background: transparent;\n  border: 0;\n  font: 600 8px / 1.2 var(--mono);\n  cursor: pointer;\n}\n.filter-multiselect__meta button:disabled {\n  color: var(--faint);\n  cursor: default;\n  opacity: 0.55;\n}\n.filter-multiselect__list {\n  display: grid;\n  max-height: 240px;\n  overflow: auto;\n  overscroll-behavior: contain;\n  border-top: 1px solid var(--hairline-soft);\n}\n.filter-multiselect__option {\n  display: grid;\n  grid-template-columns: 17px minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 4px;\n  color: var(--text);\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 500 8px / 1.25 var(--mono);\n  cursor: pointer;\n}\n.filter-multiselect__option i {\n  display: grid;\n  place-items: center;\n  width: 14px;\n  height: 14px;\n  color: #fff;\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  border-radius: 3px;\n  font: 700 9px / 1 var(--mono);\n}\n.filter-multiselect__option:hover,\n.filter-multiselect__option[aria-selected=\"true\"] {\n  background: var(--panel-3);\n}\n.filter-multiselect__option[aria-selected=\"true\"] i {\n  background: var(--teal);\n  border-color: var(--teal);\n}\n.filter-multiselect__option[aria-disabled=\"true\"] {\n  color: var(--faint);\n  cursor: not-allowed;\n  opacity: 0.52;\n}\n.filter-multiselect__option[aria-disabled=\"true\"]:hover {\n  background: transparent;\n}\n.filter-multiselect__empty {\n  margin: 0;\n  padding: 14px 4px;\n  color: var(--faint);\n  font: 500 8px / 1.3 var(--mono);\n  text-align: center;\n}\n.timeline-control {\n  display: grid;\n  grid-column: 1 / -1;\n  gap: 7px;\n  padding: 9px;\n  background: var(--panel);\n  border: 1px solid var(--teal-dim);\n  border-radius: 6px;\n}\n.timeline-control__head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 8px;\n}\n.timeline-control__head > span {\n  color: var(--text);\n  font: 650 9px / 1.2 var(--mono);\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n.timeline-control__head output {\n  color: var(--teal);\n  font: 600 8px / 1.2 var(--mono);\n  text-align: right;\n}\n.timeline-segment,\n.timeline-presets {\n  display: grid;\n  gap: 4px;\n}\n.timeline-segment {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.timeline-presets {\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n}\n.timeline-segment button,\n.timeline-presets button {\n  min-width: 0;\n  min-height: 26px;\n  padding: 4px 5px;\n  color: var(--faint);\n  background: var(--bg-2);\n  border: 1px solid var(--hairline);\n  border-radius: 4px;\n  font: 600 8px / 1 var(--mono);\n  cursor: pointer;\n}\n.timeline-segment button.is-active,\n.timeline-presets button.is-active {\n  color: #fff;\n  background: var(--teal);\n  border-color: var(--teal);\n}\n.timeline-presets button:disabled {\n  opacity: 0.42;\n  cursor: not-allowed;\n}\n.timeline-segment button:focus-visible,\n.timeline-presets button:focus-visible,\n.timeline-slider input:focus-visible,\n.timeline-slider__selection:focus-visible {\n  outline: 2px solid var(--amber);\n  outline-offset: 2px;\n}\n.timeline-slider {\n  display: grid;\n  gap: 4px;\n  color: var(--faint);\n  font: 500 8px / 1.2 var(--mono);\n}\n.timeline-slider__label {\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.timeline-slider__rail {\n  position: relative;\n  height: 28px;\n  margin: 0 7px;\n}\n.timeline-slider__rail::before {\n  position: absolute;\n  top: 12.5px;\n  right: 0;\n  left: 0;\n  height: 3px;\n  content: \"\";\n  background: var(--hairline);\n}\n.timeline-slider__selection {\n  position: absolute;\n  top: 4px;\n  right: calc(100% - var(--end-pct));\n  left: var(--start-pct);\n  z-index: 1;\n  height: 20px;\n  min-width: 3px;\n  padding: 0;\n  background:\n    linear-gradient(var(--teal), var(--teal)) center / 100% 3px no-repeat;\n  border: 0;\n  cursor: grab;\n}\n.timeline-slider__selection:active {\n  cursor: grabbing;\n}\n.timeline-slider__rail input[type=\"range\"] {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: -10px;\n  z-index: 2;\n  width: calc(100% + 20px);\n  height: 28px;\n  margin: 0;\n  pointer-events: none;\n  appearance: none;\n  background: transparent;\n}\n.timeline-slider__rail input[type=\"range\"]::-webkit-slider-runnable-track {\n  height: 3px;\n  background: transparent;\n}\n.timeline-slider__rail input[type=\"range\"]::-webkit-slider-thumb {\n  width: 20px;\n  height: 20px;\n  margin-top: -8.5px;\n  pointer-events: auto;\n  appearance: none;\n  background:\n    linear-gradient(var(--teal), var(--teal)) center / 2px 14px no-repeat;\n  border: 0;\n  border-radius: 0;\n  box-shadow: none;\n  cursor: ew-resize;\n}\n.timeline-slider__rail.is-tight\n  input[data-timeline-start-slider]::-webkit-slider-thumb {\n  transform: translateX(-4px);\n}\n.timeline-slider__rail.is-tight\n  input[data-timeline-end-slider]::-webkit-slider-thumb {\n  transform: translateX(4px);\n}\n.timeline-slider__rail input[type=\"range\"]:disabled::-webkit-slider-thumb {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.timeline-axis {\n  position: relative;\n  height: 13px;\n  margin: -2px 7px 0;\n  color: var(--faint);\n  font: 500 6.5px / 1 var(--mono);\n}\n.timeline-axis span {\n  position: absolute;\n  transform: translateX(-50%);\n  white-space: nowrap;\n}\n.timeline-axis span:first-child {\n  transform: none;\n}\n.timeline-axis span:last-child {\n  transform: translateX(-100%);\n}\n.timeline-range {\n  display: grid;\n  grid-template-columns: max-content minmax(18px, 1fr) max-content;\n  align-items: center;\n  gap: 7px;\n  color: var(--faint);\n  font: 500 7.5px / 1.2 var(--mono);\n}\n.timeline-range i {\n  height: 1px;\n  background: linear-gradient(\n    90deg,\n    var(--hairline),\n    var(--teal),\n    var(--hairline)\n  );\n}\n.timeline-range strong {\n  color: var(--text);\n  font-weight: 600;\n}\n.timeline-custom {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n  padding-top: 2px;\n}\n.timeline-custom .compact-field {\n  grid-template-columns: 28px minmax(0, 1fr);\n}\n.timeline-hint {\n  margin: 0;\n  color: var(--faint);\n  font: 400 7px / 1.3 var(--mono);\n}\n.filter-group:disabled {\n  opacity: 0.52;\n}\n.filter-group:disabled select,\n.filter-group:disabled input {\n  cursor: not-allowed;\n}\n.filter-note {\n  margin: 3px 0 0;\n  color: var(--faint);\n  font: 400 7px / 1.3 var(--mono);\n}\n.check-field {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 27px;\n}\n\n.state-banner {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 18px;\n  color: #6f4400;\n  background: #fff8e8;\n  border-bottom: 1px solid var(--amber-dim);\n  font: 400 9px / 1.25 var(--mono);\n}\n.state-banner strong {\n  text-transform: uppercase;\n}\n\n.stage {\n  position: relative;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--bg-2);\n}\n.stage.is-updating::after {\n  position: absolute;\n  top: 0;\n  right: 0;\n  left: 0;\n  z-index: 4;\n  height: 2px;\n  content: \"\";\n  background: linear-gradient(\n    90deg,\n    transparent,\n    var(--teal),\n    var(--teal-dim),\n    transparent\n  );\n  background-size: 200% 100%;\n  animation: update-sweep 1.1s linear infinite;\n  pointer-events: none;\n}\n.stage.is-updating .pane.is-active,\n.pane.is-module-loading {\n  opacity: 0.82;\n}\n.pane {\n  transition: opacity 0.14s var(--ease);\n}\n.pane.is-stale .stamp::after {\n  margin-left: 5px;\n  color: var(--faint);\n  content: \"· updating\";\n}\n.tab.is-stale:not(.is-active) .lamp {\n  background: var(--teal-dim);\n  opacity: 0.55;\n}\n.pane {\n  display: none;\n  flex-direction: column;\n  gap: 9px;\n  height: 100%;\n  padding: 12px 18px 22px;\n  overflow: hidden;\n}\n.pane.is-active {\n  display: flex;\n}\n.pane__head {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 36px;\n}\n.pane__head--with-control {\n  align-items: center;\n}\n.pane__head-actions {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 10px;\n}\n.pane__head-actions .subtabs {\n  align-self: center;\n}\n.eyebrow {\n  margin: 0 0 2px;\n  color: var(--teal);\n  font: 500 9px / 1.25 var(--mono);\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n}\n.pane__title {\n  margin: 0;\n  color: #10201c;\n  font: 600 19px / 1.15 var(--display);\n}\n.stamp {\n  padding: 3px 8px;\n  color: var(--faint);\n  border: 1px dashed var(--hairline);\n  border-radius: 4px;\n  font: 400 8.5px / 1.35 var(--mono);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.stamp--warn {\n  color: var(--amber);\n  background: #fff9ed;\n  border-color: var(--amber-dim);\n}\n\n.population,\n.overview-health,\n.kpi,\n.frame,\n.field,\n.product-summary,\n.source-card,\n.stability article,\n.revision-table,\n.audit-table,\n.qcard,\n.blocking,\n.baseline {\n  background: var(--panel);\n  border: 1px solid var(--hairline);\n  box-shadow: var(--panel-shadow);\n}\n\n.population {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: repeat(8, minmax(0, 1fr));\n  min-height: 41px;\n  overflow: hidden;\n  border-radius: 7px;\n}\n.population span {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  min-width: 0;\n  padding: 5px 8px;\n  border-right: 1px solid var(--hairline-soft);\n}\n.population span:last-child {\n  border-right: 0;\n}\n.population b,\n.product-summary b,\n.comparison-ledger b,\n.exception-summary b {\n  color: var(--faint);\n  font: 400 7.5px / 1.15 var(--mono);\n  letter-spacing: 0.075em;\n  text-transform: uppercase;\n}\n.population strong,\n.product-summary strong,\n.comparison-ledger,\n.exception-summary strong {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  font: 600 8.5px / 1.3 var(--mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.overview-health {\n  position: relative;\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  min-height: 32px;\n  padding: 5px 9px;\n  overflow: visible;\n  border-radius: 7px;\n}\n.quick-filter-row {\n  display: grid;\n  grid-template-columns:\n    minmax(166px, 1.12fr)\n    minmax(124px, 0.82fr)\n    minmax(275px, 1.75fr)\n    minmax(122px, 0.8fr)\n    auto auto auto;\n  gap: 7px;\n  align-items: center;\n  min-height: 35px;\n  padding: 3px 7px;\n  overflow: visible;\n  white-space: nowrap;\n}\n.quick-filter-field {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  gap: 6px;\n  align-items: center;\n  min-width: 0;\n}\n.quick-filter-field > span {\n  color: var(--faint);\n  font: 600 7px / 1 var(--mono);\n  letter-spacing: 0.055em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.quick-filter-row .compact-field--multiselect > span {\n  padding-top: 0;\n}\n.quick-filter-row .filter-multiselect__trigger {\n  height: 27px;\n}\n.quick-filter-field--sku .filter-multiselect__popover {\n  right: 0;\n  left: auto;\n  width: min(240px, calc(100vw - 64px));\n}\n.quick-filter-field--timeline {\n  grid-template-columns: max-content minmax(0, 1fr);\n}\n.quick-timeline {\n  display: grid;\n  grid-template-columns: max-content minmax(112px, 1fr) max-content;\n  gap: 6px;\n  align-items: center;\n  min-width: 0;\n}\n.quick-timeline__date {\n  color: var(--faint);\n  font: 600 7.5px / 1 var(--mono);\n  white-space: nowrap;\n}\n.quick-timeline strong.quick-timeline__date {\n  color: var(--text);\n}\n.quick-timeline .timeline-slider__rail {\n  min-width: 0;\n  height: 27px;\n  margin: 0;\n}\n.quick-filter-row__action {\n  min-height: 27px;\n  padding: 4px 8px;\n  font-size: 8px;\n}\n.quick-filter-row .overview-details summary {\n  padding: 5px 7px;\n}\n.overview-details {\n  position: relative;\n  flex: 0 0 auto;\n}\n.overview-details summary {\n  padding: 4px 7px;\n  color: var(--teal);\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n  cursor: pointer;\n  font: 500 8px / 1.2 var(--mono);\n  list-style: none;\n  white-space: nowrap;\n}\n.overview-details summary::-webkit-details-marker {\n  display: none;\n}\n.overview-details summary::before {\n  margin-right: 5px;\n  content: \"＋\";\n}\n.overview-details[open] summary::before {\n  content: \"−\";\n}\n.overview-details__popover {\n  position: absolute;\n  top: calc(100% + 7px);\n  right: 0;\n  z-index: 8;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(145px, 1fr));\n  gap: 7px 14px;\n  width: min(430px, calc(100vw - 48px));\n  padding: 10px 12px;\n  background: rgba(255, 255, 255, 0.99);\n  border: 1px solid var(--teal-dim);\n  border-radius: 6px;\n  box-shadow: 0 12px 28px rgba(23, 36, 33, 0.14);\n}\n.overview-details__item {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  min-width: 0;\n  padding-bottom: 4px;\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.overview-details__item b {\n  color: var(--faint);\n  font: 500 7px / 1.2 var(--mono);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.overview-details__item strong {\n  overflow: hidden;\n  color: var(--text);\n  font: 600 8px / 1.2 var(--mono);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.kpis {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 8px;\n}\n.kpis--row {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n.kpis--overview {\n  grid-template-columns: repeat(9, minmax(0, 1fr));\n}\n.kpis--overview .kpi--volume {\n  grid-column: span 2;\n}\n.kpi {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n  min-height: 74px;\n  padding: 8px 10px;\n  border-radius: 7px;\n}\n.kpi__head {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 6px;\n  min-width: 0;\n}\n.kpi-help {\n  position: relative;\n  z-index: 12;\n  flex: 0 0 auto;\n  margin-left: auto;\n}\n.kpi-help summary {\n  display: grid;\n  width: 15px;\n  height: 15px;\n  padding: 0;\n  place-items: center;\n  color: #397268;\n  background: #f3f8f6;\n  border: 1px solid #9dbdb6;\n  border-radius: 50%;\n  cursor: help;\n  font: 700 9px / 1 var(--mono);\n  list-style: none;\n  transition:\n    color 120ms ease,\n    background 120ms ease,\n    border-color 120ms ease;\n}\n.kpi-help summary::-webkit-details-marker {\n  display: none;\n}\n.kpi-help summary:hover,\n.kpi-help summary:focus-visible,\n.kpi-help[open] summary {\n  color: #fff;\n  background: var(--teal);\n  border-color: var(--teal);\n  outline: none;\n}\n.kpi-help summary:focus-visible {\n  box-shadow: 0 0 0 2px #c8e5df;\n}\n.kpi-help__popover {\n  position: absolute;\n  top: 20px;\n  right: 0;\n  z-index: 50;\n  width: min(300px, calc(100vw - 36px));\n  padding: 10px 11px;\n  color: var(--muted);\n  background: #fbfdfc;\n  border: 1px solid #91b7ae;\n  border-radius: 7px;\n  box-shadow: 0 12px 28px rgb(28 61 55 / 18%);\n  font: 400 9px / 1.45 var(--body);\n  text-align: left;\n  text-transform: none;\n}\n.kpi-help__popover::before {\n  position: absolute;\n  top: -5px;\n  right: 5px;\n  width: 8px;\n  height: 8px;\n  background: #fbfdfc;\n  border-top: 1px solid #91b7ae;\n  border-left: 1px solid #91b7ae;\n  content: \"\";\n  transform: rotate(45deg);\n}\n.kpi-help__popover strong {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--text);\n  font: 650 10px / 1.25 var(--display);\n}\n.kpi-help__popover p {\n  margin: 5px 0 0;\n}\n.kpi-help__popover p:first-of-type {\n  margin-top: 0;\n}\n.kpi-guide-trigger {\n  display: grid;\n  flex: 0 0 auto;\n  width: 15px;\n  height: 15px;\n  margin-left: auto;\n  padding: 0;\n  place-items: center;\n  color: var(--teal);\n  background: #eff7f5;\n  border: 1px solid #9ec9c0;\n  border-radius: 50%;\n  font: 600 8px / 1 var(--mono);\n  cursor: pointer;\n  transition:\n    color 120ms ease,\n    background 120ms ease,\n    border-color 120ms ease;\n}\n.kpi-guide-trigger:hover,\n.kpi-guide-trigger:focus-visible {\n  color: #fff;\n  background: var(--teal);\n  border-color: var(--teal);\n  outline: none;\n}\n.kpi-guide-trigger:focus-visible {\n  box-shadow: 0 0 0 2px #c8e5df;\n}\n\n.kpi__label,\n.qcard__k {\n  margin: 0;\n  color: var(--muted);\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.kpi__line {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 6px;\n  min-height: 23px;\n}\n.kpi__val {\n  color: #10201c;\n  font: 600 18px / 1.2 var(--display);\n  white-space: nowrap;\n}\n.kpi--volume {\n  gap: 2px;\n  min-height: 82px;\n}\n.kpi.kpi--micro {\n  gap: 0;\n  min-height: 82px;\n  padding-bottom: 0;\n  overflow: hidden;\n}\n.kpi-micro__summary {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: start;\n  gap: 4px;\n  min-width: 0;\n}\n.kpi-micro__label {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 3px;\n  min-width: 0;\n}\n.kpi-micro__label .kpi__label {\n  font-size: 8px;\n  line-height: 1.15;\n}\n.kpi__label-short {\n  display: none;\n}\n.kpi-micro__label .kpi-guide-trigger,\n.kpi-micro__label .kpi-help {\n  margin-left: 0;\n}\n.kpi-micro__metric {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  min-width: 0;\n  text-align: right;\n}\n.kpi-micro__metric .kpi__val {\n  font-size: 20px;\n  line-height: 1.05;\n}\n.kpi-micro__metric .delta {\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.kpi-microchart {\n  display: block;\n  width: 100%;\n  height: 32px;\n  margin-top: auto;\n  overflow: visible;\n  color: #63b4a6;\n  shape-rendering: crispEdges;\n}\n.kpi-microchart--blue {\n  color: #7fa9d3;\n}\n.kpi-microchart--amber {\n  color: #d4aa5d;\n}\n.kpi-microchart__bar {\n  fill: currentColor;\n  fill-opacity: 0.62;\n}\n.kpi-microchart__bar.is-latest {\n  fill-opacity: 0.96;\n}\n.kpi-microchart__bar--positive {\n  fill: #63b4a6;\n}\n.kpi-microchart__bar--negative {\n  fill: #dc9b82;\n}\n.kpi-microchart__zero {\n  stroke: #9fb5af;\n  stroke-width: 0.7;\n  vector-effect: non-scaling-stroke;\n}\n.kpi-microchart--empty {\n  height: 32px;\n}\n.volume-box {\n  display: block;\n  width: 100%;\n  height: 52px;\n  overflow: visible;\n  shape-rendering: geometricPrecision;\n}\n.volume-box--actual {\n  color: var(--blue);\n}\n.volume-box--forecast {\n  color: var(--teal);\n}\n.volume-box__whisker,\n.volume-box__cap {\n  stroke: currentColor;\n  stroke-width: 1.5;\n}\n.volume-box__quartiles {\n  fill: currentColor;\n  fill-opacity: 0.14;\n  stroke: currentColor;\n  stroke-width: 1.5;\n}\n.volume-box__median {\n  stroke: currentColor;\n  stroke-width: 2.5;\n}\n.volume-box__median-label,\n.volume-box__wape {\n  fill: var(--text);\n  font: 500 8px var(--mono);\n  paint-order: stroke;\n  stroke: var(--panel);\n  stroke-width: 3px;\n}\n.volume-box__wape {\n  fill: var(--red);\n  font-weight: 600;\n}\n.volume-box__empty {\n  display: grid;\n  f