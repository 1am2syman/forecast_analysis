-blue {\n  background: var(--blue);\n}\n.key--amber {\n  background: var(--amber);\n}\n.key--vintage-b {\n  background: var(--teal);\n}\n.key--vintage-a {\n  height: 2px;\n  background: var(--teal-dim);\n  opacity: 0.6;\n}\n.key--volume-vintage-b {\n  background: var(--series-vintage-b);\n}\n.key--volume-vintage-a {\n  height: 2px;\n  background: repeating-linear-gradient(\n    90deg,\n    var(--series-vintage-a) 0 5px,\n    transparent 5px 8px\n  );\n}\n.key--bias-over {\n  background: var(--amber);\n}\n.key--bias-under {\n  background: var(--blue);\n}\n.key--actual {\n  background: var(--blue);\n}\n.key--volume-actual {\n  background: var(--series-actual);\n}\n\n.chart {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  padding: 3px 8px 1px;\n  overflow: visible;\n}\n.overview-charts .frame__body {\n  min-height: 0;\n}\n.overview-charts .chart {\n  aspect-ratio: 1000 / 252;\n}\n.overview-charts .chart,\n.trend-main .chart--overview {\n  padding: 1px 2px 0;\n}\n.chart text {\n  fill: var(--faint);\n  font: 500 9px var(--mono);\n  text-anchor: middle;\n}\n.chart__grid line {\n  stroke: var(--hairline-soft);\n  stroke-width: 1;\n}\n.chart__axis text {\n  text-anchor: start;\n}\n.chart__line {\n  fill: none;\n  stroke: var(--teal);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 3;\n}\n.chart__line--amber {\n  stroke: var(--amber);\n}\n.chart__area {\n  fill: rgba(8, 127, 117, 0.07);\n}\n.chart__smooth-line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 3;\n}\n.chart--overview .chart__smooth-line,\n.chart--overview-volume .chart__smooth-line {\n  stroke-width: 4.8;\n}\n.chart__data-labels text {\n  fill: var(--series, var(--teal));\n  font-size: 8px;\n  font-weight: 600;\n  paint-order: stroke;\n  pointer-events: none;\n  stroke: var(--panel);\n  stroke-linejoin: round;\n  stroke-width: 3px;\n}\n.chart__series--vintage-a {\n  color: var(--teal-dim);\n  stroke: var(--teal-dim);\n  opac