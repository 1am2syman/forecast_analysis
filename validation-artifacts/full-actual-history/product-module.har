op-style: dashed;\n}\n.year-overlay-visual {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n}\n.year-overlay-adjustment {\n  display: flex;\n  align-items: stretch;\n  justify-content: space-between;\n  gap: 16px;\n  min-width: 0;\n  padding: 7px 12px;\n  background: var(--panel-2);\n  border-bottom: 1px solid var(--hairline-soft);\n}\n.year-overlay-adjustment__flow,\n.year-overlay-adjustment__meta {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n.year-overlay-adjustment__flow {\n  gap: 10px;\n}\n.year-overlay-adjustment__flow > i {\n  color: var(--faint-2);\n  font: 500 13px / 1 var(--mono);\n  font-style: normal;\n}\n.year-overlay-adjustment__flow > span,\n.year-overlay-adjustment__meta > span {\n  display: grid;\n  gap: 1px;\n  min-width: 0;\n}\n.year-overlay-adjustment__flow b,\n.year-overlay-adjustment__meta b {\n  color: var(--faint);\n  font: 500 7.5px / 1.1 var(--mono);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.year-overlay-adjustment__flow strong {\n  font: 600 15px / 1.1 var(--display);\n  white-space: nowrap;\n}\n.year-overlay-adjustment__change strong {\n  color: var(--amber);\n}\n.year-overlay-adjustment__meta {\n  flex: 0 0 auto;\n  gap: 18px;\n  padding-left: 16px;\n  border-left: 1px solid var(--hairline-soft);\n}\n.year-overlay-adjustment__meta strong {\n  font: 600 10px / 1.2 var(--mono);\n  white-space: nowrap;\n}\n.year-overlay-chart {\n  padding: 5px 8px 1px;\n}\n.year-overlay-grid line {\n  stroke: var(--hairline-soft);\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n.year-overlay-grid text,\n.year-overlay-labels text,\n.year-overlay-axis-unit,\n.year-overlay-cutoff-label,\n.year-overlay-fy-label,\n.year-overlay-empty {\n  fill: var(--faint);\n  font-family: var(--mono);\n  font-size: 9px;\n}\n.year-overlay-grid text {\n  text-anchor: end;\n}\n.year-overlay-labels text {\n  text-anchor: middle;\n}\n.year-overlay-axis-unit {\n  fill: var(--faint-2);\n  letter-spacing: 0.08em;\n}\n.year-overlay-path {\n  fill: none;\n  stroke-width: 2.25;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  vector-effect: non-scaling-stroke;\n}\n.year-overlay-path.forecast {\n  stroke-dasharray: 7 5;\n}\n.year-overlay-point {\n  fill: var(--panel);\n  stroke-width: 1.8;\n  vector-effect: non-scaling-stroke;\n  pointer-events: none;\n}\n.year-overlay-point.forecast {\n  stroke-dasharray: 2 1;\n}\n.year-overlay-month-hit {\n  cursor: crosshair;\n}\n.year-overlay-month-hit:hover,\n.year-overlay-month-hit:focus {\n  fill: rgba(8, 127, 117, 0.035);\n}\n.year-overlay-cutoff {\n  stroke: var(--faint-2);\n  stroke-width: 1;\n  stroke-dasharray: 3 4;\n  vector-effect: non-scaling-stroke;\n}\n.year-overlay-cutoff-label,\n.year-overlay-fy-label {\n  fill: var(--muted);\n}\n.year-overlay-fy-separator {\n  stroke: var(--faint-2);\n  stroke-width: 1;\n  stroke-dasharray: 3 4;\n  vector-effect: non-scaling-stroke;\n}\n.year-overlay-empty {\n  font-size: 11px;\n}\n.postmortem-secondary {\n  grid-template-columns: minmax(0, 1fr);\n  grid-template-rows: repeat(2, minmax(0, 1fr));\n  min-height: 180px;\n}\n.postmortem-secondary .frame__head {\n  flex-wrap: wrap;\n}\n.postmortem-secondary .frame__actions {\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n.postmortem-chart-body,\n.postmortem-revision-body,\n.postmortem-peer-body {\n  display: grid;\n  min-width: 0;\n  min-height: 0;\n  place-items: stretch;\n}\n.postmortem-chart,\n.postmortem-revision-chart {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n}\n.postmortem-revision-chart {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) auto;\n}\n.postmortem-chart .chart__grid text,\n.postmortem-revision-chart .chart__grid text,\n.postmortem-chart .chart__labels text,\n.postmortem-revision-chart .chart__labels text {\n  font-size: 10px;\n}\n.postmortem-chart__forecast,\n.postmortem-chart__actual,\n.postmortem-revision-chart__line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  vector-effect: non-scaling-stroke;\n}\n.postmortem-chart__forecast {\n  stroke: var(--teal);\n  stroke-width: 2.5;\n}\n.postmortem-chart__actual {\n  stroke: var(--series-actual);\n  stroke-width: 2.5;\n}\n.postmortem-chart__point {\n  fill: var(--panel);\n  stroke-width: 2;\n  vector-effect: non-scaling-stroke;\n}\n.postmortem-chart__point--forecast {\n  stroke: var(--teal);\n}\n.postmortem-chart__point--actual {\n  stroke: var(--series-actual);\n}\n.postmortem-revision-chart__zero {\n  stroke: var(--faint-2);\n  stroke-dasharray: 3 4;\n}\n.postmortem-revision-chart__line {\n  stroke: var(--teal);\n  stroke-width: 1.8;\n}\n.postmortem-revision-chart__point {\n  fill: var(--panel);\n  stroke-width: 2;\n}\n.postmortem-revision-chart__point--improved {\n  stroke: var(--series-vintage-b);\n}\n.postmortem-revision-chart__point--worsened {\n  stroke: var(--red);\n}\n.postmortem-revision-chart__point--neutral,\n.postmortem-revision-chart__point--unchanged {\n  stroke: var(--faint-2);\n}\n.postmortem-revision-chart__legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n  padding: 5px 9px;\n  color: var(--faint);\n  border-top: 1px solid var(--hairline-soft);\n  font: 400 8.5px / 1.25 var(--mono);\n}\n.postmortem-peer-list {\n  display: grid;\n  align-content: center;\n  gap: 7px;\n  width: 100%;\n  padding: 9px 11px;\n}\n.postmortem-peer {\n  display: grid;\n  grid-template-columns: 110px minmax(0, 1fr) 48px;\n  align-items: center;\n  gap: 7px;\n  font: 500 9px / 1.25 var(--mono);\n}\n.postmortem-peer--selected {\n  padding: 5px 6px;\n  background: var(--panel-3);\n  border: 1px solid var(--teal);\n  border-radius: 4px;\n}\n.postmortem-peer__track {\n  position: relative;\n  height: 12px;\n  overflow: hidden;\n  background: var(--panel-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 4px;\n}\n.postmortem-peer__band,\n.postmortem-peer__median,\n.postmortem-peer__selected {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  display: block;\n}\n.postmortem-peer__band {\n  background: #c8ddd8;\n}\n.postmortem-peer__median {\n  width: 1px;\n  background: var(--teal);\n}\n.postmortem-peer__selected {\n  top: -1px;\n  bottom: -1px;\n  width: 3px;\n  margin-left: -1px;\n  background: var(--red);\n}\n.postmortem-peer > span:first-child {\n  display: grid;\n  gap: 1px;\n  min-width: 0;\n}\n.postmortem-peer > span:first-child small {\n  overflow: hidden;\n  color: var(--muted);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.postmortem-peer strong {\n  text-align: right;\n}\n.postmortem-peer > .postmortem-peer-note {\n  grid-column: 2 / 4;\n  margin: -3px 0 0;\n}\n.postmortem-peer-note {\n  margin: 3px 0 0;\n  color: var(--faint);\n  font: 400 8.5px / 1.35 var(--mono);\n}\n.postmortem-revision-table > div {\n  grid-template-columns: 0.42fr 1.2fr 0.65fr 0.62fr 0.62fr 0.62fr 0.72fr;\n}\n#pane-history .history-toolbar,\n#pane-history .history-toolbar .field,\n#pane-history .product-summary {\n  min-height: 48px;\n}\n#pane-history .history-toolbar .field {\n  padding-top: 5px;\n  padding-bottom: 5px;\n}\n#pane-history .product-summary span {\n  padding-top: 4px;\n  padding-bottom: 4px;\n}\n#pane-history .product-summary b {\n  font-size: 8px;\n  white-space: nowrap;\n}\n#pane-history .product-summary strong {\n  font-size: 9.5px;\n}\n#pane-history .frame__title {\n  font-size: 13px;\n}\n#pane-history .frame__sub,\n#pane-history .frame__metric,\n#pane-history .legend {\n  font-size: 8.5px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .chart-dialog__body,\n.chart-dialog[data-chart-kind=\"postmortem-revision\"] .chart-dialog__body {\n  display: grid;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .postmortem-chart,\n.chart-dialog[data-chart-kind=\"postmortem-revision\"] .postmortem-revision-chart {\n  width: 100%;\n  height: 100%;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .chart-dialog__legend {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 7px 12px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-chart {\n  padding: 24px 32px 18px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-path {\n  stroke-width: 3;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-point {\n  stroke-width: 2.4;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"]\n  .year-overlay-modes\n  button,\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-control,\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-reset {\n  min-height: 27px;\n  font-size: 10px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .year-overlay-fy-label,\n.chart-dialog[data-chart-kind=\"postmortem-performance\"]\n  .year-overlay-cutoff-label {\n  font-size: 11px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-performance\"] .chart text,\n.chart-dialog[data-chart-kind=\"postmortem-revision\"] .chart text {\n  font-size: 11px;\n}\n.chart-dialog[data-chart-kind=\"postmortem-revision\"]\n  .postmortem-revision-chart__legend {\n  padding: 9px 14px;\n  font-size: 10px;\n}\n\n.exception-toolbar {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: 1.8fr 1fr 0.7fr auto;\n  gap: 8px;\n  align-items: stretch;\n}\n.exception-toolbar .btn {\n  align-self: stretch;\n}\n.audit-table {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  min-height: 0;\n  overflow: hidden;\n  border-radius: 7px;\n}\n.audit-table__head,\n.audit-table__row {\n  display: grid;\n  grid-template-columns: 0.55fr 0.75fr 0.9fr 0.8fr 0.65fr 0.65fr 0.7fr 0.65fr 0.8fr 1.35fr;\n  gap: 7px;\n  align-items: center;\n  padding: 6px 9px;\n}\n.audit-table__head {\n  flex: 0 0 auto;\n  min-height: 29px;\n  color: var(--muted);\n  background: var(--bg-2);\n  border-bottom: 1px solid var(--hairline);\n  font: 500 6.8px / 1.2 var(--mono);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.audit-table__rows {\n  flex: 1 1 auto;\n  min-height: 0;\n}\n.audit-table__row {\n  min-height: 35px;\n  color: var(--muted);\n  border-bottom: 1px solid var(--hairline-soft);\n  font: 400 7.5px / 1.2 var(--mono);\n}\n.audit-table__row[hidden] {\n  display: none;\n}\n.audit-table__row strong {\n  color: var(--text);\n}\n.audit-table__head > *,\n.audit-table__row > * {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.audit-table__foot {\n  flex: 0 0 auto;\n  padding: 6px 9px;\n  color: var(--faint);\n  background: var(--bg-2);\n  font: 400 7px / 1.25 var(--mono);\n}\n\n.source,\n.severity {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-style: normal;\n  font-weight: 600;\n  text-transform: uppercase;\n}\n.source {\n  min-width: 27px;\n  padding: 2px 4px;\n  font-size: 7px;\n}\n.source--ml {\n  color: var(--teal);\n  background: #e4f2ef;\n  border: 1px solid #a8cec7;\n}\n.source--tm {\n  color: var(--amber);\n  background: #fff6e5;\n  border: 1px solid #e4c68c;\n}\n.severity {\n  padding: 2px 5px;\n  font-size: 6.8px;\n  letter-spacing: 0.05em;\n  white-space: nowrap;\n}\n.severity--good {\n  color: #076d62;\n  background: #e4f2ef;\n  border: 1px solid #a8cec7;\n}\n.severity--warn {\n  color: #815000;\n  background: #fff6e5;\n  border: 1px solid #e4c68c;\n}\n.severity--bad {\n  color: #96322d;\n  background: #faeae8;\n  border: 1px solid #e4b0ac;\n}\n\n.blocking {\n  justify-content: flex-start;\n}\n.ql {\n  display: grid;\n  flex: 0 0 auto;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 8px;\n}\n.qcard {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n  min-height: 69px;\n  padding: 7px 9px;\n  border-radius: 7px;\n}\n.qcard__top {\n  display: flex;\n  align-items: flex-start;\n  gap: 5px;\n}\n.qcard__top .severity {\n  margin-left: auto;\n}\n.qcard__v {\n  color: #10201c;\n  font: 600 16px / 1.2 var(--display);\n}\n.quality-tabs {\n  align-self: stretch;\n}\n.quality-tabs .subtab {\n  flex: 1;\n}\n.quality-panel {\n  flex: 1 1 auto;\n}\n.quality-panel .frame {\n  flex: 1;\n}\n.quality-detail {\n  display: grid;\n  flex: 1 1 auto;\n  grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.9fr);\n  gap: 10px;\n  min-height: 0;\n  padding: 9px;\n}\n.quality-counts {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 7px;\n  min-height: 0;\n}\n.quality-counts--four {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n.quality-status {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 3px;\n  min-width: 0;\n  padding: 8px;\n  border: 1px solid var(--hairline-soft);\n  border-radius: 6px;\n}\n.quality-status b {\n  color: var(--muted);\n  font: 600 7px / 1.2 var(--mono);\n  text-transform: uppercase;\n}\n.quality-status strong {\n  font: 600 20px / 1.25 var(--display);\n}\n.quality-status em,\n.quality-status i {\n  color: var(--faint);\n  font: 400 7px / 1.2 var(--mono);\n  font-style: normal;\n}\n.quality-status--good {\n  background: #f1f8f6;\n}\n.quality-status--warn {\n  background: #fffaf0;\n}\n.quality-status--bad {\n  background: #fdf3f2;\n}\n.quality-exceptions {\n  display: grid;\n  align-content: center;\n  gap: 6px;\n}\n.quality-exceptions article {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: start;\n  gap: 7px;\n  min-width: 0;\n  padding: 7px 8px;\n  background: var(--bg-2);\n  border: 1px solid var(--hairline-soft);\n  border-radius: 5px;\n}\n.quality-exceptions strong {\n  display: block;\n  font-size: 8.5px;\n}\n.quality-exceptions p,\n.quality-exceptions em {\n  margin: 0;\n  color: var(--faint);\n  font: 400 7px / 1.3 var(--mono);\n  font-style: normal;\n}\n.quality-exceptions em {\n  white-space: nowrap;\n}\n.baseline {\n  flex: 0 0 auto;\n  min-height: 30px;\n  overflow: hidden;\n  border-radius: 6px;\n}\n.baseline summary {\n  padding: 6px 9px;\n  color: var(--muted);\n  font: 500 8px / 1.25 var(--mono);\n}\n.baseline div {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 9px;\n  color: var(--faint);\n  border-top: 1px solid var(--hairline-soft);\n  font: 400 7.5px / 1.2 var(--mono);\n}\n.baseline .btn {\n  margin-left: auto;\n}\n\n.statusbar {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 0 16px;\n  overflow: hidden;\n  color: var(--faint);\n  background: var(--panel);\n  border-top: 1px solid var(--hairline);\n  font: 400 9px / 1.3 var(--mono);\n  letter-spacing: 0.06em;\n  white-space: nowrap;\n}\n.statusbar__seg {\n  display: flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 7px;\n}\n.statusbar__seg--mono {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.statusbar__seg--right {\n  margin-left: auto;\n}\n\n.toast {\n  position: fixed;\n  right: 16px;\n  bottom: 42px;\n  z-index: 30;\n  max-width: 360px;\n  padding: 8px 11px;\n  color: #f4fffc;\n  background: #173c36;\n  border: 1px solid #2d665d;\n  border-radius: 6px;\n  box-shadow: 0 8px 24px rgba(23, 36, 33, 0.16);\n  font: 500 9px / 1.35 var(--mono);\n  transform: translateY(8px);\n  opacity: 0;\n  pointer-events: none;\n  transition:\n    opacity 0.16s var(--ease),\n    transform 0.16s var(--ease);\n}\n.toast.is-visible {\n  transform: translateY(0);\n  opacity: 1;\n}\n.toast--error {\n  color: #fff7f6;\n  background: #6f2824;\n  border-color: #a44c46;\n}\n\n.loading {\n  position: fixed;\n  inset: 50% auto auto 50%;\n  z-index: 40;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 9px 12px;\n  color: var(--text);\n  background: rgba(255, 255, 255, 0.96);\n  border: 1px solid var(--teal-dim);\n  border-radius: 7px;\n  box-shadow: 0 10px 32px rgba(23, 36, 33, 0.18);\n  font: 500 9px / 1.3 var(--mono);\n  transform: translate(-50%, -45%);\n  opacity: 0;\n  pointer-events: none;\n  transition:\n    opacity 0.14s var(--ease),\n    transform 0.14s var(--ease);\n}\n.loading.is-visible {\n  transform: translate(-50%, -50%);\n  opacity: 1;\n}\n.loading__spinner {\n  width: 13px;\n  height: 13px;\n  border: 2px solid var(--hairline);\n  border-top-color: var(--teal);\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n.empty-visual,\n.message-state {\n  display: grid;\n  place-items: center;\n  gap: 8px;\n  padding: 18px;\n  color: var(--muted);\n  text-align: center;\n  font: 500 9px / 1.4 var(--mono);\n}\n.empty-row {\n  padding: 16px;\n  color: var(--faint);\n  text-align: center;\n  font: 400 8px / 1.4 var(--mono);\n}\n.message-frame {\n  flex: 1 1 auto;\n}\n.message-state {\n  margin: auto;\n  max-width: 540px;\n}\n.message-state h3,\n.message-state p {\n  margin: 0;\n}\n.message-state h3 {\n  color: var(--text);\n  font: 600 17px / 1.2 var(--display);\n}\n.message-state p {\n  color: var(--faint);\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@keyframes update-sweep {\n  to {\n    background-position: -200% 0;\n  }\n}\n\n@keyframes breathe {\n  0%,\n  100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0.35;\n  }\n}\n\n@media (max-width: 1320px) {\n  .overview-charts .legend {\n    display: none;\n  }\n  .kpi--micro .kpi__label {\n    font-size: 6.5px;\n    letter-spacing: 0.02em;\n  }\n  .kpi--micro .kpi-micro__metric {\n    padding-top: 8px;\n  }\n  .kpi--micro .kpi__val {\n    font-size: 18px;\n  }\n  .kpi--micro .kpi-guide-trigger {\n    width: 13px;\n    height: 13px;\n    font-size: 7px;\n  }\n  .kpi--micro .kpi__label-long {\n    display: none;\n  }\n  .kpi--micro .kpi__label-short {\n    display: inline;\n  }\n}\n\n@media (max-width: 1180px) {\n  .refresh {\n    display: none;\n  }\n  .scopebar__audit span:nth-child(2),\n  .scopebar__audit span:nth-child(3) {\n    display: none;\n  }\n  .filter-groups {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .timeline-presets {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n  .scope-drawer {\n    max-height: calc(100vh - 110px);\n    overflow: auto;\n  }\n}\n\n@media (max-width: 1100px) {\n  .workspace.is-overview .scope-token:nth-child(5) {\n    display: none;\n  }\n  .overview-charts {\n    grid-template-columns: minmax(0, 1fr);\n    overflow: auto;\n  }\n  .overview-charts > .frame {\n    min-height: 300px;\n  }\n}\n\n@media (max-width: 940px) {\n  :root {\n    --rail-w: 76px;\n  }\n  .rail {\n    padding: 14px 8px 12px;\n  }\n  .rail__head {\n    justify-content: center;\n    margin-right: 0;\n    margin-left: 0;\n  }\n  .rail__label,\n  .tab__copy,\n  .tab__name,\n  .tab__meta,\n  .tab__badge,\n  .tab > .lamp,\n  .rail__foot,\n  .topbar__ctx,\n  .chip--live,\n  .scope-token:nth-child(4),\n  .scope-token:nth-child(5),\n  .scopebar__audit span:not(:last-child) {\n    display: none;\n  }\n  .tab {\n    justify-content: center;\n    gap: 0;\n    padding: 12px 6px;\n  }\n  .tab__icon {\n    display: grid;\n    place-items: center;\n  }\n  .tab.is-active .tab__icon {\n    color: var(--teal);\n  }\n  .tab.is-active .tab__icon--warn {\n    color: var(--amber);\n  }\n  .topbar {\n    padding-right: 10px;\n    padding-left: 12px;\n  }\n  .topbar__right {\n    gap: 5px;\n  }\n  .btn {\n    padding-right: 8px;\n    padding-left: 8px;\n  }\n  .scopebar {\n    padding-right: 12px;\n    padding-left: 12px;\n  }\n  .scopebar__primary {\n    gap: 4px;\n  }\n  .workspace.is-overview .scope-token:nth-child(3) {\n    display: none;\n  }\n  .scopebar__audit {\n    margin-left: auto;\n  }\n  .pane {\n    padding-right: 14px;\n    padding-left: 14px;\n  }\n  .pane__head-actions .stamp {\n    display: none;\n  }\n  .population span {\n    padding-right: 5px;\n    padding-left: 5px;\n  }\n  .population b,\n  .product-summary b {\n    font-size: 6.5px;\n  }\n  .population strong,\n  .product-summary strong {\n    font-size: 7.5px;\n  }\n  .kpis--overview {\n    grid-template-columns: repeat(7, minmax(0, 1fr));\n  }\n  .kpis--overview .kpi--volume {\n    grid-column: span 1;\n  }\n  .kpi {\n    padding-right: 7px;\n    padding-left: 7px;\n  }\n  .kpi__line {\n    gap: 3px;\n  }\n  .kpi__val {\n    font-size: 16px;\n  }\n  .delta {\n    font-size: 6.5px;\n    letter-spacing: -0.02em;\n  }\n  .kpi__cap,\n  .qcard__cap {\n    font-size: 6.5px;\n    letter-spacing: -0.015em;\n  }\n  .metricbar {\n    grid-template-columns: 1fr 0.8fr 1.1fr;\n  }\n  .metricbar__note {\n    display: none;\n  }\n  .heatmap {\n    grid-template-columns: 54px repeat(6, minmax(19px, 1fr));\n    padding-right: 5px;\n    padding-left: 5px;\n    font-size: 6px;\n  }\n  .source-card {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .source-card div {\n    grid-column: auto;\n  }\n  .comparison-ledger {\n    gap: 7px;\n  }\n  .comparison-ledger span:nth-child(3) {\n    display: none;\n  }\n  .history-layout {\n    grid-template-columns: minmax(0, 1.8fr) minmax(175px, 0.8fr);\n  }\n  .stability div strong {\n    font-size: 8.5px;\n  }\n  .quality-detail {\n    grid-template-columns: minmax(0, 1.3fr) minmax(245px, 0.9fr);\n  }\n  .quality-status {\n    padding: 6px;\n  }\n  .quality-status strong {\n    font-size: 16px;\n  }\n  .audit-table__head,\n  .audit-table__row {\n    grid-template-columns: 0.5fr 0.72fr 0.8fr 0.72fr 0.6fr 0.6fr 0.62fr 0.6fr 0.75fr 1.2fr;\n    gap: 4px;\n    padding-right: 6px;\n    padding-left: 6px;\n  }\n}\n\n@media (max-height: 760px) {\n  .pane {\n    gap: 7px;\n    padding-top: 9px;\n    padding-bottom: 20px;\n  }\n  .pane__head {\n    min-height: 33px;\n  }\n  .pane__title {\n    font-size: 17px;\n  }\n  .population {\n    min-height: 37px;\n  }\n  .kpi {\n    min-height: 68px;\n    padding-top: 6px;\n    padding-bottom: 6px;\n  }\n  .kpi__val {\n    font-size: 16px;\n  }\n  .frame__head {\n    min-height: 37px;\n    padding-top: 5px;\n    padding-bottom: 5px;\n  }\n  .metricbar {\n    min-height: 35px;\n    padding-top: 3px;\n    padding-bottom: 3px;\n  }\n  .subtabs {\n    min-height: 27px;\n    padding: 2px;\n  }\n  .subtab {\n    min-height: 21px;\n  }\n  .comparison-ledger,\n  .exception-summary {\n    min-height: 25px;\n  }\n  .comparison-kpis .kpi {\n    min-height: 62px;\n  }\n  .outcome-body {\n    grid-template-rows: 62px minmax(0, 1fr);\n    padding: 6px;\n  }\n  .revision-history__legend {\n    min-height: 21px;\n    font-size: 6.5px;\n  }\n  .toolbar .field,\n  .exception-toolbar .field {\n    min-height: 38px;\n    padding-top: 4px;\n    padding-bottom: 4px;\n  }\n  .product-summary {\n    min-height: 32px;\n  }\n  .revision-table {\n    min-height: 66px;\n  }\n  .qcard {\n    min-height: 60px;\n    padding-top: 5px;\n    padding-bottom: 5px;\n  }\n  .qcard__v {\n    font-size: 14px;\n  }\n  .blocking {\n    min-height: 28px;\n  }\n  .quality-tabs {\n    min-height: 25px;\n  }\n  .baseline {\n    min-height: 27px;\n  }\n}\n\n@media (max-width: 980px) {\n  .postmortem-peer {\n    grid-template-columns: 75px minmax(0, 1fr) 35px;\n  }\n}\n\n@media (max-width: 820px) {\n  #pane-history {\n    padding-right: 8px;\n    padding-left: 8px;\n  }\n  .postmortem-metrics {\n    grid-template-columns: repeat(6, minmax(112px, 1fr));\n    overflow-x: auto;\n  }\n  .postmortem-primary {\n    min-height: 260px;\n  }\n  .year-overlay-adjustment {\n    gap: 10px;\n    padding-right: 9px;\n    padding-left: 9px;\n  }\n  .year-overlay-adjustment__flow {\n    gap: 7px;\n  }\n  .year-overlay-adjustment__meta {\n    gap: 10px;\n    padding-left: 10px;\n  }\n  .postmortem-cockpit {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .postmortem-secondary {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .postmortem-peer {\n    grid-template-columns: 90px minmax(0, 1fr) 42px;\n  }\n  .postmortem-revision-table {\n    overflow-x: auto;\n  }\n  .postmortem-revision-table {\n    overflow-x: auto;\n  }\n  .postmortem-revision-table > div {\n    min-width: 640px;\n    gap: 4px;\n    font-size: 6.5px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .topbar__sig .lamp--live,\n  .tab.is-active .lamp--live {\n    animation: none;\n  }\n  .body,\n  .rail__toggle svg,\n  .toast,\n  .loading {\n    transition: none;\n  }\n  .loading__spinner,\n  .stage.is-updating::after {\n    animation: none;\n  }\n}\n"
